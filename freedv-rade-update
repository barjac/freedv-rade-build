#!/bin/bash
#set -x

# Check we are not root
((UID)) || { echo "ERROR: You must NOT be root user to run $0, use CTRL/d to become $user"; exit 1; }

# Check for missing preload file
if [ -n "$LD_PRELOAD" ] && [ ! -e "$LD_PRELOAD" ]; then
    echo "Warning: LD_PRELOAD points to missing file ($LD_PRELOAD) — unsetting."
    unset LD_PRELOAD
fi

# Get user name
user="$(logname 2>/dev/null || echo "$USER")"

# Move into git repository
RUN_DIR="/home/$user/freedv-rade-build"
cd "$RUN_DIR" || { echo "Failed to change to RUN_DIR"; exit 1; }

# Check not already running
exec 8>/tmp/radeupdt.lock
flock -n 8 || { echo "Another instance is already running"; exit 1; }

# Set full path to log
LOGFILE="$RUN_DIR/freedv-rade-update.log"

# Parse flags: strip --restart from args, keep --debug/--dev for restart passthrough
RESTARTING=false
DEBUG=false
# --dev is deliberately undocumented (no --help/usage text exists anywhere
# in this script or the README, so this is consistent with how --restart/
# --debug are already handled) -- it unlocks 'fork:branchname' as a
# PR(s)/branch entry, building directly from a personal freedv-gui fork
# branch instead of requiring an open PR against upstream. Off by default
# so ordinary users seeing 'fork:...' rejected never learn it's there.
DEV_MODE=false
# --profile=NAME: skip the interactive base/PR/branch/patch questions
# entirely and load a previously-saved named profile (see .profiles)
# instead. Still stops at the final summary/confirm like everything
# else -- this only fast-forwards through the *selection* questions.
PROFILE_NAME=""
_args=()
for _arg in "$@"; do
    case "$_arg" in
        --restart) RESTARTING=true ;;
        --debug)   DEBUG=true; _args+=("$_arg") ;;
        --dev)     DEV_MODE=true; _args+=("$_arg") ;;
        --profile=*) PROFILE_NAME="${_arg#--profile=}"; _args+=("$_arg") ;;
        *)         _args+=("$_arg") ;;
    esac
done
set -- "${_args[@]}"
unset _arg _args

# Only wipe log & write OS info on fresh run
if ! $RESTARTING; then
    cat /etc/os-release > "$LOGFILE"
    locale >> "$LOGFILE"

    # Append all output from here (logging set up only on fresh run)
    exec > >(tee -a "$LOGFILE")
    exec 2>&1
fi

echo "Script started: $(date)" >> "$LOGFILE"

# Check that this is a 64bit machine
uname -m | grep -q "64" || { echo "ERROR: A 64bit system is needed"; exit 1; }

# Check we are in a git clone
[[ -d "$RUN_DIR/.git" ]] || { echo -e "ERROR: This does not look like a Git repo.\n\n \
Please read the instructions in README.md carefully and try again."; exit 1; }

# Check we have internet and DNS
ping -c3 google.com > /dev/null || { echo "ERROR: Failed to find internet connection or DNS"; exit 1; }

# Self-update check
echo -e "Checking for any updates to this project...\n"
if LC_ALL=C git pull --ff-only | grep -q -v "Already up to date"; then
    echo "Update to freedv-rade-build project found — restarting..."
    echo "--- Restarting after update: $(date) ---"
    flock -u 8 || { echo "Failed to release lock"; exit 1; }
    exec "$RUN_DIR/freedv-rade-update" --restart "$@"
fi

echo "Script is up to date"


# Set default branch
default="master"
prbranches=()
pname=""
cname=""

# Get path of base dir in use, defaults to /home/$user
if cat /home/${user}/freedv-rade-build/freedv-rade-build.cfg |grep -v '^[#]'|grep -q "basedir="; then
    basedir=$(cat /home/${user}/freedv-rade-build/freedv-rade-build.cfg|grep -v '^[#]'|grep 'basedir='|cut -d= -f2)
else
    basedir=/home/$user
fi

confirm() {
params=( "$@" )
rval=7
while (( $rval > 6 )); do
    echo -ne "${params[0]} ${params[1]} "
    ans=
    rval=
    read -r ans
    # Get first option if ans is empty
    ans=${ans:-$(echo ${params[1]} | cut -b 2)}
    echo $ans
        case "$ans" in
            [${params[2]}])
                rval=0
                ;;
            [${params[3]}])
                rval=1
                ;;
            [${params[4]}])
                rval=2
                ;;
            [${params[5]}])
                rval=3
                ;;
            [${params[6]}])
                rval=4
                ;;
            [${params[7]}])
                rval=5
                ;;
            [${params[8]}])
                rval=6
                ;;
            *)
                rval=7
                ;;
        esac
done
    return $rval
}

fastupdt() {
cd ${basedir}/freedv-rade/freedv-gui || exit 1

_bi_base=""
_bi_prs=()
_bi_patches=()

# Remove any patched/edited files and sync to origin
echo "Resetting any patches or edits"
git reset --hard HEAD || { echo "ERROR: git reset failed"; exit 1; }
git clean -fd || { echo "ERROR: git clean failed"; exit 1; }

# --dev only: make sure this persistent clone also knows about the
# personal freedv-gui fork, as a second remote alongside 'origin'
# (upstream). This is what makes 'fork:branchname' resolvable below --
# without a fetched 'fork/branchname' ref, checking it out would just
# fail with "not a valid object name", so fetch it unconditionally
# whenever --dev is active rather than only when a fork: entry is
# actually used this run (keeps the branch-selection logic below simple,
# and the extra fetch is cheap/one remote).
if $DEV_MODE; then
    echo "Developer fork mode (--dev): 'fork:branchname' is available (barjac/freedv-gui)"
    if ! git remote get-url fork >/dev/null 2>&1; then
        echo "Adding 'fork' remote (barjac/freedv-gui)"
        git remote add fork https://github.com/barjac/freedv-gui.git
    fi
    git fetch fork || { echo "ERROR: git fetch fork failed - check network connection"; exit 1; }
fi

echo "Switching to $default and syncing with origin"
git fetch origin || { echo "ERROR: git fetch failed - check network connection"; exit 1; }
git checkout -B $default origin/$default || { echo "ERROR: failed to reset $default to origin/$default"; exit 1; }
git reset --hard origin/$default || { echo "ERROR: git reset to origin/$default failed"; exit 1; }
_bi_base="${default} @ $(git rev-parse --short HEAD)"

# Ensure git has an identity for merge commits; use a fallback if not configured
if ! git config user.email >/dev/null 2>&1; then
    export GIT_AUTHOR_NAME="freedv-rade-update"
    export GIT_AUTHOR_EMAIL="freedv-rade-update@localhost"
    export GIT_COMMITTER_NAME="freedv-rade-update"
    export GIT_COMMITTER_EMAIL="freedv-rade-update@localhost"
fi

if (( ${#prbranches[@]} == 0 )); then
        echo "Using branch $default"
    else
        # Split the selection into at most one branch/tag entry (the base)
        # and any number of PR-number entries to merge onto that base.
        # fork_base_entry is the --dev-only sibling of base_entry: same
        # "at most one base" rule, but sourced from the 'fork' remote
        # (barjac/freedv-gui) instead of 'origin' (upstream), and it can BE
        # the base outright -- unlike branch_entries below, which only ever
        # merge an origin branch on top of whatever base was already
        # chosen. That distinction matters here because a personal branch
        # like bcj-agc-gain-meter already has its own base (v3.0-dev) plus
        # feature commits baked in -- it needs to replace the base
        # entirely, not be merged onto one.
        base_entry=""
        fork_base_entry=""
        pr_entries=()
        branch_entries=()
        for entry in "${prbranches[@]}"; do
            if [[ "$entry" == pr:* ]]; then
                pr_entries+=("$entry")
            elif [[ "$entry" == branch:* ]]; then
                branch_entries+=("$entry")
            elif [[ "$entry" == fork:* ]]; then
                if ! $DEV_MODE; then
                    echo "ERROR: Fork branch '$entry' not in upstream. Use a PR number instead."
                    exit 1
                fi
                if [[ -n "$base_entry" || -n "$fork_base_entry" ]]; then
                    echo "ERROR: Only one branch/tag name may be used as the base ('${base_entry:-$fork_base_entry}' and '$entry' were both given). Use 'branch:name' to merge in additional branches, or PR numbers for PRs."
                    exit 1
                fi
                fork_base_entry="${entry#fork:}"
            elif [[ "$entry" == *:* ]]; then
                echo "ERROR: Fork branch '$entry' not in upstream. Use a PR number instead."
                exit 1
            else
                if [[ -n "$base_entry" || -n "$fork_base_entry" ]]; then
                    echo "ERROR: Only one branch/tag name may be used as the base ('${base_entry:-$fork_base_entry}' and '$entry' were both given). Use 'branch:name' to merge in additional branches, or PR numbers for PRs."
                    exit 1
                fi
                base_entry="$entry"
            fi
        done
        base_branch="${base_entry:-${fork_base_entry:-$default}}"

        if [[ -n "$fork_base_entry" ]]; then
            # Same "force-sync local ref, then use it as the base" shape as
            # the origin/$base_entry path below, just against the fork
            # remote -- and unlike that path there's no tag/local fallback,
            # since a fork: entry only ever means "a branch on my fork".
            if ! git rev-parse --verify -q "fork/$fork_base_entry" >/dev/null; then
                echo -e "\nError finding fork:$fork_base_entry - closing.\n"
                exit 1
            fi
            if ! git checkout -B "$fork_base_entry" "fork/$fork_base_entry"; then
                echo -e "\nError finding fork:$fork_base_entry - closing.\n"
                exit 1
            fi
            git reset --hard "fork/$fork_base_entry" || { echo "ERROR: failed to reset $fork_base_entry to fork/$fork_base_entry"; exit 1; }
            _bi_base="fork:${fork_base_entry} @ $(git rev-parse --short HEAD)"
        elif [[ -n "$base_entry" ]]; then
            if git rev-parse --verify -q "origin/$base_entry" >/dev/null; then
                # Remote branch - force-sync local ref to origin, same as $default,
                # so a prior run's leftover local commits (e.g. from patches applied
                # directly to this branch name) can't cause a "divergent branches"
                # pull failure here.
                if ! git checkout -B "$base_entry" "origin/$base_entry"; then
                    echo -e "\nError finding $base_entry - closing.\n"
                    exit 1
                fi
                git reset --hard "origin/$base_entry" || { echo "ERROR: failed to reset $base_entry to origin/$base_entry"; exit 1; }
            else
                # Not a remote branch (e.g. a tag) - check it out as-is, no sync needed.
                if git checkout "$base_entry" | grep -q "error:"; then
                    echo -e "\nError finding $base_entry - closing.\n"
                    exit 1
                fi
            fi
            _bi_base="${base_entry} @ $(git rev-parse --short HEAD)"
        fi

        if (( ${#pr_entries[@]} == 0 && ${#branch_entries[@]} == 0 )); then
            # Branch/tag only, nothing to merge onto it.
            echo "Using branch $base_branch"
        else
            # One or more PRs and/or plain branches to merge onto the base branch (default, or the named one).
            git checkout -B build/combined "$base_branch" \
                || { echo "ERROR: Could not create build/combined branch"; exit 1; }
            # Pre-fetch each PR's head branch name so a PR stacked on another
            # PR in this same batch (base == that other PR's head branch)
            # isn't flagged as a mismatch - only a base outside this batch
            # and outside $base_branch pulls in unrelated history.
            declare -A _pr_head_refs
            for entry in "${pr_entries[@]}"; do
                _pn="${entry#pr:}"
                _pr_head_refs[$_pn]=$(gh pr view "$_pn" --json headRefName -q .headRefName 2>/dev/null)
            done

            for entry in "${pr_entries[@]}"; do
                prnumber="${entry#pr:}"
                pr_base=$(gh pr view "$prnumber" --json baseRefName -q .baseRefName 2>/dev/null)
                if [[ -z "$pr_base" ]]; then
                    # gh not installed, not authenticated, or lookup otherwise
                    # failed -- rather than skip the check entirely, assume
                    # the overwhelmingly common case (PR based on master) so
                    # the mismatch check below still fires when building a
                    # non-master base_branch (e.g. v3.0-dev) with a PR whose
                    # real base we couldn't confirm.
                    echo "NOTE: Could not look up base branch for PR #$prnumber via 'gh' (not installed, or lookup failed) — defaulting to 'master' for the base-branch check below."
                    pr_base="master"
                fi
                if [[ "$pr_base" != "$base_branch" ]]; then
                    _stacked_on=""
                    for _other_pn in "${!_pr_head_refs[@]}"; do
                        [[ "$_other_pn" == "$prnumber" ]] && continue
                        if [[ -n "$pr_base" && "$pr_base" == "${_pr_head_refs[$_other_pn]}" ]]; then
                            _stacked_on="$_other_pn"
                            break
                        fi
                    done
                    if [[ -n "$_stacked_on" ]]; then
                        echo "NOTE: PR #$prnumber is based on '$pr_base', which is PR #${_stacked_on}'s branch also being merged in this build - treating as a stacked PR, not a mismatch."
                    else
                        echo -e "\nWARNING: PR #$prnumber is based on '$pr_base', not '$base_branch'. Merging it would pull in all of '$pr_base''s unique history (not just this PR's diff)."
                        echo "(This can be a false positive if 'gh' isn't installed/authenticated here -- the fallback assumes 'master' when it can't look up the real base.)"
                        confirm "(M)erge anyway, (S)kip this PR, or (A)bort the build?" "[M/S/A]" "Mm" "Ss" "Aa"
                        case $? in
                            0)
                                echo "Merging PR #$prnumber anyway."
                                ;;
                            1)
                                echo "Skipping PR #$prnumber."
                                continue
                                ;;
                            *)
                                echo "ERROR: Aborting build due to PR #$prnumber base-branch mismatch."
                                exit 1
                                ;;
                        esac
                    fi
                fi
                echo "Fetching PR #$prnumber..."
                git fetch origin "+refs/pull/$prnumber/head:pr/$prnumber" \
                    || { echo "ERROR: Failed to fetch PR #$prnumber"; exit 1; }
                prhead=$(git rev-parse --short "pr/$prnumber")
                echo "Merging PR #$prnumber..."
                if ! git merge --no-edit "pr/$prnumber"; then
                    git merge --abort 2>/dev/null
                    echo "ERROR: PR #$prnumber conflicts with existing changes — aborting."
                    exit 1
                fi
                echo "PR #$prnumber merged OK"
                _bi_prs+=("pr:${prnumber} @ ${prhead}")
            done

            for entry in "${branch_entries[@]}"; do
                brname="${entry#branch:}"
                if ! git rev-parse --verify -q "origin/$brname" >/dev/null; then
                    echo "ERROR: Branch '$brname' not found on origin."
                    exit 1
                fi
                echo -e "\nNOTE: '$brname' is a plain branch, not a PR, so there's no recorded base to check it against '$base_branch' — make sure it's intended to build on top of that."
                brhead=$(git rev-parse --short "origin/$brname")
                echo "Merging branch $brname (@ $brhead)..."
                if ! git merge --no-edit "origin/$brname"; then
                    git merge --abort 2>/dev/null
                    echo "ERROR: Branch $brname conflicts with existing changes — aborting."
                    exit 1
                fi
                echo "Branch $brname merged OK"
                _bi_prs+=("branch:${brname} @ ${brhead}")
            done

            echo "Using base $base_branch combined with: ${pr_entries[*]} ${branch_entries[*]}"
        fi
    fi

# Save PR/branch selection for reuse next time
if (( ${#prbranches[@]} > 0 )); then
    printf '%s\n' "${prbranches[@]}" > "/home/${user}/freedv-rade-build/.last-prs"
fi

# Use a specific commit (before applying patches so patches land on top of it)
if (( ${#cname} > 0 )); then
    if ! git checkout --detach $cname; then
        echo "ERROR: Can't find that git#"
        exit 1
    fi
    _bi_base="pinned:$(git rev-parse --short HEAD)"
    _bi_prs=()
fi

# Apply patches oldest-first regardless of the order they were picked/kept
# in above, so a newer/more specific patch always lands on top of a more
# evolved tree state instead of an older one landing on top of a newer
# one's assumptions -- matches the safer convention of applying manually
# and reduces the odds of a conflict.
if (( ${#patches[@]} > 1 )); then
    _sorted_patches=()
    while IFS= read -r _p; do
        _sorted_patches+=("$_p")
    done < <(
        for _p in "${patches[@]}"; do
            _t=$(git -C "/home/${user}/freedv-rade-build" log -1 --format=%at -- "$_p" 2>/dev/null)
            [[ -n "$_t" ]] || _t=$(stat -c %Y "/home/${user}/freedv-rade-build/$_p" 2>/dev/null)
            printf '%s %s\n' "${_t:-0}" "$_p"
        done | sort -n | awk '{print $2}'
    )
    patches=("${_sorted_patches[@]}")
fi

# Apply patches if there are any
if (( ${#patches[@]} > 0 )); then
    for patch in "${patches[@]}"; do
    echo "Applying $patch"
    _patch_out=$(patch -p1 --forward < /home/${user}/freedv-rade-build/$patch 2>&1)
    _patch_exit=$?
    echo "$_patch_out"
    if (( _patch_exit != 0 )); then
        if echo "$_patch_out" | grep -q "previously applied\|Skipping patch"; then
            echo "WARNING: $patch appears already applied (included in a merged PR?) — skipping."
        else
            echo "$patch failed to apply.  pwd= $(pwd)"
            exit 1
        fi
    else
        _bi_patches+=("${patch#patches/}")
    fi
    done
    git add -A
    git -c user.email="freedv@localhost" -c user.name="FreeDV Update" commit -m "Applied patches: ${patches[*]}"
    printf '%s\n' "${patches[@]}" > "/home/${user}/freedv-rade-build/.last-patches"
fi

cd build_linux || exit 1
if ! [[ -h model19_check3 ]]; then
    ln -s "$(pwd)"/rade_src/model19_check3 model19_check3
fi
# WX_BUILT_FOR_GTK3 is a cached CMake probe result (src/CMakeLists.txt).
# A build tree that ever cached it false (e.g. from the pre-#1450
# CMAKE_REQUIRED_DEFINITIONS bug, before the -D prefix fix) keeps reusing
# that stale false forever on incremental `make`-triggered reconfigures --
# CMake only re-runs a cached check if the cache entry is gone. Purge it
# every run so it's always re-probed fresh; harmless no-op if it's not
# cached or already correct.
if [[ -f CMakeCache.txt ]]; then
    cmake -U WX_BUILT_FOR_GTK3 . >/dev/null 2>&1
fi
if [[ $DEBUG == true ]]; then
    make VERBOSE=1
else
    make
fi
make_exit=$?
if (( make_exit != 0 )); then
    bad_filename=$(grep -o 'Consider deleting local copy of [^ ]*' "$LOGFILE" | tail -1 | awk '{print $NF}')
    if [[ -z "$bad_filename" ]]; then
        bad_file=$(grep -o 'for file: \[.*\]' "$LOGFILE" | tail -1 | sed 's/for file: \[//;s/\]//')
    else
        bad_file=$(find "${basedir}/freedv-rade/freedv-gui/build_linux" -name "$bad_filename" 2>/dev/null | head -1)
    fi
    if [[ -n "$bad_file" && -f "$bad_file" ]]; then
        echo ""
        echo "Checksum error on cached download: $bad_file"
        echo "Deleting and retrying..."
        rm -f "$bad_file"
        if [[ $DEBUG == true ]]; then
            make VERBOSE=1
        else
            make
        fi
        make_exit=$?
    fi
    if (( make_exit != 0 )) && grep -qE "FAILED -- saving rejects to file|\.rej$" "$LOGFILE"; then
        echo ""
        echo "ERROR: A source patch failed to apply while building a dependency (most likely the Opus/RADE"
        echo "build, which tracks an unpinned upstream branch and can drift out of sync with a stale cached"
        echo "build tree)."
        echo "Please run freedv-rade-update again and choose the 'F' (Full rebuild) option to fix this."
    fi
fi
cd || exit 1
if (( make_exit == 0 )); then
    _bi_details="$_bi_base"
    for _pr in "${_bi_prs[@]}"; do
        _bi_details="$_bi_details $_pr"
    done
    if (( ${#_bi_patches[@]} > 0 )); then
        _bi_details="$_bi_details | ${_bi_patches[*]}"
    fi
    write_build_index "$_bi_details"
fi
return $make_exit
}

bye() {
echo -e "\nClosing - Goodbye! :)"
sleep 1
flock -u 8 || { echo "Failed to release lock"; exit 1; }
# Close the fds feeding the logging tee (exec > >(tee ...)) so it gets
# EOF and exits promptly instead of lingering as an orphan holding the
# terminal's pty open.
exec >&- 2>&-
exit 0
}

clearvars () {
fastupdt=
update=
backup=
restore=
switch=
desktop=
}

write_build_index() {
    local details="$1"
    local _idx_file="/home/${user}/freedv-rade-build/.build_index"
    local _build_file="${basedir}/freedv-rade/.build"
    local _next=1
    if [[ -f "$_idx_file" ]] && [[ -s "$_idx_file" ]]; then
        _next=$(( $(awk '{print $1+0}' "$_idx_file" | sort -n | tail -1) + 1 ))
    fi
    local _entry
    _entry="$(printf '%d | %s | %s' "$_next" "$details" "$(date '+%Y-%m-%d %H:%M')")"
    echo "$_entry" >> "$_idx_file"
    echo "$_next" > "$_build_file"
    echo "Build #$_next recorded: $_entry"
}

# Show build details for a given directory (label, dir path)
show_dir_build() {
    local _label="$1"
    local _dir="$2"
    local _idx_file="/home/${user}/freedv-rade-build/.build_index"
    local _build_file="${_dir}/.build"
    if [[ -f "$_build_file" ]]; then
        local _idx
        _idx=$(tr -d '[:space:]' < "$_build_file")
        local _record
        _record=$(grep "^${_idx} |" "$_idx_file" 2>/dev/null)
        if [[ -n "$_record" ]]; then
            local _display="${_record#*| }"
            echo "  ${_label}: build #${_idx}: ${_display//patches\//}"
        else
            echo "  ${_label}: build #${_idx} (no index entry found)"
        fi
    else
        echo "  ${_label}: no build record"
    fi
}

# Show details of the current installed build
showcurrent() {
    local currdir="$(pwd)"
    local _idx_file="/home/${user}/freedv-rade-build/.build_index"
    local _build_file="${basedir}/freedv-rade/.build"
    if [[ -f "$_build_file" ]]; then
        local _idx
        _idx=$(tr -d '[:space:]' < "$_build_file")
        local _record
        _record=$(grep "^${_idx} |" "$_idx_file" 2>/dev/null)
        if [[ -n "$_record" ]]; then
            local _display="${_record#*| }"
            echo -e "\nNOTE: Current build #${_idx}: ${_display//patches\//}\n"
        else
            echo -e "\nNOTE: Build #${_idx} recorded but no index entry found\n"
        fi
    else
        cd "${basedir}/freedv-rade/freedv-gui" 2>/dev/null && \
            echo -e "\nNOTE: No build record (git: $(git branch --show-current 2>/dev/null || echo HEAD) @ $(git rev-parse --short HEAD 2>/dev/null))\n" || \
            echo -e "\nNOTE: No build record available\n"
        cd "$currdir"
    fi
}

# Main routine ###################
clear
clearvars

cd ~/freedv-rade-build

# Show branch if not main
branch="$(git status|grep 'On branch')"
if [[ $branch =~ "main" ]]; then
    branch=
fi

echo "Wait a moment..."

# Check we have internet and DNS
ping -c3 google.com > /dev/null || { echo "ERROR: Failed to find internet connection or DNS"; exit 1; }

# Do all from user's home folder even if base dir is elsewhere
cd || exit 1

# Check that freedv-rade-build is there
[[ -d freedv-rade-build ]] || { echo -e "ERROR: The freedv-rade-build folder is missing!\nFollow the instructions in the README #at:\nhttps://github.com/barjac/freedv-rade-build\n"; exit 1; }

# Preamble
clear
echo "############### Welcome to freedv-rade-update ################ $branch"
echo -e "\n This script is for maintaining a build of FreeDV RADE \n \
created using freedv-rade-build script.\n"
echo -e "It will optionally:\n \
* Update FreeDV to the latest $default or a specified branch (fast, recommended) \n \
* Fully rebuild FreeDV from scratch (runs freedv-rade-build). \n \
* Create a backup of the current version in use.\n \
* Restore from a previous backup.\n \
* Switch backup with current \n \
* Create a new FreeDV-RADE desktop file.\n \
* Quit the program.\n\n\
************** Nothing will be done until you finally confirm after the summary *************

TIP: Hitting ENTER without typing will automatically select the first option to questions."

# Check if there is already a backup and flag it
[[ -d ${basedir}/freedv-rade_bak ]] && bak=1

echo ""
show_dir_build "Current" "${basedir}/freedv-rade"
[[ -d ${basedir}/freedv-rade_bak ]] && show_dir_build "Backup " "${basedir}/freedv-rade_bak"
echo ""

if grep -q venv < ~/freedv-start; then
    echo "*************************** Your system is using a Python based version of FreeDV RADE."
    echo "*************************** You MUST use the 'Full rebuild' (f) option NOW to update to the new C build."
fi

if (( bak == 1 )); then

    confirm "\nDo you want to (U)pdate, (F)ull re-build, (B)ackup, (R)estore from backup, (S)witch backup/current, Create (D)esktop launcher or (Q)uit?" "[U/F/B/R/S/D/Q]" "Uu" "Ff" "Bb" "Rr" "Ss" "Dd" "Qq"
        case $rval in
            0)
            fastupdt=1
            ;;
            1)
            update=1
            ;;
            2)
            backup=1
            ;;
            3)
            restore=1
            ;;
            4)
            switch=1
            ;;
            5)
            desktop=1
            ;;
            6)
            bye
            ;;
        esac
else
        confirm "\nDo you want to (U)pdate, (F)ull re-build,  (B)ackup, create (D)esktop launcher or (Q)uit?" "[U/F/B/D/Q]" "Uu" "Ff" "Bb" "Dd" "qQ"
        case $rval in
            0)
            fastupdt=1
            ;;
            1)
            update=1
            ;;
            2)
            backup=1
            ;;
            3)
            desktop=1
            ;;
            4)
            bye
            ;;
        esac
fi

prbranches=()
patches=()
_profile_loaded=false
_profile_edit_mode=false
_profiles_file="/home/${user}/freedv-rade-build/.profiles"

# --profile=NAME given on the command line: load it now and skip the
# top-level menu entirely, same as picking (U)pdate by hand.
if [[ -n "$PROFILE_NAME" ]]; then
    fastupdt=1
    _match_line=""
    if [[ -f "$_profiles_file" ]] && [[ -s "$_profiles_file" ]]; then
        _match_line=$(awk -F' \\| ' -v want="$PROFILE_NAME" '$1 == want' "$_profiles_file")
    fi
    if [[ -z "$_match_line" ]]; then
        echo -e "\nERROR: No saved profile named '$PROFILE_NAME' found."
        if [[ -f "$_profiles_file" ]] && [[ -s "$_profiles_file" ]]; then
            echo "Available profiles:"
            awk -F' \\| ' '{print "  - " $1}' "$_profiles_file"
        fi
        exit 1
    fi
    IFS='|' read -r _p_desc _p_prbranches _p_patches _p_cname <<< "$_match_line"
    read -ra prbranches <<< "$_p_prbranches"
    read -ra patches <<< "$_p_patches"
    cname="$(echo "$_p_cname" | xargs)"
    echo -e "\nLoaded profile '$(echo "$_p_desc" | xargs)' (--profile)."
    _profile_loaded=true
fi

# Quick top-level shortcut, always offered regardless of whether any
# profile has been saved yet -- Enter/Y builds plain master with no
# further questions at all. Reuses _profile_loaded (rather than a new
# flag) since "master, nothing customised" is exactly what an empty
# prbranches/patches/cname with _profile_loaded=true already means to
# every question below, including the save-profile skip logic.
# Answering n falls through to whatever applies next: today's [N/e/y]
# profile picker if any profile exists, or straight to the plain manual
# questions if none do yet.
if (( fastupdt == 1 )) && ! $_profile_loaded && confirm "\nUpdate to current master branch now?" "[Y/n]" "Yy" "Nn"; then
    _profile_loaded=true
fi

# Offer a saved profile as a shortcut for the questions below. Three-way
# choice, not a plain y/N -- (e)dit still walks through the branch/patch/
# commit questions below (pre-filled from the chosen profile instead of
# .last-prs/.last-patches/blank, so any single field can be changed before
# a rebuild, then optionally re-saved under a new description at the end),
# while (y) skips them entirely and uses the profile exactly as saved.
if (( fastupdt == 1 )) && ! $_profile_loaded && [[ -f "$_profiles_file" ]] && [[ -s "$_profiles_file" ]]; then
    _profile_lines=()
    while IFS= read -r _line; do
        _profile_lines+=("$_line")
    done < "$_profiles_file"
    # Newest-saved first, so the inline preview below ("the top one") and
    # entry #1 in the picker are always the same profile.
    _profile_lines_display=()
    for (( _i=${#_profile_lines[@]}-1; _i>=0; _i-- )); do
        _profile_lines_display+=("${_profile_lines[_i]}")
    done
    _top_desc="$(echo "${_profile_lines_display[0]%%|*}" | xargs)"

    confirm "\nReuse previous build ('$_top_desc')?" "[N/e/y]" "Nn" "Ee" "Yy"
    if (( rval == 1 || rval == 2 )); then
        echo -e "\nSaved profiles:"
        for _i in "${!_profile_lines_display[@]}"; do
            printf "  %2d) %s\n" "$((_i+1))" "$(echo "${_profile_lines_display[$_i]%%|*}" | xargs)"
        done
        read -rp "Profile number: " _pnum
        if [[ "$_pnum" =~ ^[0-9]+$ ]] && (( _pnum >= 1 && _pnum <= ${#_profile_lines_display[@]} )); then
            IFS='|' read -r _p_desc _p_prbranches _p_patches _p_cname <<< "${_profile_lines_display[$((_pnum-1))]}"
            if (( rval == 2 )); then
                # y: use as-is, skip the questions below entirely.
                read -ra prbranches <<< "$_p_prbranches"
                read -ra patches <<< "$_p_patches"
                cname="$(echo "$_p_cname" | xargs)"
                echo -e "\nLoaded profile '$(echo "$_p_desc" | xargs)'."
                _profile_loaded=true
            else
                # e: seed the questions below with this profile's values,
                # but still ask each one so they can be changed.
                _edit_prbranches="$(echo "$_p_prbranches" | xargs)"
                _edit_patches="$(echo "$_p_patches" | xargs)"
                _edit_cname="$(echo "$_p_cname" | xargs)"
                echo -e "\nEditing from profile '$(echo "$_p_desc" | xargs)' -- each question below is pre-filled, change or accept as needed."
                _profile_edit_mode=true
            fi
        else
            echo "Invalid selection - continuing with manual entry."
        fi
    fi
fi

if (( fastupdt == 1 )) && ! $_profile_loaded && { $_profile_edit_mode || confirm "\n\nUse a specific branch, tag or PR(s)?" "[N/y]" "yY" "nN"; }; then
    _last_prs_file="/home/${user}/freedv-rade-build/.last-prs"
    _default_input=""

    # In edit mode, seed from the chosen profile instead of .last-prs.
    if $_profile_edit_mode && [[ -n "$_edit_prbranches" ]]; then
        _default_input="$_edit_prbranches"
    # Build editable default from previously used PRs/branches (strip pr: prefix)
    elif [[ -f "$_last_prs_file" ]] && [[ -s "$_last_prs_file" ]]; then
        while IFS= read -r _line; do
            _line="${_line#pr:}"
            _default_input="${_default_input:+$_default_input }$_line"
        done < "$_last_prs_file"
    fi

    echo -e "\nNOTE: Enter PR numbers, a base branch/tag name, and/or 'branch:name' to merge in another branch, space-separated."
    $DEV_MODE && echo "NOTE: --dev active -- 'fork:branchname' also accepted as the base (barjac/freedv-gui)."
    [[ -n "$_default_input" ]] && echo "(Edit or clear the previous selection below)"
    if [[ -n "$_default_input" ]]; then
        read -r -e -i "$_default_input" -p "PR(s)/branch: " _input
    else
        read -r -e -p "PR(s)/branch: " _input
    fi

    for entry in $_input; do
        [[ "$entry" =~ ^[0-9]+$ ]] && entry="pr:$entry"
        prbranches+=("$entry")
    done
fi

if (( fastupdt == 1 )) && ! $_profile_loaded && { $_profile_edit_mode || confirm "\n\nAdd patch(es)?" "[N/y]" "yY" "nN"; }; then
    patches=()
    _bdir="/home/${user}/freedv-rade-build"
    _last_file="${_bdir}/.last-patches"
    _patch_dir="${_bdir}/patches"

    # Build the list of patches/ subdirectory entries up front (used by both
    # the fresh-pick and edit-list flows below). Sorted by each file's last
    # git commit time, not filesystem mtime -- a `git pull` here (the normal
    # way this machine picks up new patches) resets every touched file's
    # mtime to the checkout time, so several patches pulled in one go end up
    # with identical/indistinguishable mtimes and sort arbitrarily among
    # themselves. Falls back to mtime for any untracked patch file.
    _available=()
    if [[ -d "$_patch_dir" ]]; then
        while IFS= read -r _f; do
            _available+=("$_f")
        done < <(
            for _p in "$_patch_dir"/*.patch; do
                [[ -e "$_p" ]] || continue
                _base="$(basename "$_p")"
                _t=$(git -C "$_bdir" log -1 --format=%at -- "patches/$_base" 2>/dev/null)
                [[ -n "$_t" ]] || _t=$(stat -c %Y "$_p")
                printf '%s %s\n' "$_t" "$_base"
            done | sort -rn | awk '{print $2}'
        )
    fi

    # Offer to reuse recent patches (or, in edit mode, the chosen profile's
    # own patches instead of .last-patches).
    _last_patches=()
    if $_profile_edit_mode && [[ -n "$_edit_patches" ]]; then
        read -ra _last_patches <<< "$_edit_patches"
    elif [[ -f "$_last_file" ]] && [[ -s "$_last_file" ]]; then
        mapfile -t _last_patches < "$_last_file"
    fi
    if (( ${#_last_patches[@]} > 0 )); then
        echo -e "\nRecent patches:"
        for _i in "${!_last_patches[@]}"; do
            printf "  %2d) %s\n" "$((_i+1))" "${_last_patches[$_i]#patches/}"
        done
        confirm "(U)se these as-is, (E)dit the list, or start (F)resh?" "[U/E/F]" "Uu" "Ee" "Ff"
        case $? in
            0)
                patches=("${_last_patches[@]}")
                ;;
            1)
                # Single step: remove by number from the one list already
                # shown above (no second, differently-numbered list unless
                # actually adding something new). 'a' anywhere in the input
                # (alone, or alongside numbers to remove) opts into a
                # follow-up pick from the full patches/ directory.
                patches=("${_last_patches[@]}")
                read -rp "Numbers to REMOVE (blank to keep all), or add 'a' to also pick from the full list: " _edit_input
                _want_add=false
                for _tok in $_edit_input; do
                    if [[ "$_tok" =~ ^[Aa]$ ]]; then
                        _want_add=true
                    elif [[ "$_tok" =~ ^[0-9]+$ ]] && (( _tok >= 1 && _tok <= ${#_last_patches[@]} )); then
                        unset 'patches[_tok-1]'
                    fi
                done
                patches=("${patches[@]}")

                if $_want_add && (( ${#_available[@]} > 0 )); then
                    echo -e "\nAvailable patches:"
                    for _i in "${!_available[@]}"; do
                        printf "  %2d) %s\n" "$((_i+1))" "${_available[$_i]}"
                    done
                    echo -e "Numbers to add (space-separated, blank for none):"
                    read -r _add
                    for _num in $_add; do
                        if [[ "$_num" =~ ^[0-9]+$ ]] && (( _num >= 1 && _num <= ${#_available[@]} )); then
                            _new="patches/${_available[$((_num-1))]}"
                            [[ " ${patches[*]} " == *" $_new "* ]] || patches+=("$_new")
                        fi
                    done
                fi
                ;;
            *)
                : # start fresh: fall through to the patches/ subdirectory pick below
                ;;
        esac
    fi

    # Pick list from patches/ subdirectory
    if (( ${#patches[@]} == 0 )); then
        if (( ${#_available[@]} > 0 )); then
            echo -e "\nAvailable patches:"
            for _i in "${!_available[@]}"; do
                printf "  %2d) %s\n" "$((_i+1))" "${_available[$_i]}"
            done
            echo -e "Enter numbers (space-separated), or 0 for manual entry:"
            read -r _sel
            echo "Patch numbers entered: $_sel"
            if [[ "$_sel" != "0" ]]; then
                for _num in $_sel; do
                    if [[ "$_num" =~ ^[0-9]+$ ]] && (( _num >= 1 && _num <= ${#_available[@]} )); then
                        patches+=("patches/${_available[$((_num-1))]}")
                    fi
                done
            fi
        fi

        # Manual fallback (if no patches/ dir, empty, or user chose 0)
        if (( ${#patches[@]} == 0 )); then
            echo -e "\n NOTE: Patch files must be in ${_bdir}/ or ${_bdir}/patches/"
            while true; do
                read -rp "Enter a patch filename (or press Enter to finish): " file
                [[ -z "$file" ]] && break
                if [[ ! -f "${_bdir}/$file" ]]; then
                    echo -e "\nERROR: Patch file '$file' not found in ${_bdir}/"
                    if confirm "Continue without this patch?" "[Y/n]" "yY" "nN"; then
                        continue
                    else
                        exit 1
                    fi
                fi
                patches+=("$file")
            done
        fi
    fi
fi

# Auto-detect base commit from per-patch sidecar .commit files. Skipped
# when a profile was loaded -- its own saved cname already reflects
# whatever this detection produced back when the profile was saved.
if (( fastupdt == 1 )) && ! $_profile_loaded && (( ${#patches[@]} > 0 )); then
    for _p in "${patches[@]}"; do
        _sidecar="/home/${user}/freedv-rade-build/${_p%.patch}.commit"
        if [[ -f "$_sidecar" ]]; then
            _sc=$(tr -d '[:space:]' < "$_sidecar")
            echo -e "\nPatch $(basename "$_p") is using base commit $_sc."
            cname="$_sc"
            break
        fi
    done
fi

# Ask about a specific commit (skipped if a patch sidecar already set one,
# or if a loaded profile already set one -- including intentionally empty).
# In edit mode, skip straight to the pre-filled edit-confirm line -- unless
# the chosen profile had no commit pin at all, in which case leave it alone
# rather than asking a fresh question that profile didn't have an answer to.
if (( fastupdt == 1 )) && ! $_profile_loaded && [[ -z "$cname" ]]; then
    if $_profile_edit_mode; then
        if [[ -n "$_edit_cname" ]]; then
            read -r -e -i "$_edit_cname" -p $'\nEdit commit if needed, Enter to confirm: ' cname
        fi
    elif confirm "\n\nUse a specific commit?" "[N/y]" "yY" "nN"; then
        read -r -p "Enter the commit git#: " cname
        if [[ -n "$cname" ]]; then
            read -r -e -i "$cname" -p "Edit if needed, Enter to confirm: " cname
        fi
    fi
fi

if ( (( fastupdt == 1 )) || (( update == 1 )) || (( backup == 1 )) ) && (( desktop != 1 )) && (( bak != 1 )) && (( restore != 1 )) && (( switch != 1 )); then
# Ask to backup with the current version
    echo -e "\nYou currently have no backup of FreeDV-RADE."
    if confirm "\nCreate a backup of the current version?" "[N/y]" "Yy" "Nn"; then
         backup=1
        # Check we have space
        (( $(df -hBG --output=avail $basedir |tr '\n' ' '|tr -s ' '|xargs|cut -d ' ' -f2|cut -dG -f1) > 3 )) || { echo -e "\nInsufficient disk space for backup"; backup=0; }
    else
        backup=0
    fi
fi

if (( bak == 1 )) && (( restore != 1 )) && (( desktop != 1 )) && (( switch != 1 )); then
    echo -e "\nYou already have a backup of a previous FreeDV build."
    if confirm "Replace the current backup with a new one of the current version?" "[N/y]" "Yy" "Nn"; then
        backup=1
        overwrite=1
    else
        backup=0
    fi
fi

# Debug
#echo "U=$fastupdt F=$update B=$backup R=$restore S=$switch D=$desktop prbranches=${prbranches[*]}"
# Summary of what will be done
if (( fastupdt == 1 )) || (( update == 1 )) || (( backup == 1 )) || (( restore == 1 )) || (( desktop == 1 )) || (( switch == 1 )); then
    echo -e "\n\nSummary of selected tasks:"
    echo -e "###########################\n"
    if (( backup == 1 )) ; then
        if (( bak == 1 )); then 
            if (( overwrite == 1 )); then
                echo "A new backup will be created overwriting the old backup."
            else
                echo "A new backup will be created."
            fi
        else
            echo "A backup will be created."
        fi
    fi

    if (( fastupdt == 1 )); then
        if (( ${#prbranches[@]} == 0 )); then
            updt_str="built at $default"
        else
            _preview_base="$default"
            _preview_prs=()
            _preview_branches=()
            for _entry in "${prbranches[@]}"; do
                if [[ "$_entry" == pr:* ]]; then
                    _preview_prs+=("${_entry#pr:}")
                elif [[ "$_entry" == branch:* ]]; then
                    _preview_branches+=("${_entry#branch:}")
                elif [[ "$_entry" == fork:* ]]; then
                    _preview_base="${_entry#fork:} (fork)"
                else
                    _preview_base="$_entry"
                fi
            done
            _preview_merge=()
            (( ${#_preview_prs[@]} > 0 )) && _preview_merge+=("PR(s) ${_preview_prs[*]}")
            (( ${#_preview_branches[@]} > 0 )) && _preview_merge+=("branch(es) ${_preview_branches[*]}")
            if (( ${#_preview_merge[@]} == 0 )); then
                updt_str="built at $_preview_base"
            else
                updt_str="built at $_preview_base with ${_preview_merge[*]} merged"
            fi
        fi

        if (( ${#cname} > 0 )); then
            updt_str="$updt_str at commit $cname"
        fi

        if (( ${#patches[@]} > 0 )); then
            updt_str="$updt_str and patched with ${patches[@]}"
        fi
        echo "FreeDV will be $updt_str"
    fi

    if (( update == 1 )); then 
        echo "FreeDV will be fully re-built from latest $default"
    fi

    if (( restore == 1 )); then
        echo -e "FreeDV will be restored from your current backup which will remain in place.\nThis will overwrite your current version."
    fi

    if (( switch == 1 )); then
        echo -e "The current version will be switched with the one in backup and vice versa:"
        show_dir_build "Current" "${basedir}/freedv-rade"
        show_dir_build "Backup " "${basedir}/freedv-rade_bak"
    fi

    if (( desktop == 1 )); then
        echo -e "A new FreeDV-RADE desktop file (Icon) will be added to your desktop unless\n \
 a file named 'Freedv-RADE.desktop already exists (maybe re-name it?)."
    fi

    if confirm "\nPerform the selected tasks?" "[Y/n]" "Yy" "Nn"; then

# Create backup
        if (( backup == 1)); then
            echo -e "\nCreating backup..."
            rm -rf ${basedir}/freedv-rade_bak/
            if cp -rf ${basedir}/freedv-rade/ ${basedir}/freedv-rade_bak; then
                echo "Backup complete."
            else
                echo "Backup failed."
                exit 1
            fi
        fi

# Fast update
        if (( fastupdt == 1 )); then
            if (( ${#prbranches[@]} > 1 )); then
                echo -e "\nStarting fast update in 3 seconds combining PRs: ${prbranches[*]}."
            elif (( ${#prbranches[@]} == 1 )); then
                echo -e "\nStarting fast update in 3 seconds to ${prbranches[0]}."
            else
                echo -e "\nStarting fast update in 3 seconds to latest $default."
            fi
            sleep 3
            if fastupdt; then
                echo "Update complete"
                # Nothing to offer saving when there's nothing that could
                # differ from what's already on disk/in .profiles: either
                # an existing profile was used exactly as-is (_profile_loaded),
                # or this was a plain default build with no branch/PR, patch,
                # or commit customisation at all.
                if ! $_profile_loaded \
                    && ! { (( ${#prbranches[@]} == 0 )) && (( ${#patches[@]} == 0 )) && [[ -z "$cname" ]]; } \
                    && confirm "\nSave this build configuration as a reusable profile?" "[N/y]" "yY" "nN"; then
                    read -rp "Description: " _profile_desc
                    if [[ -n "$_profile_desc" ]]; then
                        printf '%s | %s | %s | %s\n' "$_profile_desc" "${prbranches[*]}" "${patches[*]}" "$cname" \
                            >> "/home/${user}/freedv-rade-build/.profiles"
                        echo "Profile saved: $_profile_desc"
                    else
                        echo "No description entered - profile not saved."
                    fi
                fi
            else
                echo "Update failed"
                exit 1
            fi
        fi

# Restore from backup
        if (( restore == 1 )); then
            echo -e "\nRestoring from backup..."
            if (rm -rf ${basedir}/freedv-rade/ && cp -rf ${basedir}/freedv-rade_bak/ ${basedir}/freedv-rade); then
                echo "Restore complete."
            else
                echo "Restore failed."
                exit 1
            fi
        fi

# Switch backup with current
		if (( switch == 1 )); then
			echo -e "\nSwitching backup with current..."
			[[ -d ${basedir}/freedv-rade_tmp ]] && rm -fr ${basedir}/freedv-rade_tmp

			mv ${basedir}/freedv-rade ${basedir}/freedv-rade_tmp || { echo "Failed to move freedv-rade to freedv-rade_tmp"; exit 1; }
			mv ${basedir}/freedv-rade_bak ${basedir}/freedv-rade || { echo "Failed to move freedv-rade_bak to freedv-rade"; exit 1; }
			mv ${basedir}/freedv-rade_tmp ${basedir}/freedv-rade_bak ||{ echo "Failed to move freedv-rade_tmp to freedv-rade_bak"; exit 1; }
			echo -e "\nDone :)\n"
		fi

# Full re-build
        if (( update == 1 )); then 
            echo -e "\nStarting full rebuild in 3 seconds. Please be patient this will take some time ..."
            sleep 3
            if freedv-rade-build/freedv-rade-build; then
                echo "Full rebuild complete"
                _commit=$(git -C "${basedir}/freedv-rade/freedv-gui" rev-parse --short HEAD 2>/dev/null || echo "unknown")
                write_build_index "${default} @ ${_commit}"
            else
                echo "Full rebuild failed"
                exit 1
            fi
        fi
# Desktop file
        if (( desktop == 1 )); then
            freedv-rade-build/mk-desktop
        fi

        if grep -q venv < ~/freedv-start; then
            echo -e "Your ~/freedv-start script has been edited to work without Python \n\
                 and a backup of the original has been saved as freedv-start.pybak. \n\
                 Any other custom start scripts will need to be modified in a similar fashion. \n"
            sed -i.pybak \
                -e '/PYTHONPATH.*src\/freedv/ s/.*/src\/freedv $@/' \
                -e '/venv\|deactivate\|python\|PYTHONPATH\|environment/Id' ~/freedv-start
        fi
    fi
else
    bye
fi
read -r -s -n 1 -p $'\nPress any key to exit...'
echo
bye
