+// Test-only prototype, see LoudnessMeterStep.h. wxGauge has no per-segment
+// fill colour on any platform (it's a single theme-drawn bar), so a plain
+// wxGauge can't show "green up to target, orange beyond it" -- this draws
+// its own two-colour bar instead. API mirrors the small subset of wxGauge
+// used elsewhere (SetValue/SetRange/GetRange) so it's a drop-in replacement
+// at call sites.
+class TxLuMeterGauge : public wxPanel
+{
+    public:
+        TxLuMeterGauge(wxWindow* parent, int range, int thresholdValue);
+
+        void SetValue(int value);
+        void SetRange(int range) { m_range = range; Refresh(); }
+        int GetRange() const { return m_range; }
+
+    private:
+        void OnPaint(wxPaintEvent& event);
+
+        int m_range;
+        int m_value;
+        int m_thresholdValue;
+};
+
 // Returns the same tinted "card" background colour used by TintedGroupBox,
 // for other controls (e.g. plot graticule label margins) that want to match.
 wxColour GroupBoxBackgroundColour();
