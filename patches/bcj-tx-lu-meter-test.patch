         auto resampleForPlotTapBeforeAGC = new TapStep(inputSampleRate_, resampleForPlotPipelineBeforeAGC);
         pipeline_->appendPipelineStep(resampleForPlotTapBeforeAGC);
 
+        // Loudness (LUFS) meter tap -- test-only, see LoudnessMeterStep.h.
+        // Deliberately reuses this same post-EQ/pre-AGC point (not the
+        // BeforeEQ/AfterAGC taps above) so the meter reflects any level
+        // change the equalizer introduces, since that's what AGC itself is
+        // about to see and react to.
+        auto loudnessMeterStep = new LoudnessMeterStep(inputSampleRate_);
+        auto loudnessMeterPipeline = new AudioPipeline(inputSampleRate_, inputSampleRate_);
+        loudnessMeterPipeline->appendPipelineStep(loudnessMeterStep);
+
+        auto loudnessMeterTap = new TapStep(inputSampleRate_, loudnessMeterPipeline);
+        pipeline_->appendPipelineStep(loudnessMeterTap);
+
         // AGC step (optional)
         auto eitherOrProcessAgc = new AudioPipeline(inputSampleRate_, inputSampleRate_);
         auto eitherOrBypassAgc = new AudioPipeline(inputSampleRate_, inputSampleRate_);
