+TxLuMeterGauge::TxLuMeterGauge(wxWindow* parent, int range, int thresholdValue)
+    : wxPanel(parent, wxID_ANY, wxDefaultPosition, wxDefaultSize, wxBORDER_NONE)
+    , m_range(range)
+    , m_value(0)
+    , m_thresholdValue(thresholdValue)
+{
+    SetBackgroundStyle(wxBG_STYLE_PAINT);
+    Bind(wxEVT_PAINT, &TxLuMeterGauge::OnPaint, this);
+}
+
+void TxLuMeterGauge::SetValue(int value)
+{
+    m_value = value;
+    Refresh();
+}
+
+void TxLuMeterGauge::OnPaint(wxPaintEvent&)
+{
+    wxAutoBufferedPaintDC dc(this);
+    wxSize sz = GetClientSize();
+
+    dc.SetPen(*wxTRANSPARENT_PEN);
+    dc.SetBrush(wxBrush(GroupBoxBackgroundColour()));
+    dc.DrawRectangle(0, 0, sz.x, sz.y);
+
+    if (m_range <= 0 || sz.x <= 0 || sz.y <= 0)
+    {
+        return;
+    }
+
+    // Trough
+    dc.SetBrush(wxBrush(wxColour(180, 180, 180)));
+    dc.DrawRectangle(0, 0, sz.x, sz.y);
+
+    int clampedValue = std::clamp(m_value, 0, m_range);
+    int normalPortion = std::min(clampedValue, m_thresholdValue);
+    int overPortion = clampedValue - normalPortion;
+
+    int normalWidth = (int)((float)normalPortion / m_range * sz.x);
+    int overWidth = (int)((float)overPortion / m_range * sz.x);
+
+    // Filled portion up to target: green.
+    if (normalWidth > 0)
+    {
+        dc.SetBrush(wxBrush(wxColour(70, 150, 70)));
+        dc.DrawRectangle(0, 0, normalWidth, sz.y);
+    }
+
+    // Filled portion beyond target: orange -- same colour as the numeric
+    // label's over-target text, so the two indicators agree.
+    if (overWidth > 0)
+    {
+        dc.SetBrush(wxBrush(wxColour(230, 90, 20)));
+        dc.DrawRectangle(normalWidth, 0, overWidth, sz.y);
+    }
+
+    dc.SetPen(wxPen(GetGroupBoxForegroundColour()));
+    dc.SetBrush(*wxTRANSPARENT_BRUSH);
+    dc.DrawRectangle(0, 0, sz.x, sz.y);
+}
