index 00000000..f6c905f2
--- /dev/null
+++ b/src/pipeline/LoudnessMeterStep.cpp
@@ -0,0 +1,72 @@
+//=========================================================================
+// Name:            LoudnessMeterStep.cpp
+// Purpose:         Measures EBU R128 momentary loudness of TX audio for
+//                  testing a loudness-based alternative to the peak Level
+//                  meter (see PR #1464 discussion).
+//
+// All rights reserved.
+//=========================================================================
+
+#include "LoudnessMeterStep.h"
+#include "ebur128.h" // from libebur128, same library AgcStep already uses
+
+#include <assert.h>
+
+std::atomic<float> g_txLoudnessLufs{-HUGE_VALF};
+
+namespace
+{
+    // Matches AgcStep's own silence gate so the meter and AGC agree on
+    // what counts as "no real signal yet".
+    constexpr float SILENCE_THRESHOLD_LUFS = -33.0;
+}
+
+LoudnessMeterStep::LoudnessMeterStep(int sampleRate)
+    : sampleRate_(sampleRate)
+{
+    ebur128State_ = ebur128_init(1, sampleRate_, EBUR128_MODE_M);
+    assert(ebur128State_ != nullptr);
+}
+
+LoudnessMeterStep::~LoudnessMeterStep()
+{
+    ebur128_destroy((ebur128_state**)&ebur128State_);
+}
+
+int LoudnessMeterStep::getInputSampleRate() const FREEDV_NONBLOCKING
+{
+    return sampleRate_;
+}
+
+int LoudnessMeterStep::getOutputSampleRate() const FREEDV_NONBLOCKING
+{
+    return sampleRate_;
+}
+
+short* LoudnessMeterStep::execute(short* inputSamples, int numInputSamples, int* numOutputSamples) FREEDV_NONBLOCKING
+{
+    ebur128_state* state = static_cast<ebur128_state*>(ebur128State_);
+
+    if (numInputSamples > 0 && inputSamples != nullptr)
+    {
+        double lufs = 0.0;
+
+        // Note: libebur128 is unlikely to use RT-unsafe constructs in normal
+        // operation (per AgcStep's existing RTSan-enabled tests, verified
+        // 2025-09-30). This step also always runs on TapStep's own
+        // background thread rather than the realtime audio thread, so
+        // there's no hard RT requirement here regardless.
+        FREEDV_BEGIN_VERIFIED_SAFE
+        ebur128_add_frames_short(state, inputSamples, numInputSamples);
+        auto result = ebur128_loudness_momentary(state, &lufs);
+        FREEDV_END_VERIFIED_SAFE
+
+        if (result == EBUR128_SUCCESS && lufs != -HUGE_VAL && lufs > SILENCE_THRESHOLD_LUFS)
+        {
+            g_txLoudnessLufs.store((float)lufs, std::memory_order_relaxed);
+        }
+    }
+
+    *numOutputSamples = numInputSamples;
+    return inputSamples;
+}
