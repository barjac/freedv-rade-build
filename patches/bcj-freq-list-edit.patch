+size_t ReportingConfiguration::SortedFrequencyIndex(std::vector<wxString> const& list, double freq)
+{
+    size_t index = 0;
+    for (; index < list.size(); index++)
+    {
+        double existing = 0;
+        wxNumberFormatter::FromString(list[index], &existing);
+        if (existing > freq)
+        {
+            break;
+        }
+    }
+    return index;
+}
