    fi
}

# Ubuntu 22.04 / Mint 21 use PulseAudio by default (PipeWire is installed,
# but only used for video there). NOT YET TESTED - needs a 22.04 tester.
offer_pipewire_switch() {
    if [[ -n $1 ]]; then
        say "Your sound server is: $1"
    else
        say "No sound server is running (neither PipeWire nor PulseAudio)."
    fi
    say "FreeDV setup here needs PipeWire (with its PulseAudio layer)${1:+ instead}."
    say ""
    case " $ID $ID_LIKE " in
        *" mageia "*)
            say "On Mageia, switch to PipeWire with draksound (Mageia Control Centre ->"
            say "Hardware -> Sound), reboot, then run freedv-rade-setup again."
            return ;;
        *" debian "*|*" ubuntu "*) ;;
        *)
            say "Please switch your system to PipeWire, reboot, then run freedv-rade-setup again."
            return ;;
    esac

    local p undo had_pms=0
    local -a pkgs=(pipewire-pulse wireplumber "$(alsa_plugin_pkg)") new=()
    for p in "${pkgs[@]}"; do
        pkg_installed "$p" || new+=("$p")
    done
    pkg_installed pipewire-media-session && had_pms=1

    # How to put PulseAudio back. pulseaudio is enabled for all users on
    # Ubuntu, so it's masked here (a user-level disable alone doesn't stick).
    undo="To put PulseAudio back, run these, then reboot:\n"
    # before the packages go, or systemctl can't find the units to disable
    undo+="  systemctl --user disable pipewire-pulse.socket wireplumber.service\n"
    # purge, not remove: removing masks these units for all users, and a
    # later reinstall leaves them masked
    ((${#new[@]})) && undo+="  sudo apt-get purge ${new[*]}\n"
    ((had_pms)) && undo+="  sudo apt-get install pipewire-media-session\n"
    undo+="  systemctl --user unmask pulseaudio.service pulseaudio.socket"

    say "This can be switched for you. It installs: ${new[*]:-(nothing new needed)}"
    say "and makes PipeWire handle the sound instead of PulseAudio."
    say "\n$undo\n"
    yesno "Switch this system to PipeWire now?" n || { say "Nothing changed."; return; }

    if ((${#new[@]})); then
        apt_quiet "Installing PipeWire's sound packages" "install ${new[*]}" \
            || { say "Package install failed - nothing else changed."; return; }
    fi
    if pkg_installed pipewire-media-session; then
        apt_quiet "Removing pipewire-media-session (WirePlumber replaces it)" "remove pipewire-media-session"
    fi
    # 'apt-get remove' of these packages masks their units for all users,
    # and reinstalling doesn't undo that
    local u masked=()
    for u in pipewire-pulse.socket pipewire-pulse.service wireplumber.service; do
        [[ $(readlink "/etc/systemd/user/$u") == /dev/null ]] && masked+=("$u")
    done
    if ((${#masked[@]})); then
        root_quiet "Unblocking PipeWire's sound services (left blocked by an earlier removal)" \
            "systemctl --global unmask ${masked[*]}" || die "Couldn't unblock ${masked[*]} - nothing else changed."
    fi
    if [[ -z $TEST_ROOT ]]; then
        if ! run_quiet "Switching the sound server to PipeWire" switch_to_pipewire; then
            say "\nThe switch didn't work, so PulseAudio has been put back as it was."
            if ((${#new[@]})); then
                say "The PipeWire packages it installed are still there; to remove them:"
                say "  sudo apt-get purge ${new[*]}"
            fi
            die "Switching to PipeWire failed."
        fi
    else
        say "(test mode: not switching the sound services)"
    fi

    mkdir -p "$SETUP_ROOT"
    printf '%b\n' "Written by freedv-rade-setup on $(date +%F) when it switched this system\nfrom PulseAudio to PipeWire.\n\n$undo" > "$SETUP_ROOT/undo-pipewire-switch.txt"
    say "(These undo commands are saved in $SETUP_ROOT/undo-pipewire-switch.txt)"
    say "\nDone. Please REBOOT, then run $0 again."
}

# pkg_installed PKG -> true only if fully installed. 'dpkg -s' is also true
# for a removed package whose config files are left (state "rc").
pkg_installed() {
    [[ $(dpkg-query -W -f='${Status}' "$1" 2>/dev/null) == "install ok installed" ]]
}

switch_to_pipewire() {
    systemctl --user --now disable pulseaudio.service pulseaudio.socket
    systemctl --user mask pulseaudio.service pulseaudio.socket || { pulseaudio_back; return 1; }
    # this user's own masks on PipeWire's units (the --global ones are cleared
    # before this); harmless when there are none
    systemctl --user unmask pipewire.socket pipewire.service pipewire-pulse.socket \
        pipewire-pulse.service wireplumber.service
    if ! systemctl --user --now enable pipewire.socket pipewire-pulse.socket wireplumber.service; then
        pulseaudio_back
        return 1
    fi
    systemctl --user --no-pager status pipewire-pulse.socket wireplumber.service
    return 0
}

# Undo a half-done switch, so the user isn't left with no sound server
pulseaudio_back() {
    echo "Switch failed - putting PulseAudio back"
    systemctl --user disable --now pipewire-pulse.socket wireplumber.service 2>/dev/null
    systemctl --user unmask pulseaudio.service pulseaudio.socket
    systemctl --user start pulseaudio.socket pulseaudio.service
}

##################### device detection #####################

# detect_plugin WHAT -> NEW_CARD and NEW_SERIAL (NEW_SERIAL may be empty)
# Same idea as sdcbr: unplug, snapshot, plug in, look for what's new.
# detect_serial -> NEW_SERIAL: the serial (CAT) port that appears when the
# radio's CAT cable is plugged in, as detect_plugin does for sound cards
detect_serial() {
    local before after key
    local -a new
    NEW_SERIAL=""
    while true; do
        say ""
        say "Make sure the radio's CAT (USB serial) cable is UNPLUGGED from the computer."
        yesno "Is it unplugged now?" y || return 1
        before=$(list_serial)
        say "\nNow PLUG IN the CAT cable. (Press ESC to go back)"
        echo -n "Waiting." >&3
        while true; do
            key=""
            read -r -s -n1 -t1 key
            [[ $key == $'\e' ]] && { screen ""; log "(ESC - back to the previous question)"; return 1; }
            after=$(list_serial)
            [[ $after != "$before" ]] && break
            echo -n "." >&3
        done
        screen " found."
        sleep 1
        after=$(list_serial)
        mapfile -t new < <(comm -13 <(echo "$before") <(echo "$after") | sed '/^$/d')
        ((${#new[@]})) && break
        say "No new serial port was found (something may have been unplugged instead). Let's try again."
    done
    if ((${#new[@]} == 1)); then
        NEW_SERIAL="/dev/serial/by-id/${new[0]}"
    else
        say "More than one new serial port appeared:"
        choose "Which one is the CAT (rig control) port?" 1 "${new[@]}"
        NEW_SERIAL="/dev/serial/by-id/${new[CHOICE-1]}"
    fi
    say "Found serial port: $NEW_SERIAL"
}

# fix_setconf OPTIONS -> hamlib --set-conf options with the usual values in
# hamlib's own spelling (they're case-sensitive: serial_handshake=none fails)
fix_setconf() {
    local -a out=()
    local o k v c
    local IFS=,
    for o in $1; do
        k=${o%%=*} v=${o#*=}
        k=${k// /} v=${v## }
        case $k in
            serial_handshake) for c in None XONXOFF Hardware; do [[ ${v,,} == "${c,,}" ]] && v=$c; done ;;
            serial_parity)    for c in None Even Odd Mark Space; do [[ ${v,,} == "${c,,}" ]] && v=$c; done ;;
            rts_state|dtr_state) for c in Unset ON OFF; do [[ ${v,,} == "${c,,}" ]] && v=$c; done ;;
        esac
        [[ $o == *=* ]] && out+=("$k=$v") || out+=("$o")
    done
    echo "${out[*]}"
}

detect_plugin() {
    local what=$1 before_c before_s after_c after_s key
    local -a new_cards new_serial
    NEW_CARD=""
    NEW_SERIAL=""
    while true; do
        say ""
        say "Make sure $what is UNPLUGGED from the computer."
        yesno "Is it unplugged now?" y || return 1
        before_c=$(list_cards)
        before_s=$(list_serial)
        say "\nNow PLUG IN $what, into the USB socket it will ALWAYS stay in."
        say "Its new name belongs to that socket. (Press ESC to go back)"
        echo -n "Waiting." >&3
        while true; do
            key=""
            read -r -s -n1 -t1 key
            [[ $key == $'\e' ]] && { screen ""; log "(ESC - back to the previous question)"; return 1; }
            after_c=$(list_cards)
            [[ $after_c != "$before_c" ]] && break
            echo -n "." >&3
        done
        screen " found."
        # A serial (CAT) port on the same cable can take a moment longer
        screen "Checking for a CAT (serial) port on the same cable..."
        sleep 3
        after_c=$(list_cards)
        after_s=$(list_serial)
        mapfile -t new_cards < <(comm -13 <(echo "$before_c") <(echo "$after_c") | sed '/^$/d')
        mapfile -t new_serial < <(comm -13 <(echo "$before_s") <(echo "$after_s") | sed '/^$/d')
        ((${#new_cards[@]})) && break
        say "No new sound card was found (something may have been unplugged instead). Let's try again."
    done

    if ((${#new_cards[@]} == 1)); then
        NEW_CARD=${new_cards[0]}
    else
        local -a items=()
        local c
        for c in "${new_cards[@]}"; do items+=("$(card_label "$c")"); done
        say "More than one new sound card appeared:"
        choose "Which one is it?" 1 "${items[@]}"
        NEW_CARD=${new_cards[CHOICE-1]}
    fi
    say "Found sound card: $(card_label "$NEW_CARD")"

    if ((${#new_serial[@]} == 1)); then
        NEW_SERIAL="/dev/serial/by-id/${new_serial[0]}"
    elif ((${#new_serial[@]} > 1)); then
        local -a items=()
        local s
        for s in "${new_serial[@]}"; do items+=("$s"); done
        say "More than one new serial port appeared:"
        choose "Which one is the CAT (rig control) port?" 1 "${items[@]}"
        NEW_SERIAL="/dev/serial/by-id/${new_serial[CHOICE-1]}"
    fi
    [[ -n $NEW_SERIAL ]] && say "Found serial port: $NEW_SERIAL"
    return 0
}

# pick_card PROMPT -> PICKED_CARD
pick_card() {
    local -a cards items=()
    local c
    mapfile -t cards < <(list_cards)
    ((${#cards[@]})) || { warn "No sound cards found."; return 1; }
    for c in "${cards[@]}"; do items+=("$(card_label "$c")"); done
    choose "$1" 1 "${items[@]}"
    PICKED_CARD=${cards[CHOICE-1]}
}

# name_card ROLE CARD -> sets ROLE_IN and ROLE_OUT node names
# ROLE is "radio" or "headset". USB cards get fixed names from a WirePlumber
# rule matched by USB port (see socket_rule), unless something else already
# names that port.
name_card() {
    local role=$1 card=$2 bp bus stem old_stem="" other id desc pref_in="" pref_out="" f n users
    # PipeWire's device.bus-path; pactl shows it as device.bus_path
    bp=$(card_prop "$card" device.bus-path)
    [[ -z $bp ]] && bp=$(card_prop "$card" device.bus_path)
    bus=$(card_prop "$card" device.bus)
    stem=${card#alsa_card.}

    if [[ $bus == usb && -n $bp ]] && f=$(socket_rule "$bp"); then
        id=$(rule_id "$f")
        read -r pref_in pref_out <<<"$(rule_nodes "$f")"
        if [[ $id != "$role" && ! $id =~ ^$role[0-9]+$ && ! ( $role == radio && $id == radio-* ) ]]; then
            if ! offer_swap "$role" "$f" "$bp"; then
                if [[ $id == radio* ]]; then say "This card is already set up as a radio sound card."
                else say "This card is already set up as a headset."; fi
                # the headset steps carry on with the card's current names
                ROLE_IN=$(resolve_node "$pref_in" "$stem" input)
                ROLE_OUT=$(resolve_node "$pref_out" "$stem" output)
                return 2
            fi
            # this card now has ROLE's names
            f=$SWAPPED_RULE
            id=$(rule_id "$f")
            read -r pref_in pref_out <<<"$(rule_nodes "$f")"
            stem=$(rule_stem "$f")
        fi
        # This socket already has a name: use it (shared with other radios)
        say "This card already has fixed names: $pref_in, $pref_out"
        users=$(node_users "$pref_in" "$pref_out")
        if [[ -n $users ]]; then
            [[ $role == radio ]] && say "Radio $users uses it too (you move the audio cables between the radios)." \
                                 || say "Radio $users uses it too."
        fi
    elif [[ $bus != usb || -z $bp ]]; then
        pref_in=""; pref_out=""
    elif other=$(existing_rule_for "$bp") && [[ -n $other ]] \
         && ! set_aside_rules "$role" "$card" "$other"; then
        say "Keeping that name."
        pref_in=""; pref_out=""
    else
        id=$(free_rule_id "$role")
        n=${id#"$role"}
        if [[ $role == radio ]]; then
            desc="Radio${n:+ $n}"; pref_in="$id-rx"; pref_out="$id-tx"
        else
            desc="Headset${n:+ $n}"; pref_in="$id-mic"; pref_out="$id-phones"
        fi
        old_stem=$stem
        stem="frs-$id"
        write_wp_rule "$id" "$bp" "$stem" "$desc" "$pref_in" "$pref_out"
        say "IMPORTANT: always plug this card into the SAME USB socket. If you move it,"
        say "run freedv-rade-setup again and redo this step.\n"
        if [[ $card != "alsa_card.$stem" ]]; then
            restart_wireplumber
            wait_node "$pref_in" 10 || wait_node "$pref_out" 5
        fi
    fi

    # The card's name changes when WirePlumber restarts with a new or swapped
    # rule: find it again by its socket, for card_ident
    NAMED_CARD=$card
    if [[ -n $bp ]]; then
        local now
        now=$(socket_card "$bp")
        [[ -n $now ]] && NAMED_CARD=$now
    fi

    ROLE_IN=$(resolve_node "$pref_in" "$stem" input)
    ROLE_OUT=$(resolve_node "$pref_out" "$stem" output)
    # If the new rule isn't active (yet), use the card's current node names
    if [[ -n $old_stem ]]; then
        [[ -n $ROLE_IN ]]  || ROLE_IN=$(resolve_node "" "$old_stem" input)
        [[ -n $ROLE_OUT ]] || ROLE_OUT=$(resolve_node "" "$old_stem" output)
        [[ -z $TEST_ROOT && $ROLE_IN != "$pref_in" ]] \
            && warn "The new name was not applied - using the card's current names for now."
    fi
    [[ -n $ROLE_IN ]]  && say "  Input (capture):   $ROLE_IN"  || warn "No input found on this card."
    [[ -n $ROLE_OUT ]] && say "  Output (playback): $ROLE_OUT" || warn "No output found on this card."
    if [[ -z $ROLE_IN || -z $ROLE_OUT ]]; then
        say "  If the card's profile is 'Off' or output-only, set it to an analog duplex"
        say "  profile (e.g. with pavucontrol), then re-run this step."
    fi
}

# Lists for choosing nodes: "name<TAB>description"
# list_sinks_desc / list_sources_desc -> NAME<tab>DESCRIPTION<tab>CARD'S OWN NAME
list_nodes_desc() {
    LC_ALL=C pactl list "$1" 2>/dev/null | awk '
        function out() { if (n != "" && n !~ /\.monitor$/) print n "\t" d "\t" h }
        /^[^\t]/ { out(); n = d = h = "" }
        /^\tName: / { n = $2 }
        /^\tDescription: / { d = $0; sub(/^\tDescription: /, "", d) }
        /^\t\talsa\.long_card_name = / { h = $0; sub(/^[^"]*"/, "", h); sub(/"$/, "", h); sub(/ at .*/, "", h) }
        END { out() }'
}
list_sinks_desc()   { list_nodes_desc sinks; }
list_sources_desc() { list_nodes_desc sources; }

# pick_node PROMPT sinks|sources|apps-out|apps-in [none] -> PICKED_NODE ("" for none)
pick_node() {
    local prompt=$1 kind=$2 allow_none=$3 prefer_usb=$4 line def=1
    local -a names items=()
    case $kind in
        sinks)    mapfile -t lines < <(list_sinks_desc) ;;
        sources)  mapfile -t lines < <(list_sources_desc) ;;
        apps-out) mapfile -t lines < <(pw-link -o 2>/dev/null | cut -d: -f1 | sort -u | sed 's/$/\t/') ;;
        apps-in)  mapfile -t lines < <(pw-link -i 2>/dev/null | cut -d: -f1 | sort -u | sed 's/$/\t/') ;;
    esac
    for line in "${lines[@]}"; do
        local n=${line%%$'\t'*} d=${line#*$'\t'} h=""
        [[ $d == *$'\t'* ]] && { h=${d#*$'\t'}; d=${d%%$'\t'*}; }
        [[ -n $h && $h != "$d" ]] && d+="${d:+ - }$h"
        [[ " ${FDV_SINKS[*]} " == *" $n "* || $n == Fdv-bpf* ]] && continue
        # the radio's own sound card is never the headset or speakers
        if [[ $kind == sinks || $kind == sources ]]; then
            [[ -n $RADIO_RX_NODE && $n == "$RADIO_RX_NODE" ]] && continue
            [[ -n $RADIO_TX_NODE && $n == "$RADIO_TX_NODE" ]] && continue
            # and anything the caller has already taken (e.g. the headphones,
            # when asking for speakers)
            [[ -n ${PICK_SKIP:-} && $n == "$PICK_SKIP" ]] && continue
        fi
        names+=("$n")
        items+=("${d:+$d  }($n)")
        # offer the first USB device as the default when asked to
        [[ -n $prefer_usb && $def == 1 && ( $n == alsa_*.usb-* || $n == headset-* ) ]] \
            && def=${#names[@]}
    done
    if [[ -n $allow_none ]]; then
        names+=("")
        items+=("None")
    fi
    ((${#names[@]})) || { warn "Nothing to choose from."; PICKED_NODE=""; return 1; }
    choose "$prompt" "$def" "${items[@]}"
    PICKED_NODE=${names[CHOICE-1]}
}

##################### setup steps #####################

radio_audio_step() {
    heading "Radio sound card"
    RADIO_SERIAL=""
    # ESC (or "not unplugged") while detecting comes back to this question
    while true; do
    say "How is the radio's audio connected to this computer?"
    say "  (D)etect a USB sound card, or a radio with built-in USB sound, by plugging it in (recommended)"
    say "  (C)hoose from the sound cards that are already connected"
    say "  (S)oftware radio program on this computer (quisk, piHPSDR ...)"
    ((NEW_RADIO)) && say "  (B)ack - stop setting up this radio" \
                  || say "  (B)ack - keep the radio's sound card as it is"
    confirm "Detect, Choose, Software or Back?" "[D/c/s/b]" "Dd" "Cc" "Ss" "Bb"
    CHOICE=$(($? + 1))
    case $CHOICE in
        4)
            return 1 ;;
        1)
            detect_plugin "the radio's USB cable (or its USB sound interface)" || continue
            RADIO_KIND=usb; RADIO_CARD=$NEW_CARD; RADIO_SERIAL=$NEW_SERIAL ;;
        2)
            pick_card "Which card is connected to the radio?" || return 1
            RADIO_KIND=card; RADIO_CARD=$PICKED_CARD ;;
        3)
            # NOT YET TESTED - needs a quisk/piHPSDR user
            RADIO_KIND=software; RADIO_CARD=""; RADIO_CARD_ID=""
            say "Start the radio program now, with its audio running."
            pause "Press Enter when it is running... "
            pick_node "Which node carries the RECEIVED audio from the radio program?" apps-out || return 1
            RADIO_RX_NODE=$PICKED_NODE
            pick_node "Which node should the TRANSMIT audio go to?" apps-in || return 1
            RADIO_TX_NODE=$PICKED_NODE
            return 0 ;;
    esac
    name_card radio "$RADIO_CARD"
    if (( $? == 2 )); then
        say "Choose another card, or go (B)ack.\n"
        continue
    fi
    break
    done
    RADIO_RX_NODE=$ROLE_IN
    RADIO_TX_NODE=$ROLE_OUT
    RADIO_CARD=$NAMED_CARD
    RADIO_CARD_ID=$(card_ident "$RADIO_CARD")
    set_radio_volume
}

# A radio's sound card comes up at whatever volume it had (e.g. 74%, too quiet
# for a TS-450S). When setting up a NEW radio, start its output at 100%; the
# transmit level is then set with FreeDV's TX attenuation. Redoing the card
# later leaves the user's volume alone.
set_radio_volume() {
    ((NEW_RADIO)) && [[ -n $RADIO_TX_NODE && -z $TEST_ROOT ]] || return
    if timeout 5 pactl set-sink-volume "$RADIO_TX_NODE" 100% 2>/dev/null \
       && timeout 5 pactl set-sink-mute "$RADIO_TX_NODE" 0 2>/dev/null; then
        say "The radio's sound output is set to 100%."
    else
        log "Couldn't set the volume of $RADIO_TX_NODE"
    fi
}

# A USB headset picked from the list gets the same fixed names as a
# detected one: headset-mic, headset-phones (headset2-... in another socket)
# node_card NODE -> the sound card a source or sink belongs to
node_card() {
    { LC_ALL=C pactl list sources; LC_ALL=C pactl list sinks; } 2>/dev/null | awk -v node="$1" '
        /^[^\t]/ { f = 0 }
        /^\tName: / { f = ($2 == node) }
        f && $1 == "device.name" { sub(/^[^"]*"/, ""); sub(/"$/, ""); print; exit }'
}
name_chosen_headset() {
    local stem card
    card=$(node_card "$MIC_NODE")
    [[ -n $card ]] && list_cards | grep -qxF -- "$card" || return
    [[ $(card_prop "$card" device.bus) == usb ]] || return
    # already has fixed names: just note which card it is, for the start
    # script's check that the cards are in their own sockets
    if [[ $MIC_NODE != alsa_input.* ]]; then
        MIC_CARD_ID=$(card_ident "$card")
        return
    fi
    stem=${card#alsa_card.}
    local phones_same=0
    [[ $PHONES_NODE == "alsa_output.$stem."* ]] && phones_same=1
    say "Giving this USB headset fixed names:"
    name_card headset "$card"
    MIC_NODE=$ROLE_IN
    MIC_CARD_ID=$(card_ident "$NAMED_CARD")
    ((phones_same)) && PHONES_NODE=$ROLE_OUT
}

headset_step() {
    heading "Microphone, headphones and speakers"
    MIC_NODE_WAS=$MIC_NODE   # for offer_swap
    MIC_NODE=""; MIC_CARD_ID=""; PHONES_NODE=""; SPEAKER_NODE=""
    # ESC (or "not unplugged") while detecting comes back to this question
    while true; do
    say "Which microphone will you use for transmitting?"
    say "  (D)etect a USB headset by plugging it in (recommended)"
    say "  (C)hoose from the sound cards that are already connected"
    say "  (N)o microphone (receive only)"
    confirm "Detect, Choose or No microphone?" "[D/c/n]" "Dd" "Cc" "Nn"
    CHOICE=$(($? + 1))
    case $CHOICE in
        1)
            detect_plugin "your USB headset" || continue
            name_card headset "$NEW_CARD"
            MIC_NODE=$ROLE_IN
            MIC_CARD_ID=$(card_ident "$NAMED_CARD")
            PHONES_NODE=$ROLE_OUT ;;
        2)
            pick_node "Which microphone?" sources "" usb || true
            MIC_NODE=$PICKED_NODE
            pick_node "Which headphones (if any)?" sinks none usb || true
            PHONES_NODE=$PICKED_NODE
            name_chosen_headset ;;
    esac
    break
    done

    ((GAP)) || say ""
    say "Received audio can also play on speakers (handy when you take the headset off)."
    PICK_SKIP=$PHONES_NODE pick_node "Which speakers?" sinks none || true
    SPEAKER_NODE=$PICKED_NODE
    [[ -n $PHONES_NODE && $SPEAKER_NODE == "$PHONES_NODE" ]] && SPEAKER_NODE=""

    MONITOR=none
    if [[ -n $PHONES_NODE && -n $SPEAKER_NODE ]]; then
        say "Where should received audio play?"
        say "  (B)oth headphones and speakers - turn the speaker volume up or down as needed (recommended)"
        say "  (H)eadphones only"
        say "  (S)peakers only"
        confirm "Both, Headphones or Speakers?" "[B/h/s]" "Bb" "Hh" "Ss"
        CHOICE=$(($? + 1))
        MONITOR=$(echo both headphones speakers | cut -d' ' -f"$CHOICE")
    elif [[ -n $PHONES_NODE ]]; then
        MONITOR=headphones
    elif [[ -n $SPEAKER_NODE ]]; then
        MONITOR=speakers
    else
        warn "No headphones or speakers chosen - you won't hear received audio."
    fi
    pi_jack_rule
}

# sink_prop SINK PROP -> a property of a sink (e.g. alsa.card_name)
sink_prop() {
    LC_ALL=C pactl list sinks 2>/dev/null | awk -v sink="$1" -v prop="$2" '
        /^[^\t]/ { f = 0 }
        /^\tName: / { f = ($2 == sink) }
        f && $1 == prop && $2 == "=" { sub(/^[^=]*= *"/, ""); sub(/"$/, ""); print; exit }'
}

# pi_jack_rule -> when a Raspberry Pi's own headphone jack (bcm2835) is the
# headphones or speakers, give it more headroom. Its driver reports the buffer
# level in large uneven steps, so following the USB cards' clock it kept
# leaving PipeWire's window: ~15 resyncs a minute (an occasional tick) and
# errors. headroom 1024 stopped them (Pi 4), for ~20ms more delay there.
pi_jack_rule() {
    local n jack="" f lua body
    for n in "$SPEAKER_NODE" "$PHONES_NODE"; do
        [[ -n $n && $(sink_prop "$n" alsa.card_name) == "bcm2835 Headphones" ]] && { jack=$n; break; }
    done
    [[ -n $jack ]] || return 0
    if ((WP_LUA)); then
        f="$WP_LUA_DIR/61-freedv-rade-pi-jack.lua"
        body="-- Written by freedv-rade-setup: the Raspberry Pi's headphone jack plays without
-- resyncs (ticks) with more headroom. Delete this file to undo.
table.insert(alsa_monitor.rules, {
  matches = { { { \"node.name\", \"equals\", \"$jack\" } } },
  apply_properties = { [\"api.alsa.headroom\"] = 1024 },
})"
    else
        f="$WP_CONF_DIR/61-freedv-rade-pi-jack.conf"
        body="# Written by freedv-rade-setup: the Raspberry Pi's headphone jack plays without
# resyncs (ticks) with more headroom. Delete this file to undo.
monitor.alsa.rules = [
  {
    matches = [ { node.name = \"$jack\" } ]
    actions = { update-props = { api.alsa.headroom = 1024 } }
  }
]"
    fi
    [[ -f $f && $(<"$f") == "$body" ]] && return 0
    mkdir -p "${f%/*}"
    printf '%s\n' "$body" > "$f"
    log "Wrote $f"
    say "The Raspberry Pi's own headphone jack is set to play smoothly (more buffering,"
    say "about 20ms more delay there)."
    [[ $MONITOR == both && $jack == "$SPEAKER_NODE" ]] \
        && say "With both playing, the speakers will be about 20ms behind the headphones."
    restart_wireplumber
}

# rig_test HOST|PORT MODEL [SETCONF] -> 0 if the radio answered
rig_test() {
    local port=$1 model=$2 setconf=$3 out
    say "Asking the radio for its frequency..."
    out=$(timeout 15 "$RIGCTL_BIN" -m "$model" -r "$port" ${setconf:+--set-conf="$setconf"} f 2>&1)
    if [[ $? -eq 0 && $out =~ ^[0-9]+$ ]]; then
        say "  The radio answered: $out Hz"
        return 0
    fi
    say "  No answer. rigctl said:\n${out:-  (nothing)}"
    return 1
}

rig_step() {
    heading "Rig control (CAT and PTT)"
    RIG_MODE=none; RIG_MODEL=""; RIG_MODEL_NAME=""; RIG_PORT=""; RIG_SETCONF=""
    RIG_LISTEN=127.0.0.1; RIG_HOST=localhost:4532

    if [[ -z $RIGCTL_BIN ]]; then
        warn "hamlib rigctl is not installed, so rig control can't be set up."
        say "FreeDV can still be used with VOX or the radio's own PTT."
        return
    fi

    # 1. rigctld on another computer
    if yesno "Is rigctld already running on ANOTHER computer on your network?" n; then
        ask "Its address (host or host:port)" ""
        local host=$REPLY
        [[ $host == *:* ]] || host="$host:4532"
        rig_test "$host" 2 || yesno "Use it anyway?" n || return
        RIG_MODE=remote; RIG_HOST=$host
        return
    fi

    # 2. rigctld already running here (e.g. started at boot)
    local running tport
    running=$(ps -o args= -C rigctld 2>/dev/null | head -1)
    if [[ -n $running ]]; then
        say "rigctld is already running on this computer:\n  $running"
        tport=$(sed -n 's/.*-t *\([0-9]\+\).*/\1/p; s/.*--port[= ]\([0-9]\+\).*/\1/p' <<<"$running" | head -1)
        tport=${tport:-4532}
        if yesno "Use this rigctld for FreeDV?" y; then
            rig_test "localhost:$tport" 2 || yesno "Use it anyway?" y || return
            RIG_MODE=existing; RIG_HOST="localhost:$tport"
            return
        fi
        say "Only one program can use the radio's serial port, so stop that rigctld"
        say "first, then run this step again."
        return
    fi

    if [[ -z $RIGCTLD_BIN ]]; then
        warn "rigctld is not installed, so it can't be set up here."
        return
    fi

    say "FreeDV can control your radio (frequency and PTT) through hamlib's rigctld."
    say "Answer No if you use VOX or the radio's own PTT."
    yesno "Set up rigctld for your radio?" y || return

    # Model
    local word
    local -a matches
    while true; do
        ask "Type part of your radio's model name (e.g. 7300, FT-991, TS-590)" ""
        word=$REPLY
        [[ -n $word ]] || continue
        mapfile -t matches < <("$RIGCTL_BIN" -l 2>/dev/null | awk 'NR > 1' | grep -i -- "$word" | tr -s ' ' | sed 's/^ //')
        if ((${#matches[@]} == 0)); then
            say "No radio matches '$word'. Try a shorter part of the name."
        elif ((${#matches[@]} > 30)); then
            say "${#matches[@]} radios match '$word'. Please type more of the name."
        else
            break
        fi
    done
    local -a items=()
    local m
    for m in "${matches[@]}"; do
        items+=("$(awk '{ printf "%-6s", $1; for (i = 2; i <= NF - 3; i++) printf " %s", $i }' <<<"$m")")
    done
    choose "Which is your radio?" 1 "${items[@]}"
    RIG_MODEL=$(awk '{print $1}' <<<"${matches[CHOICE-1]}")
    RIG_MODEL_NAME=$(sed 's/^ *[0-9]* *//' <<<"${items[CHOICE-1]}")

    # Port
    if [[ -n $RADIO_SERIAL ]]; then
        say "The serial port found with the radio's USB cable is:\n  $RADIO_SERIAL"
    fi
    local -a ports
    if [[ -n $RADIO_SERIAL ]] && yesno "Use it for rig control?" y; then
        RIG_PORT=$RADIO_SERIAL
    else
        # like the sound cards: detect the CAT cable by plugging it in, or
        # pick one already connected, or type one
        RIG_PORT=""
        while [[ -z $RIG_PORT ]]; do
            mapfile -t ports < <(ls -1 /dev/serial/by-id/* 2>/dev/null)
            ((${#ports[@]})) || say "No USB serial (CAT) port is connected at the moment."
            choose "Which serial port is the radio's CAT port?" 1 \
                "Detect the radio's CAT cable by plugging it in (recommended)" "${ports[@]}" "Type a port"
            if ((CHOICE == 1)); then
                detect_serial && RIG_PORT=$NEW_SERIAL
            elif ((CHOICE <= ${#ports[@]} + 1)); then
                RIG_PORT=${ports[CHOICE-2]}
            else
                ask "Port (e.g. /dev/ttyUSB0)" "/dev/ttyUSB0"
                RIG_PORT=$REPLY
            fi
        done
    fi

    say "\nMost radios need nothing more. Some older ones need extra hamlib options,"
    say "for example the TS-450S needs:  serial_handshake=None"
    ask "Extra --set-conf options (press Enter for none)" ""
    RIG_SETCONF=$(fix_setconf "$REPLY")
    [[ $RIG_SETCONF != "$REPLY" ]] && say "  (written as hamlib wants it: $RIG_SETCONF)"

    say ""
    say "Make sure the radio is switched ON."
    pause "Press Enter to test the connection... "
    until rig_test "$RIG_PORT" "$RIG_MODEL" "$RIG_SETCONF"; do
        confirm "(T)ry again, (K)eep these settings anyway, or (N)o rig control?" "[T/k/n]" "Tt" "Kk" "Nn"
        CHOICE=$(($? + 1))
        case $CHOICE in
            2) break ;;
            3) RIG_MODE=none; return ;;
        esac
    done

    say "When should rigctld run?"
    say "  (W)hile FreeDV is running only (recommended)"
    say "  (A)ll the time, started when the computer boots (for logging programs etc.)"
    confirm "While FreeDV runs, or All the time?" "[W/a]" "Ww" "Aa"
    CHOICE=$(($? + 1))
    ((CHOICE == 1)) && RIG_MODE=ondemand || RIG_MODE=boot

    if yesno "Allow other computers on your network to use this rigctld?" n; then
        RIG_LISTEN=0.0.0.0
        say "Note: if a firewall is active, TCP port 4532 must be opened for this."
    fi
    RIG_HOST=localhost:4532

    [[ $RIG_MODE == boot ]] && install_rig_service
}

install_rig_service() {
    local unit tmp
    unit=/etc/systemd/system/freedv-rigctld.service
    tmp=$(mktemp)
    cat > "$tmp" <<EOF
# Written by freedv-rade-setup for radio "$RADIO_LABEL"
[Unit]
Description=hamlib rigctld for FreeDV ($RADIO_LABEL)
After=network.target

[Service]
User=$user
ExecStart=$RIGCTLD_BIN -m $RIG_MODEL -r $RIG_PORT -T $RIG_LISTEN -t 4532${RIG_SETCONF:+ --set-conf=$RIG_SETCONF}
# Keep retrying, e.g. if the radio is switched on after the computer
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
    say ""
    if root_quiet "Installing the rigctld service ($unit)" "install -m 644 '$tmp' '$unit' && systemctl daemon-reload && systemctl enable --now freedv-rigctld.service"; then
        say "rigctld will now start at boot."
    else
        warn "Could not install the service - using 'only while FreeDV is running' instead."
        RIG_MODE=ondemand
    fi
    rm -f "$tmp"
}

bpf_step() {
    heading "Transmit band-pass filter"
    say "The band-pass filter cleans up FreeDV's transmit audio before it goes to the radio."
    say "The start script picks the right one for the FreeDV build it starts:"
    say "the wide filter (675-2275 Hz) for RADE V1, the 1k filter (981-1956 Hz) for RADE V2."
    BPF_BIN=""
    if ! yesno "Use the band-pass filter?" y; then
        BPF=none
        return
    fi
    BPF=on
    build_bpf wide && build_bpf 1k \
        || { warn "The filter could not be built - continuing without it."; BPF=none; BPF_BIN=""; return; }
    BPF_BIN="$LOCAL_BIN/Fdv-bpf"
    if freedv_is_v2 "$FREEDV_DIR/freedv-gui/build_linux/src/freedv"; then
        say "The current FreeDV build is RADE V2, so the 1k filter will be used."
    else
        say "The current FreeDV build is RADE V1, so the wide filter will be used."
    fi
}

# PipeWire's ALSA plugin is set up (it defines the "pipewire" ALSA device
# that the filter opens; 50-pipewire.conf on both Mageia and Ubuntu)
pipewire_alsa_ok() {
    local f
    for f in /etc/alsa/conf.d/*pipewire* /usr/share/alsa/alsa.conf.d/*pipewire*; do
        [[ -e $f ]] && return 0
    done
    return 1
}

# build_bpf wide|1k -> BPF_BIN
build_bpf() {
    local src="$SCRIPT_DIR/bpf/bpf.c" bin
    local -a flags=()
    [[ -f $src ]] || { warn "$src is missing."; return 1; }
    command -v gcc &>/dev/null || { warn "gcc is not installed."; return 1; }
    [[ -f /usr/include/alsa/asoundlib.h ]] || { warn "The ALSA development headers are not installed."; return 1; }
    if ! pipewire_alsa_ok; then
        local apkg
        apkg=$(alsa_plugin_pkg)
        say "The filter needs the $apkg package (it connects ALSA programs to PipeWire)."
        offer_install "$apkg" "needed by the band-pass filter" && pipewire_alsa_ok || return 1
    fi
    bin="$LOCAL_BIN/Fdv-bpf"
    if [[ $1 == 1k ]]; then
        bin="$LOCAL_BIN/Fdv-bpf-1k"
        flags=(-DCUTOFF_LOW=981.0 -DCUTOFF_HIGH=1956.0)
    fi
    if [[ ! -x $bin || $src -nt $bin ]]; then
        mkdir -p "$LOCAL_BIN"
        run_quiet "Building the filter ($bin)" gcc -O3 "${flags[@]}" -o "$bin" "$src" -lm -lasound || return 1
    fi
    ok "Band-pass filter: $bin"
    remove_old_bpf
}

# freedv_is_v2 FREEDV_PROGRAM -> true for a RADE V2 build (it has the RADEV2 mode)
freedv_is_v2() { grep -qa RADEV2 "$1" 2>/dev/null; }

# Draft versions named the filter programs freedv-bpf and freedv-bpf-1k.
# Remove them, unless another radio's start script still uses one, or one
# is running.
remove_old_bpf() {
    local old users
    for old in "$LOCAL_BIN/freedv-bpf" "$LOCAL_BIN/freedv-bpf-1k"; do
        [[ -e $old ]] || continue
        users=$(grep -lsx "BPF_BIN=$(printf '%q' "$old")" "$SETUP_ROOT"/*/start | grep -vxF "$RADIO_DIR/start")
        if [[ -n $users ]] || pgrep -x "${old##*/}" >/dev/null; then
            log "Keeping $old (still used: ${users:-running})"
            continue
        fi
        rm -f "$old" && log "Removed old filter program $old"
    done
}

##################### generated files #####################

# make_links "SRC PORTS" "DST PORTS" -> link lines (one "src dst" per line)
# Mono to stereo feeds both channels, stereo to mono uses the first channel
# only, stereo to stereo pairs the channels by name (FL->FL, FR->FR).
make_links() {
    local -a S D
    local s d i
    mapfile -t S < <(sed '/^$/d' <<<"$1")
    mapfile -t D < <(sed '/^$/d' <<<"$2")
    ((${#S[@]} && ${#D[@]})) || return 1
    if ((${#S[@]} == 1)); then
        for d in "${D[@]}"; do echo "${S[0]} $d"; done
    elif ((${#D[@]} == 1)); then
        echo "${S[0]} ${D[0]}"
    else
        local found=0
        for s in "${S[@]}"; do
            for d in "${D[@]}"; do
                [[ ${s##*_} == "${d##*_}" ]] && { echo "$s $d"; found=1; }
            done
        done
        if ((!found)); then
            for ((i=0; i < ${#S[@]} && i < ${#D[@]}; i++)); do echo "${S[i]} ${D[i]}"; done
        fi
    fi
}

sink_in()  { printf '%s:playback_FL\n%s:playback_FR\n' "$1" "$1"; }
sink_mon() { printf '%s:monitor_FL\n%s:monitor_FR\n' "$1" "$1"; }

write_links() {
    local f="$RADIO_DIR/links" tx_src
    {
        # From radio -> FreeDV
        [[ -n $RADIO_RX_NODE ]] && make_links "$(node_ports "$RADIO_RX_NODE" out)" "$(sink_in FDV_RX_in)"
        # Microphone -> FreeDV
        [[ -n $MIC_NODE ]] && make_links "$(node_ports "$MIC_NODE" out)" "$(sink_in FDV_TX_in)"
        # FreeDV -> (filter) -> radio
        if [[ -n $RADIO_TX_NODE ]]; then
            tx_src=$(sink_mon FDV_TX_out)
            if [[ $BPF != none && -n $BPF_BIN ]]; then
                # Fdv-bpf in the links means whichever filter the start
                # script runs (Fdv-bpf or Fdv-bpf-1k)
                make_links "$tx_src" "Fdv-bpf:input_MONO"
                tx_src="Fdv-bpf:output_MONO"
            fi
            make_links "$tx_src" "$(node_ports "$RADIO_TX_NODE" in)"
        fi
        # FreeDV -> headphones / speakers
        [[ $MONITOR == both || $MONITOR == headphones ]] && make_links "$(sink_mon FDV_RX_out)" "$(node_ports "$PHONES_NODE" in)"
        [[ $MONITOR == both || $MONITOR == speakers ]] && make_links "$(sink_mon FDV_RX_out)" "$(node_ports "$SPEAKER_NODE" in)"
    } > "$f.new"
    [[ -f $f ]] && cp "$f" "$f.bak"
    mv "$f.new" "$f"
    log "Wrote $f:"
    log "$(sed 's/^/  /' "$f")"
}

# set_ini FILE SECTION KEY VALUE (sets the key in every copy of the section)
set_ini() {
    local f=$1 s=$2 k=$3 v=$4 tmp
    tmp=$(mktemp)
    awk -v s="[$s]" -v k="$k" -v v="$v" '
        function flush() { if (insec && !setk) { print k "=" v; setk = 1 } }
        /^\[/ { flush(); insec = ($0 == s); if (insec) { found = 1; setk = 0 }; print; next }
        insec && index($0, k "=") == 1 { if (!setk) { print k "=" v; setk = 1 }; next }
        { print }
        END { flush(); if (!found) { print s; print k "=" v } }' "$f" > "$tmp" \
        && cat "$tmp" > "$f"
    rm -f "$tmp"
}

get_ini() {
    awk -v s="[$2]" -v k="$3" '
        /^\[/ { insec = ($0 == s); next }
        insec && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

# Callsign and locator are all FreeDV needs before reporting etc. can be set
# up from inside FreeDV, so ask for them if the config doesn't have them yet
ask_station() {
    local conf=$1 call loc
    call=$(get_ini "$conf" Reporting Callsign)
    loc=$(get_ini "$conf" Reporting GridSquare)
    [[ -n $call && -n $loc ]] && return
    say "\nFreeDV needs your callsign and locator before you can turn on"
    say "reporting (FreeDV Reporter, PSK Reporter) from inside FreeDV."
    say "Press Enter to leave one blank and set it later in FreeDV's Tools > Options."
    while true; do
    while true; do
        ask "Your callsign" "$call"
        call=$(tr 'a-z' 'A-Z' <<<"$REPLY" | tr -d ' ')
        [[ -z $call || $call =~ ^[A-Z0-9/]{3,}$ ]] && break
        say "That doesn't look like a callsign (letters, digits and / only)."
    done
    while true; do
        ask "Your locator, 6 characters (e.g. IO91wm)" "$loc"
        loc=$(tr -d ' ' <<<"$REPLY")
        [[ -z $loc ]] && break
        if [[ $loc =~ ^[A-Ra-r]{2}[0-9]{2}[A-Xa-x]{2}$ ]]; then
            loc="$(tr 'a-z' 'A-Z' <<<"${loc:0:4}")$(tr 'A-Z' 'a-z' <<<"${loc:4}")"
            break
        fi
        say "A locator is 6 characters: two letters A-R, two digits, two letters A-X (e.g. IO91wm)."
    done
    # show them as they'll be saved (case corrected) and check
    [[ -z $call && -z $loc ]] && break
    yesno "Callsign ${call:-(none)}, locator ${loc:-(none)} - is that right?" y && break
    done
    [[ -n $call ]] && set_ini "$conf" Reporting Callsign "$call"
    [[ -n $loc ]] && set_ini "$conf" Reporting GridSquare "$loc"
}

# kiwi_hooks_dir -> kiwiclient's freedv-hooks folder, when kiwipanadapter (a
# KiwiSDR panadapter that runs alongside FreeDV) is installed
kiwi_hooks_dir() {
    local d
    for d in "$HOME/GIT/kiwiclient" "$HOME/kiwiclient"; do
        [[ -x $d/kiwipanadapter.py && -x $d/freedv-hooks/before-freedv ]] && { echo "$d/freedv-hooks"; return; }
    done
}

# panadapter_step -> with kiwipanadapter installed, offer to start it with
# FreeDV for this radio: its hooks are linked into the radio's hooks folder
# (links, so a git pull in kiwiclient updates them)
panadapter_step() {
    local src h f on=0
    src=$(kiwi_hooks_dir)
    [[ -n $src ]] || return 0
    h="$RADIO_DIR/hooks"
    [[ -L $h/before-freedv ]] && on=1
    heading "KiwiSDR panadapter"
    say "kiwipanadapter is installed: a KiwiSDR waterfall and S-meter that follows"
    say "the radio's frequency, started and closed together with FreeDV."
    ((on)) && say "(It starts with FreeDV for this radio now.)"
    if yesno "Start it together with FreeDV for this radio?" y; then
        mkdir -p "$h"
        for f in before-freedv after-freedv env; do
            [[ -e $src/$f ]] && ln -sfn "$src/$f" "$h/$f"
        done
        log "Linked $src/{before-freedv,after-freedv,env} into $h"
        ok "The panadapter starts and closes with FreeDV"
    else
        # only our links: hooks of the user's own are left alone
        for f in before-freedv after-freedv env; do
            [[ -L $h/$f && $(readlink "$h/$f") == "$src/$f" ]] && rm -f "$h/$f"
        done
        log "Removed the panadapter hook links from $h"
        say "The panadapter won't be started with FreeDV."
    fi
}

# own_freedv_settings -> the user's own FreeDV settings file, if any. Where
# FreeDV keeps it depends on its version (wxWidgets): ~/.config/freedv/
# freedv.conf or the old ~/.freedv (which may also be a link to the other).
# One file counts once; if there are two different ones, the newer.
own_freedv_settings() {
    local f best="" real seen=""
    for f in "$CFG_HOME/freedv/freedv.conf" "${TEST_ROOT:-$HOME}/.freedv"; do
        [[ -f $f && -s $f ]] || continue
        real=$(readlink -f "$f")
        [[ $real == "$seen" ]] && continue
        seen=$real
        [[ -z $best || $f -nt $best ]] && best=$f
    done
    echo "$best"
}
write_freedv_conf() {
    local conf="$RADIO_DIR/freedv.conf"
    # Only a FreeDV using this radio's config matters (it saves over it on
    # exit). The prefix also covers the slots' freedv-<slot>.conf.
    while pgrep -f -- "freedv -f $RADIO_DIR/freedv" >/dev/null; do
        warn "FreeDV is running for this radio. Its settings can't be changed while it runs."
        pause "Please close FreeDV, then press Enter... "
    done
    if [[ ! -f $conf ]]; then
        local own lay="$SETUP_ROOT/layout.conf"
        own=$(own_freedv_settings)
        if [[ -n $own ]] && yesno "Start from your existing FreeDV settings (callsign, reporting etc. in ${own/#$HOME/\~})?" y; then
            cp "$own" "$conf"
        elif [[ -f $lay ]]; then
            # window positions and layout only, left by pi-admin's prepare-card
            cp "$lay" "$conf"
            say "FreeDV starts with the window layout prepared for this computer."
        else
            : > "$conf"
        fi
        # Without a TX level of its own, FreeDV starts with its TX attenuation
        # at -20 dB (stored in tenths of a dB), so the first transmission can't
        # overdrive the radio. A copy of settings that have one is left as is.
        if [[ -z $(get_ini "$conf" Audio transmitLevel) ]]; then
            set_ini "$conf" Audio transmitLevel -200
            say "FreeDV's TX attenuation starts at -20 dB. Raise it in FreeDV until the"
            say "radio's ALC just moves, or any lower level you require."
        fi
    fi
    ask_station "$conf"

    if [[ -n $MIC_NODE ]]; then
        set_ini "$conf" Audio soundCard1InDeviceName FDV_RX_in.monitor
        set_ini "$conf" Audio soundCard1OutDeviceName FDV_TX_out
        set_ini "$conf" Audio soundCard2InDeviceName FDV_TX_in.monitor
        set_ini "$conf" Audio soundCard2OutDeviceName FDV_RX_out
    else
        # Receive only: one "card", radio in and speaker out
        set_ini "$conf" Audio soundCard1InDeviceName FDV_RX_in.monitor
        set_ini "$conf" Audio soundCard1OutDeviceName FDV_RX_out
        set_ini "$conf" Audio soundCard2InDeviceName none
        set_ini "$conf" Audio soundCard2OutDeviceName none
    fi
    local k
    for k in soundCard1InSampleRate soundCard1OutSampleRate soundCard2InSampleRate soundCard2OutSampleRate; do
        set_ini "$conf" Audio $k 48000
    done

    if [[ $RIG_MODE != none ]]; then
        set_ini "$conf" Hamlib UseForPTT 1
        set_ini "$conf" Hamlib RigNameStr "Hamlib NET rigctl"
        set_ini "$conf" Hamlib RigName 0
        set_ini "$conf" Hamlib SerialPort "$RIG_HOST"
        set_ini "$conf" Hamlib PttType 0
        set_ini "$conf" Rig UseSerialPTT 0
    else
        set_ini "$conf" Hamlib UseForPTT 0
    fi
    log "Updated $conf (FreeDV's own settings for this radio)"

    # Each build slot has its own copy, freedv-<slot>.conf (see the start
    # script). Keep the settings managed here the same in them; the rest,
    # such as the TX level, stays that slot's own.
    local sc key val
    for sc in "$RADIO_DIR"/freedv-*.conf; do
        [[ -f $sc ]] || continue
        for key in Reporting/Callsign Reporting/GridSquare \
                   Audio/soundCard1InDeviceName Audio/soundCard1OutDeviceName \
                   Audio/soundCard2InDeviceName Audio/soundCard2OutDeviceName \
                   Audio/soundCard1InSampleRate Audio/soundCard1OutSampleRate \
                   Audio/soundCard2InSampleRate Audio/soundCard2OutSampleRate \
                   Hamlib/UseForPTT Hamlib/RigNameStr Hamlib/RigName Hamlib/SerialPort \
                   Hamlib/PttType Rig/UseSerialPTT; do
            val=$(get_ini "$conf" "${key%%/*}" "${key#*/}")
            [[ -n $val ]] && set_ini "$sc" "${key%%/*}" "${key#*/}" "$val"
        done
        log "Updated $sc to match (a build slot's settings)"
    done
}

settings_block() {
    local v
    echo "# ==== freedv-rade-setup settings ===="
    for v in "${SETTINGS_VARS[@]}"; do
        printf '%s=%q\n' "$v" "${!v}"
    done
    echo "# ==== end of settings ===="
}

# radio_label ID -> the radio's name as typed, from its start script
radio_label() {
    local l
    l=$(unset RADIO_LABEL; source <(grep '^RADIO_LABEL=' "$SETUP_ROOT/$1/start" 2>/dev/null); echo "${RADIO_LABEL-}")
    echo "${l:-${1^^}}"   # radios made before labels existed: upper case
}

load_settings() {
    # shellcheck disable=SC1090
    source <(sed -n '/^# ==== freedv-rade-setup settings ====/,/^# ==== end of settings ====/p' "$1")
}

write_start_script() {
    local f="$RADIO_DIR/start"
    {
        cat <<EOF
#!/bin/bash
# FreeDV start script for radio "$RADIO_LABEL", written by freedv-rade-setup $(date +%F).
#
# To change it, run freedv-rade-setup again. It reads the settings below, so
# small edits there are kept. Anything changed below the settings is replaced.
#
# Usage:  start [FreeDV options]
#         start --test    set up the sound only, check it, then tidy up
#         start --links   the same, then save the links fixed in qpwgraph
#         start --slot NAME [...]   first select FreeDV build slot NAME
#                                   (see freedv-slot), then as above
#
# Extras: executable scripts hooks/before-freedv and hooks/after-freedv in
# this folder are run before FreeDV starts and after it closes, and a file
# hooks/env is read just before FreeDV starts (e.g. export GDK_BACKEND=x11).

EOF
        settings_block
        cat <<'EOF'

RADIO_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LINKS="$RADIO_DIR/links"
VOLS="$RADIO_DIR/volumes.db"
SINKS=(FDV_RX_in FDV_RX_out FDV_TX_in FDV_TX_out)
SLOT_TOOL="$HOME/freedv-rade-build/freedv-slot"

TEST=0 EDIT_LINKS=0 SLOT=""
if [[ $1 == --slot ]]; then
    SLOT=$2
    [[ -n $SLOT ]] || { echo "Usage: start --slot NAME [--test|--links] [FreeDV options]"; exit 1; }
    shift 2
fi
[[ $1 == --test ]] && { TEST=1; shift; }
[[ $1 == --links ]] && { TEST=1; EDIT_LINKS=1; shift; }

[[ -f $LINKS ]] || { echo "Missing $LINKS - run freedv-rade-setup"; exit 1; }

# One start script at a time, for any radio: they all share the FDV_ boxes
# and the sound server, and starting one restarts the sound and the filter
# under the other. The lock is held until this script (and FreeDV, which
# inherits it) ends; helpers started below close it, so a leftover filter
# or qpwgraph can't keep it.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/freedv-rade-setup.lock"
exec 9>>"$LOCK"
if ! flock -n 9; then
    other=$(cat "$LOCK.radio" 2>/dev/null)
    echo "FreeDV is already running${other:+ (radio $other)}. Close it first."
    [[ -t 0 ]] && read -r -p "Press Enter to close this window. " _
    exit 1
fi

# Build slots: with more than one FreeDV build (e.g. RADE V1 and V2), each
# is a slot and ~/freedv-rade points at the selected one. --slot selects
# one; without it the selected slot is used. Each slot keeps its own FreeDV
# settings for this radio (it may need a different TX level, for one), made
# from freedv.conf the first time. Re-running the setup keeps the sound, rig
# and station settings the same in all of them.
if [[ -n $SLOT ]] && ! "$SLOT_TOOL" select "$SLOT"; then
    [[ -t 0 ]] && read -r -p "Press Enter to close this window. " _
    exit 1
fi
[[ -x $SLOT_TOOL ]] && SLOT=$("$SLOT_TOOL" current 2>/dev/null)
echo "$RADIO_LABEL${SLOT:+ ($SLOT)}" > "$LOCK.radio"

# The filter follows the FreeDV build: Fdv-bpf-1k for a RADE V2 build (it has
# the RADEV2 mode), Fdv-bpf otherwise. Its PipeWire node is named after the
# program; the links file calls it Fdv-bpf either way.
FREEDV_BIN="$FREEDV_DIR/freedv-gui/build_linux/src/freedv"
# The build's RADE mode, also for the hooks (e.g. the panadapter's passband)
if grep -qa RADEV2 "$FREEDV_BIN" 2>/dev/null; then export FREEDV_RADE=V2; else export FREEDV_RADE=V1; fi
if [[ $BPF != none && -n $BPF_BIN ]]; then
    BPF_BIN=${BPF_BIN%-1k}
    [[ $FREEDV_RADE == V2 ]] && BPF_BIN="$BPF_BIN-1k"
fi
BPF_NODE=${BPF_BIN##*/}
CONF="$RADIO_DIR/freedv.conf"
if [[ -n $SLOT ]]; then
    CONF="$RADIO_DIR/freedv-$SLOT.conf"
    if [[ ! -f $CONF && -f $RADIO_DIR/freedv.conf ]]; then
        cp "$RADIO_DIR/freedv.conf" "$CONF"
        echo "First start of build slot $SLOT for this radio: its FreeDV settings are"
        echo "kept in freedv-$SLOT.conf (copied from freedv.conf). Check its TX level in FreeDV."
    fi
fi
# FreeDV's settings file for this start, for the hooks (e.g. the panadapter
# follows FreeDV's rig control setting in it)
export FREEDV_CONF=$CONF

restart_sound() {
    # A restart normally takes a second or two. If it hangs, the sound server
    # is usually stuck waiting for a USB sound device that went away while in
    # use, which only a reboot clears, so say so rather than wait for ever.
    if ! timeout 20 systemctl --user restart pipewire wireplumber; then
        echo
        echo "ERROR: the sound server didn't restart within 20 seconds."
        local p stuck=""
        for p in $(pgrep -u "$USER" -x 'pipewire|pipewire-pulse|wireplumber'); do
            [[ $(awk '{print $3}' "/proc/$p/stat" 2>/dev/null) == D ]] && stuck+=" $(cat "/proc/$p/comm")"
        done
        if [[ -n $stuck ]]; then
            echo "It is stuck ($stuck ), usually waiting for a USB sound device that was"
            echo "unplugged or dropped out while in use. Please REBOOT, then try again."
        else
            echo "Try again; if it keeps happening, reboot."
        fi
        exit 1
    fi
    local i
    for ((i=0; i<50; i++)); do
        timeout 2 pactl info &>/dev/null && break
        sleep 0.2
    done
    sleep 1
}

create_sinks() {
    local sink
    for sink in "${SINKS[@]}"; do
        if pactl list sinks short | grep -qw "$sink"; then
            echo "$sink already exists"
        else
            echo "Creating $sink"
            pactl load-module module-null-sink sink_name="$sink" \
                sink_properties="media.role=phone session.suspend-timeout-seconds=9999" >/dev/null
        fi
    done
}

node_exists() { { pw-link -i; pw-link -o; } 2>/dev/null | cut -d: -f1 | grep -qxF -- "$1"; }

# Nodes named in the links file, apart from FreeDV's own streams
link_nodes() { tr ' ' '\n' < "$LINKS" | cut -d: -f1 | sed '/^$/d' | sort -u; }

# stop_start MESSAGE -> stop the start, after Enter: a desktop icon's window
# closes as soon as this script ends
stop_start() {
    echo "$1"
    [[ -t 0 ]] && read -r -p "Press Enter to close this window. " _
    exit 1
}

wait_for_nodes() {
    local n i missing
    for ((i=0; i<50; i++)); do
        missing=""
        for n in $(link_nodes); do
            node_exists "$n" || missing+=" $n"
        done
        [[ -z $missing ]] && return 0
        sleep 0.2
    done
    echo "WARNING: not found (unplugged?):$missing"
    # ask, or FreeDV's window would cover the warning before it can be read
    if [[ -t 0 ]]; then
        read -r -p "(C)ontinue or (S)top? [C/s] " REPLY
        [[ $REPLY == [Ss]* ]] && stop_start "Stopped. Check the sound cards are plugged in, then start again."
    fi
}

# node_ident NODE -> "VENDOR:PRODUCT SERIAL" of the USB card behind a node
node_ident() {
    { LC_ALL=C pactl list sinks; LC_ALL=C pactl list sources; } 2>/dev/null | awk -v node="$1" '
        /^(Sink|Source) #/ { innode = 0 }
        $1 == "Name:" { innode = ($2 == node) }
        innode && $2 == "=" && ($1 == "device.vendor.id" || $1 == "device.product.id" || $1 == "device.serial") {
            v = $0; sub(/^[^=]*= *"/, "", v); sub(/"$/, "", v); p[$1] = v
        }
        END { if (p["device.vendor.id"] != "") print p["device.vendor.id"] ":" p["device.product.id"] " " p["device.serial"] }'
}

# The radio's and the headset's cards are named by USB socket. If they have
# been plugged into each other's sockets, the radio's audio would go to the
# headset (and the other way round), so ask before going on.
check_cards() {
    local have swapped=0
    if [[ -n $RADIO_CARD_ID && -n $RADIO_TX_NODE ]]; then
        have=$(node_ident "$RADIO_TX_NODE")
        [[ -n $have && $have != "$RADIO_CARD_ID" ]] && swapped=1
    fi
    if [[ -n $MIC_CARD_ID && -n $MIC_NODE ]]; then
        have=$(node_ident "$MIC_NODE")
        [[ -n $have && $have != "$MIC_CARD_ID" ]] && swapped=1
    fi
    ((swapped)) || return 0
    echo
    echo "The sound cards in the USB sockets are not the ones this radio was set up with."
    read -r -p "Have you switched your USB audio cables around? [y/N] " REPLY
    [[ $REPLY == [Yy]* ]] && stop_start "Please plug each one back into its own socket, then start again."
    echo "Carrying on. If the sound goes to the wrong place, run freedv-rade-setup"
    echo "again to set up this radio's sound card and headset."
}

start_bpf() {
    [[ $BPF == none || -z $BPF_BIN ]] && return
    if [[ ! -x $BPF_BIN ]]; then
        echo "WARNING: $BPF_BIN is missing - re-run freedv-rade-setup"
        return
    fi
    pkill -x "$(basename "$BPF_BIN")" && sleep 0.2
    nohup "$BPF_BIN" >/dev/null 2>&1 </dev/null 9>&- &
    BPF_PID=$!
    local i
    for ((i=0; i<25; i++)); do
        node_exists "$BPF_NODE" && { echo "Band-pass filter running ($BPF_NODE)"; return; }
        sleep 0.2
    done
    echo "WARNING: the band-pass filter did not start"
}

# The filter is mono in and out (input_MONO, output_MONO). If PipeWire
# gives it stereo ports instead (it adapts them to a card it got linked to,
# e.g. an older filter build whose no-autoconnect setting was lost), use
# those, from a run-time copy of the links.
fix_bpf_ports() {
    local ports b=$BPF_NODE stereo=0
    local -a sed_args=()
    [[ -n $b ]] && grep -q "Fdv-bpf:" "$LINKS" || return
    [[ $b != Fdv-bpf ]] && sed_args+=(-e "s/Fdv-bpf:/$b:/g")
    ports=$({ pw-link -i; pw-link -o; } 2>/dev/null | grep "^$b:")
    if ! grep -qx "$b:input_MONO" <<<"$ports" && grep -qx "$b:input_FR" <<<"$ports"; then
        sed_args+=(-e "s/^\\(.*\\):monitor_FL $b:input_MONO\$/\\1:monitor_FL $b:input_FL\\n\\1:monitor_FR $b:input_FR/")
        stereo=1
    fi
    if ! grep -qx "$b:output_MONO" <<<"$ports" && grep -qx "$b:output_FR" <<<"$ports"; then
        sed_args+=(-e "s/^$b:output_MONO \\(.*\\):playback_\\(F[LR]\\)\$/$b:output_\\2 \\1:playback_\\2/")
        stereo=1
    fi
    ((${#sed_args[@]})) || return
    RUN_LINKS=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/freedv-links.XXXXXX") || return
    sed "${sed_args[@]}" "$LINKS" > "$RUN_LINKS"
    LINKS=$RUN_LINKS
    ((stereo)) && echo "(Band-pass filter has stereo ports here - linking them)"
}

# Save the links in place now between this radio's nodes and FreeDV's sinks
# (not FreeDV's own links, which it makes itself) as this radio's links
save_links() {
    local f="$RADIO_DIR/links" a b nodes
    nodes=" ${SINKS[*]} $BPF_NODE $RADIO_RX_NODE $RADIO_TX_NODE $MIC_NODE $PHONES_NODE $SPEAKER_NODE "
    while read -r a b; do
        [[ -z $b || ${a%%:*} == FreeDV || ${b%%:*} == FreeDV ]] && continue
        [[ $nodes == *" ${a%%:*} "* || $nodes == *" ${b%%:*} "* ]] && echo "$a $b"
    done < <(current_links) | sed "s/^$BPF_NODE:/Fdv-bpf:/; s/ $BPF_NODE:/ Fdv-bpf:/" > "$f.new"
    if ! grep -q . "$f.new"; then
        echo "No links found - nothing saved."
        rm -f "$f.new"
        return
    fi
    cp "$f" "$f.bak" 2>/dev/null
    mv "$f.new" "$f"
    echo "Saved $(wc -l < "$f") links to $f (old file kept as links.bak)."
}

current_links() {
    pw-link -l 2>/dev/null | awk '
        $0 !~ /\|/ { prev = $0; next }
        /->/ { sub(/\|/, "", $0); gsub(/[ ]+->[ ]+/, " ", $0); print prev $0 }'
}

# Remove links to or from our nodes that are not in the links file
remove_other_links() {
    local nodes line a b
    nodes=" $(link_nodes | tr '\n' ' ') "
    while read -r a b; do
        [[ -z $b ]] && continue
        [[ $nodes == *" ${a%%:*} "* || $nodes == *" ${b%%:*} "* ]] || continue
        grep -qxF "$a $b" "$LINKS" && continue
        pw-link -d "$a" "$b" 2>/dev/null && echo "Removed link $a -> $b"
    done < <(current_links)
}

restore_links() {
    local a b
    while read -r a b; do
        [[ -z $b ]] && continue
        pw-link "$a" "$b" 2>/dev/null
    done < "$LINKS"
}

check_links() {
    local a b bad=0 now
    now=$(current_links)
    while read -r a b; do
        [[ -z $b ]] && continue
        if ! grep -qxF "$a $b" <<<"$now"; then
            echo "  MISSING: $a -> $b"
            bad=1
        fi
    done < "$LINKS"
    ((bad)) && echo "Some links are missing." || echo "All the links made by the start script are in place."
    return $bad
}

save_vols() {
    : > "$VOLS"
    wpctl status | grep '\[vol:' | while read -r line; do
        clean_line=$(echo "$line" | tr -d '│*' | sed 's/^[ \t]*//;s/[ \t]*$//')
        id=$(echo "$clean_line" | cut -d'.' -f1 | tr -d ' ')
        vol=$(echo "$clean_line" | grep -o '\[vol: [0-9.]*\]' | cut -d' ' -f2 | tr -d ']')
        [[ -z "$id" || -z "$vol" ]] && continue
        node_info=$(wpctl inspect "$id")
        name=$(echo "$node_info" | grep 'node.name' | cut -d'"' -f2)
        class=$(echo "$node_info" | grep 'media.class' | cut -d'"' -f2)
        [[ -n "$name" && -n "$class" ]] && echo "$name|$class|$vol" >> "$VOLS"
    done
    echo "Volume settings saved"
}

restore_vols() {
    [[ -f $VOLS ]] || return
    local -A id_for_key
    local line clean_line id node_info name class saved_name saved_class saved_vol
    while read -r line; do
        clean_line=$(echo "$line" | tr -d '│*' | sed 's/^[ \t]*//;s/[ \t]*$//')
        id=$(echo "$clean_line" | cut -d'.' -f1 | tr -d ' ')
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        node_info=$(wpctl inspect "$id")
        name=$(echo "$node_info" | grep 'node.name' | cut -d'"' -f2)
        class=$(echo "$node_info" | grep 'media.class' | cut -d'"' -f2)
        [[ -n "$name" ]] && id_for_key["$name|$class"]="$id"
    done < <(wpctl status | grep '\[vol:')

    while IFS='|' read -r saved_name saved_class saved_vol; do
        id="${id_for_key["$saved_name|$saved_class"]}"
        [[ -n "$id" ]] && wpctl set-volume "$id" "$saved_vol"
    done < "$VOLS"
    echo "Volume settings restored"
}

STARTED_RIGCTLD=0
start_rig() {
    case $RIG_MODE in
        ondemand)
            if [[ ! -x $RIGCTLD_BIN ]]; then
                echo "WARNING: $RIGCTLD_BIN is missing"
                return
            fi
            if pgrep -x rigctld >/dev/null; then
                echo "rigctld is already running, leaving it as-is"
                return
            fi
            echo "Starting rigctld"
            "$RIGCTLD_BIN" -m "$RIG_MODEL" -r "$RIG_PORT" -T "$RIG_LISTEN" -t 4532 \
                ${RIG_SETCONF:+--set-conf="$RIG_SETCONF"} 9>&- &
            RIGCTLD_PID=$!
            STARTED_RIGCTLD=1
            sleep 1 ;;
        boot|existing|remote)
            if [[ -x $RIGCTL_BIN ]] && ! timeout 5 "$RIGCTL_BIN" -m 2 -r "$RIG_HOST" f &>/dev/null; then
                echo "WARNING: rigctld at $RIG_HOST is not answering (radio off?)"
            fi ;;
    esac
}

cleanup() {
    trap - INT TERM EXIT
    ((TEST)) || save_vols
    if [[ -n $BPF_PID ]] && kill "$BPF_PID" 2>/dev/null; then
        # an older filter build can hang when no audio flows - make sure
        local i
        for ((i=0; i<10; i++)); do kill -0 "$BPF_PID" 2>/dev/null || break; sleep 0.1; done
        kill -KILL "$BPF_PID" 2>/dev/null
    fi
    [[ -n $RUN_LINKS ]] && rm -f "$RUN_LINKS"
    if ((STARTED_RIGCTLD)); then
        kill "$RIGCTLD_PID" 2>/dev/null
        echo "rigctld stopped"
    fi
}
trap cleanup INT TERM EXIT

run_hook() {
    [[ -x $RADIO_DIR/hooks/$1 ]] && "$RADIO_DIR/hooks/$1"
}

