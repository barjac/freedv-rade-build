}

# slot_names -> the FreeDV build slots, one per line (none without slots)
slot_names() {
    local tool="$SCRIPT_DIR/freedv-slot"
    [[ -L $FREEDV_DIR && -x $tool ]] || return 0
    "$tool" current &>/dev/null || return 0
    "$tool" names 2>/dev/null
}

# icons_text -> "the 'FreeDV' desktop icon" or the per-slot ones
icons_text() {
    local -a slots
    mapfile -t slots < <(slot_names)
    if ((${#slots[@]})); then
        echo "the '$(icon_name "$RADIO_LABEL" "<slot>")' desktop icons (${slots[*]})"
    else
        echo "the '$(icon_name "$RADIO_LABEL" "")' desktop icon"
    fi
}

# icon_name LABEL SLOT -> a desktop icon's name: just "FreeDV v1" while only
# one radio is set up (no radio name on a card passed on to someone else),
# "FreeDV radio TS-450S v1" once there are more, to tell them apart
icon_name() {
    local n
    n=$(find "$SETUP_ROOT" -mindepth 2 -maxdepth 2 -name start 2>/dev/null | wc -l)
    if ((n > 1)); then
        echo "FreeDV radio $1${2:+ $2}"
    else
        echo "FreeDV${2:+ $2}"
    fi
}

# rename_other_icons -> other radios' icons, renamed to match icon_name (a
# second radio adds the radio names to the first one's icons)
rename_other_icons() {
    local f r slot name
    for f in "$DESKTOP_DIR"/freedv-radio-*.desktop "$APPS_DIR"/freedv-radio-*.desktop; do
        [[ -f $f ]] || continue
        r=$(sed -n 's/^X-FreeDV-Radio=//p' "$f")
        [[ -n $r && $r != "$RADIO" && -f $SETUP_ROOT/$r/start ]] || continue
        slot=$(sed -n 's/^X-FreeDV-Slot=//p' "$f")
        name=$(icon_name "$(radio_label "$r")" "$slot")
        grep -qxF "Name=$name" "$f" && continue
        sed -i "s|^Name=.*|Name=$name|; s|^Comment=.*|Comment=$name (made by freedv-rade-setup)|" "$f"
        log "Renamed desktop icon $f: $name"
    done
}

# write_desktop FILE NAME EXEC SLOT
write_desktop() {
    # Written complete under a hidden name in the same folder, then renamed
    # into place in one step: the Pi's desktop (pcmanfm) read an icon file
    # rewritten in place half-way through, took it for an unknown file
    # (shown by its file name) and never looked again
    local final=$1 tmp mtmp
    tmp=$(mktemp "${final%/*}/.freedv-icon.XXXXXX") || return 1
    set -- "$tmp" "${@:2}"
    cat > "$1" <<EOF
[Desktop Entry]
Version=1.0
Name=$2
Exec=$3
Icon=$RUN_DIR/freedv.png
Type=Application
Terminal=true
Categories=AudioVideo;Audio;HamRadio;
Comment=$2 (made by freedv-rade-setup)
Keywords=Radio;HAM;HF;RF;codec2;voice;modem;
StartupWMClass=freedv
X-FreeDV-Radio=$RADIO
X-FreeDV-Slot=$4
EOF
    chmod 755 "$1"
    # the menu's copy the same way
    mtmp=$(mktemp "$APPS_DIR/.freedv-icon.XXXXXX") && cp "$1" "$mtmp" && chmod 755 "$mtmp" \
        && mv -f "$mtmp" "$APPS_DIR/${final##*/}"
    mv -f "$1" "$final"
    gio set "$final" metadata::trusted true 2>/dev/null || true
}

# One desktop icon for the radio, or with build slots one per slot ("FreeDV
# v1", or "FreeDV radio TS-450S v1" with more radios: see icon_name). Icons
# for slots that are gone are removed.
write_launchers() {
    local link="$LINK_DIR/freedv-radio-$RADIO" f slot
    local -a slots
    ln -sfn "$RADIO_DIR/start" "$link"
    log "Terminal command: $link"

    mapfile -t slots < <(slot_names)
    mkdir -p "$DESKTOP_DIR" "$APPS_DIR"
    for f in "$DESKTOP_DIR"/freedv-radio-*.desktop "$APPS_DIR"/freedv-radio-*.desktop; do
        [[ -f $f ]] && grep -qxF "X-FreeDV-Radio=$RADIO" "$f" && rm -f "$f"
    done
    # icons made before X-FreeDV-Radio existed
    rm -f "$DESKTOP_DIR/freedv-radio-$RADIO.desktop" "$APPS_DIR/freedv-radio-$RADIO.desktop"
    if ((${#slots[@]})); then
        for slot in "${slots[@]}"; do
            write_desktop "$DESKTOP_DIR/freedv-radio-$RADIO-$slot.desktop" \
                "$(icon_name "$RADIO_LABEL" "$slot")" "$RADIO_DIR/start --slot $slot" "$slot"
            log "Desktop icon: $(icon_name "$RADIO_LABEL" "$slot")"
        done
    else
        write_desktop "$DESKTOP_DIR/freedv-radio-$RADIO.desktop" \
            "$(icon_name "$RADIO_LABEL" "")" "$RADIO_DIR/start" ""
        log "Desktop icon: $(icon_name "$RADIO_LABEL" "")"
    fi
    rename_other_icons
    command -v update-desktop-database &>/dev/null && update-desktop-database "$APPS_DIR" 2>/dev/null

    # pw-link-ls: lists the current links, e.g. for checking by hand
    if [[ -f $SCRIPT_DIR/pw-link-ls ]]; then
        mkdir -p "$LOCAL_BIN"
        install -m 755 "$SCRIPT_DIR/pw-link-ls" "$LOCAL_BIN/pw-link-ls"
    fi
}

finish() {
