write_launchers() {
    local link="$LINK_DIR/freedv-radio-$RADIO" desk
    ln -sfn "$RADIO_DIR/start" "$link"
    log "Terminal command: $link"

    mkdir -p "$DESKTOP_DIR" "$APPS_DIR"
    desk="$DESKTOP_DIR/freedv-radio-$RADIO.desktop"
    cat > "$desk" <<EOF
[Desktop Entry]
Version=1.0
Name=FreeDV radio $RADIO_LABEL
Exec=$RADIO_DIR/start
Icon=$RUN_DIR/freedv.png
Type=Application
Terminal=true
Categories=AudioVideo;Audio;HamRadio;
Comment=FreeDV for radio $RADIO_LABEL (made by freedv-rade-setup)
Keywords=Radio;HAM;HF;RF;codec2;voice;modem;
StartupWMClass=freedv
EOF
    chmod +x "$desk"
    gio set "$desk" metadata::trusted true 2>/dev/null || true
    cp "$desk" "$APPS_DIR/"
    command -v update-desktop-database &>/dev/null && update-desktop-database "$APPS_DIR" 2>/dev/null
    log "Desktop icon: FreeDV radio $RADIO_LABEL"

    # pw-link-ls: lists the current links, e.g. for checking by hand
    if [[ -f $SCRIPT_DIR/pw-link-ls ]]; then
        mkdir -p "$LOCAL_BIN"
        install -m 755 "$SCRIPT_DIR/pw-link-ls" "$LOCAL_BIN/pw-link-ls"
    fi
}

# Save the links that are in place now (after fixing them in qpwgraph)
save_current_links() {
    local f="$RADIO_DIR/links" nodes
    local -a keep=(FDV_RX_in FDV_RX_out FDV_TX_in FDV_TX_out Fdv-bpf Fdv-bpf-1k
                   "$RADIO_RX_NODE" "$RADIO_TX_NODE" "$MIC_NODE" "$PHONES_NODE" "$SPEAKER_NODE")
    nodes=" ${keep[*]} "
    say "Fix the routing in qpwgraph first (FreeDV can be running)."
    yesno "Save the links that are in place now as this radio's links?" y || return
    "$SCRIPT_DIR/pw-link-ls" | while read -r a b; do
        [[ ${a%%:*} == FreeDV || ${b%%:*} == FreeDV ]] && continue
        [[ $nodes == *" ${a%%:*} "* || $nodes == *" ${b%%:*} "* ]] && echo "$a $b"
    done | sed 's/Fdv-bpf-1k:/Fdv-bpf:/g' > "$f.new"
    # The transmit path only exists while the start script's sound setup is
    # in place (e.g. the filter), so check it wasn't saved at the wrong time
    if grep -q 'FDV_TX_out' "$f" 2>/dev/null && ! grep -q 'FDV_TX_out' "$f.new"; then
        warn "There are no transmit links in place now. Start FreeDV for this radio"
        say "  (or use 'Test the sound setup') before saving, or they will be lost."
        yesno "Save anyway?" n || { rm -f "$f.new"; return; }
    fi
    cp "$f" "$f.bak" 2>/dev/null
    mv "$f.new" "$f"
    say "Saved $(wc -l < "$f") links to $f (old file kept as links.bak)."
}

finish() {
    heading "Writing files for radio $RADIO_LABEL"
    write_links
    write_freedv_conf
    write_start_script
    write_launchers
    say "Saved for $RADIO_LABEL: the sound links ($(grep -c . "$RADIO_DIR/links" 2>/dev/null)), FreeDV settings, start script and the"
    say "'FreeDV radio $RADIO_LABEL' desktop icon. Details are in the log."
}

test_sound() {
    heading "Testing the sound setup"
    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: not running the sound test)"
        return
    fi
    say "This restarts the sound system briefly and links your radio, headset and"
    say "filter to FreeDV's FDV_ boxes, without starting FreeDV. Then it opens"
    say "qpwgraph so you can see them. FreeDV itself won't be shown: its links only"
    say "appear when FreeDV is running and you press Start Modem."
    yesno "Run the test now?" y || return
    log "\n\$ $RADIO_DIR/start --test"
    "$RADIO_DIR/start" --test 2>&1 | tee -a "$LOGFILE" >&3
}

# System details at the top of the log, for bug reports
log_header() {
    {
        echo "freedv-rade-setup $FRS_VERSION"
        echo "Started: $(date)"
        echo "Options: $FRS_ARGS"
        echo "Script: $SCRIPT_DIR ($(git -C "$SCRIPT_DIR" log -1 --format='%h %cd' --date=short 2>/dev/null || echo 'not a git clone'))"
        echo "freedv-rade-build: $(git -C "$RUN_DIR" log -1 --format='%h %cd %s' --date=short 2>/dev/null || echo 'not found')"
        echo "Kernel: $(uname -r)"
        echo
        cat /etc/os-release
        echo
        locale
        echo
        LC_ALL=C timeout 5 pactl info 2>&1 | grep -E 'Server (Name|Version)|Default S'
        pipewire --version 2>&1
        wireplumber --version 2>&1
        echo "=========================================================="
    } >> "$LOGFILE" 2>&1
}

##################### main #####################

. /etc/os-release
log_header
[[ -t 3 ]] && clear >&3 2>/dev/null
say "**************** Welcome to freedv-rade-setup ****************"
say "Version $FRS_VERSION"
[[ -n $TEST_ROOT ]] && say "\nTEST MODE: files go under $TEST_ROOT"
say "\nIf you're not sure about a question, press Enter for the recommended answer."
screen "(Full details of each step go to $LOGFILE)"

preflight
((CHECK_ONLY)) && { say "System checks finished."; exit 0; }

mkdir -p "$SETUP_ROOT"
mapfile -t radios < <(find "$SETUP_ROOT" -mindepth 2 -maxdepth 2 -name start -printf '%h\n' 2>/dev/null | xargs -r -n1 basename | sort)

RADIO=""
if ((${#radios[@]})); then
    if ((${#radios[@]} <= 8)); then
        # single key, like the other menus. Enter picks the radio set up or
        # changed most recently, as a re-run is usually for the same radio.
        last=$(find "$SETUP_ROOT" -mindepth 2 -maxdepth 2 -name start -printf '%T@ %h\n' 2>/dev/null \
            | sort -n | tail -1 | xargs -r basename)
        def=2
        say "  1) Set up a new radio"
        for ((i=0; i<${#radios[@]}; i++)); do
            say "  $((i+2))) Test or edit the $(radio_label "${radios[i]}") setup"
            [[ ${radios[i]} == "$last" ]] && def=$((i+2))
        done
        hint="$def"; keys=("$def")
        for ((i=1; i<=${#radios[@]}+1; i++)); do
            ((i == def)) && continue
            hint+="/$i"; keys+=("$i")
        done
        confirm "What would you like to do?" "[$hint]" "${keys[@]}"
        CHOICE=${keys[$?]}
    else
        items=("Set up a new radio")
        for r in "${radios[@]}"; do items+=("Test or edit the $(radio_label "$r") setup"); done
        choose "What would you like to do?" 1 "${items[@]}"
    fi
    ((CHOICE > 1)) && RADIO=${radios[CHOICE-2]}
fi

if [[ -z $RADIO ]]; then
    heading "New radio"
    while true; do
        ask "A short name for this radio (e.g. ic7300, ts450s)" ""
        RADIO=$(tr 'A-Z' 'a-z' <<<"$REPLY" | tr -c 'a-z0-9-\n' '-' | sed 's/^-*//;s/-*$//')
        [[ -n $RADIO ]] || continue
        # shown as typed (e.g. TS450S); the id above names files and nodes
        RADIO_LABEL=${REPLY#"${REPLY%%[![:space:]]*}"}
        RADIO_LABEL=${RADIO_LABEL%"${RADIO_LABEL##*[![:space:]]}"}
        [[ -e $SETUP_ROOT/$RADIO/start ]] && { say "There is already a radio called $RADIO."; continue; }
        # a folder without a start script is left from a run that was stopped part way
        [[ -d $SETUP_ROOT/$RADIO ]] && say "(Finishing the setup of $RADIO that was stopped before.)"
        break
    done
    RADIO_DIR="$SETUP_ROOT/$RADIO"
    mkdir -p "$RADIO_DIR"
    BPF=none; MONITOR=none; RIG_MODE=none
    NEW_RADIO=1
    if ! radio_audio_step; then
        # (card names belong to the USB socket and may be shared, so they stay)
        rm -rf "$RADIO_DIR"
        die "No radio sound card - nothing written. Run freedv-rade-setup again to retry."
    fi
    headset_step
    rig_step
    bpf_step
    finish
    test_sound
else
    RADIO_DIR="$SETUP_ROOT/$RADIO"
    # Keep the paths found by this run's checks
    _rigctl=$RIGCTL_BIN; _rigctld=$RIGCTLD_BIN; _fdv=$FREEDV_DIR; _qpw=$QPWGRAPH_CMD
    load_settings "$RADIO_DIR/start"
    RADIO_LABEL=${RADIO_LABEL:-${RADIO^^}}   # radios made before labels existed
    RIGCTL_BIN=${_rigctl:-$RIGCTL_BIN}; RIGCTLD_BIN=${_rigctld:-$RIGCTLD_BIN}; FREEDV_DIR=$_fdv
    QPWGRAPH_CMD=${_qpw:-$QPWGRAPH_CMD}
    while true; do
        heading "Radio $RADIO_LABEL"
        say "  (T)est the sound setup"
        say "  Redo the (R)adio sound card"
        say "  Redo the (M)icrophone, headphones and speakers"
        say "  Redo rig (C)ontrol"
        say "  Change the band-pass (F)ilter"
        say "  (S)ave the current links (after fixing them in qpwgraph)"
        say "  Re(W)rite the start script and desktop icon only"
        say "  (Q)uit"
        confirm "What would you like to do?" "[T/r/m/c/f/s/w/q]" "Tt" "Rr" "Mm" "Cc" "Ff" "Ss" "Ww" "Qq"
        CHOICE=$(($? + 1))
        case $CHOICE in
            1) test_sound ;;
            2) radio_audio_step && finish ;;
            3) headset_step; finish ;;
            4) rig_step; finish ;;
            5) bpf_step; finish ;;
            6) save_current_links ;;
            7) write_start_script; write_launchers ;;
            8) break ;;
        esac
    done
fi

