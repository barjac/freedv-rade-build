[[ -f $RADIO_DIR/hooks/env ]] && source "$RADIO_DIR/hooks/env"

# FreeDV's output, for troubleshooting. On a Raspberry Pi where the radio
# folder is on the SD card (not just the boot files), it's kept in RAM (gone
# at the next reboot) to spare the card ~10MB of writes per session; the
# radio folder then has a link to it.
LOG="$RADIO_DIR/freedv-debug.log"
if grep -qa "Raspberry Pi" /proc/device-tree/model 2>/dev/null \
   && [[ $(findmnt -no SOURCE --target "$RADIO_DIR" 2>/dev/null) == /dev/mmcblk* && -d ${XDG_RUNTIME_DIR:-} ]]; then
    LOG="$XDG_RUNTIME_DIR/freedv-debug-${RADIO_DIR##*/}.log"
    ln -sfn "$LOG" "$RADIO_DIR/freedv-debug.log"
elif [[ -L $LOG ]]; then
    rm -f "$LOG"   # moved from an SD card: a real file again
fi

# Process substitution (not a pipe) so the script carries on as soon as FreeDV exits
src/freedv -f "$CONF" "$@" > >(tee "$LOG") 2>&1

run_hook after-freedv
cd
EOF
    } > "$f"
    chmod +x "$f"
    mkdir -p "$RADIO_DIR/hooks"
    log "Wrote $f"
}

# slot_names -> the FreeDV build slots, one per line (none without slots)
slot_names() {
    local tool="$SCRIPT_DIR/freedv-slot"
    [[ -L $FREEDV_DIR && -x $tool ]] || return 0
    "$tool" current &>/dev/null || return 0
    "$tool" names 2>/dev/null
}

# icons_text -> "the 'FreeDV' desktop icon" or the per-slot ones
icons_text() {
    local -a slots
    mapfile -t slots < <(slot_names)
    if ((${#slots[@]})); then
        echo "the '$(icon_name "$RADIO_LABEL" "<slot>")' desktop icons (${slots[*]})"
    else
        echo "the '$(icon_name "$RADIO_LABEL" "")' desktop icon"
    fi
}

# icon_name LABEL SLOT -> a desktop icon's name: just "FreeDV v1" while only
# one radio is set up (no radio name on a card passed on to someone else),
# "FreeDV radio TS-450S v1" once there are more, to tell them apart
icon_name() {
    local n
    n=$(find "$SETUP_ROOT" -mindepth 2 -maxdepth 2 -name start 2>/dev/null | wc -l)
    if ((n > 1)); then
        echo "FreeDV radio $1${2:+ $2}"
    else
        echo "FreeDV${2:+ $2}"
    fi
}

# rename_other_icons -> other radios' icons, renamed to match icon_name (a
# second radio adds the radio names to the first one's icons)
rename_other_icons() {
    local f r slot name
    for f in "$DESKTOP_DIR"/freedv-radio-*.desktop "$APPS_DIR"/freedv-radio-*.desktop; do
        [[ -f $f ]] || continue
        r=$(sed -n 's/^X-FreeDV-Radio=//p' "$f")
        [[ -n $r && $r != "$RADIO" && -f $SETUP_ROOT/$r/start ]] || continue
        slot=$(sed -n 's/^X-FreeDV-Slot=//p' "$f")
        name=$(icon_name "$(radio_label "$r")" "$slot")
        grep -qxF "Name=$name" "$f" && continue
        sed -i "s|^Name=.*|Name=$name|; s|^Comment=.*|Comment=$name (made by freedv-rade-setup)|" "$f"
        log "Renamed desktop icon $f: $name"
    done
}

# write_desktop FILE NAME EXEC SLOT
write_desktop() {
    # Written complete under a hidden name in the same folder, then renamed
    # into place in one step: the Pi's desktop (pcmanfm) read an icon file
    # rewritten in place half-way through, took it for an unknown file
    # (shown by its file name) and never looked again
    local final=$1 tmp mtmp
    tmp=$(mktemp "${final%/*}/.freedv-icon.XXXXXX") || return 1
    set -- "$tmp" "${@:2}"
    cat > "$1" <<EOF
[Desktop Entry]
Version=1.0
Name=$2
Exec=$3
Icon=$RUN_DIR/freedv.png
Type=Application
Terminal=true
Categories=AudioVideo;Audio;HamRadio;
Comment=$2 (made by freedv-rade-setup)
Keywords=Radio;HAM;HF;RF;codec2;voice;modem;
StartupWMClass=freedv
X-FreeDV-Radio=$RADIO
X-FreeDV-Slot=$4
EOF
    chmod 755 "$1"
    # the menu's copy the same way
    mtmp=$(mktemp "$APPS_DIR/.freedv-icon.XXXXXX") && cp "$1" "$mtmp" && chmod 755 "$mtmp" \
        && mv -f "$mtmp" "$APPS_DIR/${final##*/}"
    mv -f "$1" "$final"
    gio set "$final" metadata::trusted true 2>/dev/null || true
}

# One desktop icon for the radio, or with build slots one per slot ("FreeDV
# v1", or "FreeDV radio TS-450S v1" with more radios: see icon_name). Icons
# for slots that are gone are removed.
# ensure_desktop FILE NAME EXEC SLOT -> makes this radio's icon for SLOT if
# there isn't one yet. An icon already there (found by its X-FreeDV-Radio and
# X-FreeDV-Slot lines, whatever its file is called) is left as it is, so any
# changes made to it by hand are kept; only its Exec line is corrected if the
# command has changed.
ensure_desktop() {
    local final=$1 name=$2 exec=$3 slot=$4 f found=
    for f in "$DESKTOP_DIR"/*.desktop "$APPS_DIR"/*.desktop; do
        [[ -f $f ]] && grep -qxF "X-FreeDV-Radio=$RADIO" "$f" && grep -qxF "X-FreeDV-Slot=$slot" "$f" || continue
        found=1
        grep -qxF "Exec=$exec" "$f" && continue
        sed -i "s|^Exec=.*|Exec=$exec|" "$f"
        log "Desktop icon $f: command updated to $exec"
    done
    if [[ -z $found ]]; then
        write_desktop "$final" "$name" "$exec" "$slot"
        log "Desktop icon: $name"
    fi
}

write_launchers() {
    local link="$LINK_DIR/freedv-radio-$RADIO" f slot
    local -a slots
    ln -sfn "$RADIO_DIR/start" "$link"
    log "Terminal command: $link"

    mapfile -t slots < <(slot_names)
    mkdir -p "$DESKTOP_DIR" "$APPS_DIR"
    if ((${#slots[@]})); then
        for slot in "${slots[@]}"; do
            ensure_desktop "$DESKTOP_DIR/freedv-radio-$RADIO-$slot.desktop" \
                "$(icon_name "$RADIO_LABEL" "$slot")" "$RADIO_DIR/start --slot $slot" "$slot"
        done
    else
        ensure_desktop "$DESKTOP_DIR/freedv-radio-$RADIO.desktop" \
            "$(icon_name "$RADIO_LABEL" "")" "$RADIO_DIR/start" ""
    fi
    rename_other_icons
    command -v update-desktop-database &>/dev/null && update-desktop-database "$APPS_DIR" 2>/dev/null

    # pw-link-ls: lists the current links, e.g. for checking by hand
    if [[ -f $SCRIPT_DIR/pw-link-ls ]]; then
        mkdir -p "$LOCAL_BIN"
        install -m 755 "$SCRIPT_DIR/pw-link-ls" "$LOCAL_BIN/pw-link-ls"
    fi
}

finish() {
    heading "Writing files for radio $RADIO_LABEL"
    write_links
    write_freedv_conf
    write_start_script
    write_launchers
    say "Saved for $RADIO_LABEL: the sound links ($(grep -c . "$RADIO_DIR/links" 2>/dev/null)), FreeDV settings, start script and"
    say "$(icons_text). Details are in the log."
    if ((${#MISSING_NODES[@]})); then
        warn "These sound devices weren't there, so they have no links yet:"
        printf '   %s\n' "${MISSING_NODES[@]}"
        say "Plug them in, then start the radio with:  $RADIO_DIR/start --links"
        say "then make the missing links in qpwgraph and press Enter in the terminal to save them."
    fi
}

test_sound() {
