# Set up the sound, let the user fix the routing in qpwgraph, then save it
edit_links() {
    heading "Fixing the sound links in qpwgraph"
    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: not running the sound setup)"
        return
    fi
    say "This restarts the sound system briefly and sets up this radio's links, without"
    say "starting FreeDV, then opens qpwgraph. Fix the routing there, then come back"
    say "here to save it."
    run_start --links
}

# run_start --test|--links: runs the radio's start script for the sound only
run_start() {
    # The sound system restarts, which would cut off a running FreeDV
    while pgrep -x freedv >/dev/null; do
        warn "FreeDV is running. The sound system can't be restarted while it runs."
        pause "Please close FreeDV, then press Enter... "
    done
    # Refresh the start script from this radio's settings, so the test is the
    # current one (nothing else - cards, links, FreeDV settings - is changed)
    write_start_script
    log "\n\$ $RADIO_DIR/start $1"
    "$RADIO_DIR/start" "$1" 2>&1 | tee -a "$LOGFILE" >&3
}

# System details at the top of the log, for bug reports
log_header() {
    {
        echo "freedv-rade-setup $FRS_VERSION"
        echo "Started: $(date)"
        echo "Options: $FRS_ARGS"
        echo "Script: $SCRIPT_DIR ($(git -C "$SCRIPT_DIR" log -1 --format='%h %cd' --date=short 2>/dev/null || echo 'not a git clone'))"
        echo "freedv-rade-build: $(git -C "$RUN_DIR" log -1 --format='%h %cd %s' --date=short 2>/dev/null || echo 'not found')"
        echo "Kernel: $(uname -r)"
        echo
        cat /etc/os-release
        echo
        locale
        echo
        LC_ALL=C timeout 5 pactl info 2>&1 | grep -E 'Server (Name|Version)|Default S'
        pipewire --version 2>&1
        wireplumber --version 2>&1
        echo "=========================================================="
    } >> "$LOGFILE" 2>&1
}

##################### main #####################

. /etc/os-release
log_header
[[ -t 3 ]] && clear >&3 2>/dev/null
say "**************** Welcome to freedv-rade-setup ****************"
say "Version $FRS_VERSION"
[[ -n $TEST_ROOT ]] && say "\nTEST MODE: files go under $TEST_ROOT"
say "\nIf you're not sure about a question, press Enter for the recommended answer."
screen "(Full details of each step go to $LOGFILE)"

RT_REBOOT=${FRS_RT_REBOOT:-0}
preflight
((CHECK_ONLY)) && { say "System checks finished."; rt_reboot_note; exit 0; }

mkdir -p "$SETUP_ROOT"
mapfile -t radios < <(find "$SETUP_ROOT" -mindepth 2 -maxdepth 2 -name start -printf '%h\n' 2>/dev/null | xargs -r -n1 basename | sort)

RADIO=""
if ((${#radios[@]})); then
    if ((${#radios[@]} <= 8)); then
        # single key, like the other menus. Enter picks the radio set up or
        # changed most recently, as a re-run is usually for the same radio.
        last=$(find "$SETUP_ROOT" -mindepth 2 -maxdepth 2 -name start -printf '%T@ %h\n' 2>/dev/null \
            | sort -n | tail -1 | xargs -r basename)
        def=2
        say "  1) Set up a new radio"
        for ((i=0; i<${#radios[@]}; i++)); do
            say "  $((i+2))) Test or edit the $(radio_label "${radios[i]}") setup"
            [[ ${radios[i]} == "$last" ]] && def=$((i+2))
        done
        hint="$def"; keys=("$def")
        for ((i=1; i<=${#radios[@]}+1; i++)); do
            ((i == def)) && continue
            hint+="/$i"; keys+=("$i")
        done
        confirm "What would you like to do?" "[$hint]" "${keys[@]}"
        CHOICE=${keys[$?]}
    else
        items=("Set up a new radio")
        for r in "${radios[@]}"; do items+=("Test or edit the $(radio_label "$r") setup"); done
        choose "What would you like to do?" 1 "${items[@]}"
    fi
    ((CHOICE > 1)) && RADIO=${radios[CHOICE-2]}
fi

if [[ -z $RADIO ]]; then
    heading "New radio"
    while true; do
        ask "A short name for this radio (e.g. IC-7300, TS-450S)" ""
        RADIO=$(tr 'A-Z' 'a-z' <<<"$REPLY" | tr -c 'a-z0-9-\n' '-' | sed 's/^-*//;s/-*$//')
        [[ -n $RADIO ]] || continue
        # shown as typed (e.g. TS450S); the id above names files and nodes
        RADIO_LABEL=${REPLY#"${REPLY%%[![:space:]]*}"}
        RADIO_LABEL=${RADIO_LABEL%"${RADIO_LABEL##*[![:space:]]}"}
        [[ -e $SETUP_ROOT/$RADIO/start ]] && { say "There is already a radio called $RADIO."; continue; }
        # a folder without a start script is left from a run that was stopped part way
        if [[ -f $SETUP_ROOT/$RADIO/progress ]]; then
            say "(Carrying on with the setup of $RADIO that was stopped before: the answers"
            say " already given are offered again.)"
        elif [[ -d $SETUP_ROOT/$RADIO ]]; then
            say "(Finishing the setup of $RADIO that was stopped before.)"
        fi
        break
    done
    RADIO_DIR="$SETUP_ROOT/$RADIO"
    mkdir -p "$RADIO_DIR"
    BPF=none; MONITOR=none; RIG_MODE=none; RADIO_APP=""
    NEW_RADIO=1
    STEPS_DONE=""
    if [[ -f $RADIO_DIR/progress ]]; then
        # Keep the paths found by this run's checks, and the name as typed
        _rigctl=$RIGCTL_BIN; _rigctld=$RIGCTLD_BIN; _fdv=$FREEDV_DIR; _qpw=$QPWGRAPH_CMD; _label=$RADIO_LABEL
        load_settings "$RADIO_DIR/progress"
        source <(grep -E '^(STEPS_DONE|RADIO_SERIAL)=' "$RADIO_DIR/progress")
        RIGCTL_BIN=$_rigctl; RIGCTLD_BIN=$_rigctld; FREEDV_DIR=$_fdv
        QPWGRAPH_CMD=${_qpw:-$QPWGRAPH_CMD}; RADIO_LABEL=$_label
        log "Resuming $RADIO: steps done:$STEPS_DONE"
    fi
    if ! setup_step radio radio_audio_step; then
        # (card names belong to the USB socket and may be shared, so they stay)
        rm -rf "$RADIO_DIR"
        die "No radio sound card - nothing written. Run freedv-rade-setup again to retry."
    fi
    setup_step headset headset_step
    setup_step rig rig_step
    setup_step bpf bpf_step
    panadapter_step
    finish
    rm -f "$RADIO_DIR/progress"
    test_sound
else
    RADIO_DIR="$SETUP_ROOT/$RADIO"
    # Keep the paths found by this run's checks
    _rigctl=$RIGCTL_BIN; _rigctld=$RIGCTLD_BIN; _fdv=$FREEDV_DIR; _qpw=$QPWGRAPH_CMD
    load_settings "$RADIO_DIR/start"
    RADIO_LABEL=${RADIO_LABEL:-${RADIO^^}}   # radios made before labels existed
    RIGCTL_BIN=${_rigctl:-$RIGCTL_BIN}; RIGCTLD_BIN=${_rigctld:-$RIGCTLD_BIN}; FREEDV_DIR=$_fdv
    # a saved path may be from another computer or user, or no longer work
    runs "$RIGCTL_BIN" || RIGCTL_BIN=""
    runs "$RIGCTLD_BIN" || RIGCTLD_BIN=""
    QPWGRAPH_CMD=${_qpw:-$QPWGRAPH_CMD}
    while true; do
        heading "Radio $RADIO_LABEL"
        say "  (T)est the sound setup"
        say "  Redo the (R)adio sound card"
        say "  Redo the (M)icrophone, headphones and speakers"
        say "  Redo rig (C)ontrol"
        say "  Change the band-pass (F)ilter"
        [[ -n $(kiwi_hooks_dir) ]] && say "  KiwiSDR (P)anadapter with FreeDV, on or off"
        say "  Fix the sound links in qpwgraph and (S)ave them"
        say "  Re(W)rite the start script only (desktop icons are kept)"
        say "  (Q)uit"
        confirm "What would you like to do?" "[T/r/m/c/f/p/s/w/q]" "Tt" "Rr" "Mm" "Cc" "Ff" "Pp" "Ss" "Ww" "Qq"
        CHOICE=$(($? + 1))
        case $CHOICE in
            1) test_sound ;;
            2) kind_was=$RADIO_KIND
               if radio_audio_step; then
                   # to or from receive only: rig control, filter and panadapter change with it
                   if [[ $kind_was != "$RADIO_KIND" && ( $kind_was == none || $RADIO_KIND == none ) ]]; then
                       rig_step; bpf_step; panadapter_step
                   fi
                   finish
               fi ;;
            3) headset_step; finish ;;
            4) rig_step; finish ;;
            5) bpf_step; finish ;;
            6) panadapter_step ;;
            7) edit_links ;;
            8) write_start_script; write_launchers
               ok "Rewrote the start script; $(icons_text) checked"
               sleep 1.5 ;;   # the menu redraw would hide it at once
            9) break ;;
        esac
    done
fi

say "\nAll done. Start FreeDV for this radio with $(icons_text),"
if [[ -n $(slot_names) ]]; then
    say "or in a terminal with:  ~/freedv-radio-$RADIO --slot NAME"
else
    say "or in a terminal with:  ~/freedv-radio-$RADIO"
fi
rt_reboot_note
