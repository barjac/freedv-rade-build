#!/bin/bash
#set -x

# freedv-rade-setup
#
# Interactive sound and rig-control setup for FreeDV RADE installed with
# freedv-rade-build. For one radio it:
#   - finds the radio's USB sound card (and CAT serial port) by asking you to
#     plug it in, and gives it a fixed name with a WirePlumber rule
#   - does the same for a USB headset, or lets you pick a microphone/speakers
#   - sets up hamlib rigctld (or uses one that is already running)
#   - optionally builds the transmit band-pass filter (bpf)
#   - writes a start script, links file and FreeDV config for that radio
#
# Everything for a radio lives in ~/.config/freedv-rade-setup/<radio>/.
# It never changes ~/freedv-start, ~/.freedv or any other existing script.
#
# Options:
#   --check            only run the system checks (any fix they offer, such as
#                      the PipeWire switch, still asks first), then stop
#   --test-root DIR    write all files under DIR instead of your home folder,
#                      and don't restart sound services or run anything as root
#   --verbose          show the output of every command as it runs
#
# The screen only shows the script's own messages and questions. Everything,
# including the full output of each command, goes to freedv-rade-setup.log
# in the freedv-rade-build folder (the previous run's log is kept as .log.1).

FRS_VERSION="0.3 (test version)"

# Check we are not root
((UID)) || { echo "ERROR: You must NOT run $0 as root - aborting!"; exit 1; }

user="$(id -un)"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RUN_DIR="$HOME/freedv-rade-build"

usage() {
    echo "Usage: $(basename "$0") [--check] [--test-root DIR] [--verbose]"
}

FRS_ARGS="$*"
TEST_ROOT=""
CHECK_ONLY=0
APT_LISTS_FRESH=0
NEW_RADIO=0
VERBOSE=0
while (($#)); do
    case $1 in
        --check) CHECK_ONLY=1 ;;
        --verbose) VERBOSE=1 ;;
        --test-root)
            [[ -n $2 ]] || { usage; exit 1; }
            TEST_ROOT=$(readlink -m "$2"); shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
    shift
done

# Real config dir, always used for reading existing WirePlumber rules
REAL_CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

if [[ -n $TEST_ROOT ]]; then
    CFG_HOME="$TEST_ROOT/.config"
    LOCAL_BIN="$TEST_ROOT/.local/bin"
    APPS_DIR="$TEST_ROOT/.local/share/applications"
    DESKTOP_DIR="$TEST_ROOT/Desktop"
    LINK_DIR="$TEST_ROOT"
else
    CFG_HOME="$REAL_CFG"
    LOCAL_BIN="$HOME/.local/bin"
    APPS_DIR="$HOME/.local/share/applications"
    DESKTOP_DIR="$(xdg-user-dir DESKTOP 2>/dev/null)"
    [[ -n $DESKTOP_DIR ]] || DESKTOP_DIR="$HOME/Desktop"
    LINK_DIR="$HOME"
fi
SETUP_ROOT="$CFG_HOME/freedv-rade-setup"
WP_CONF_DIR="$CFG_HOME/wireplumber/wireplumber.conf.d"
WP_LUA_DIR="$CFG_HOME/wireplumber/main.lua.d"

# The 4 null sinks the start script creates (fixed names, used in freedv.conf)
FDV_SINKS=(FDV_RX_in FDV_RX_out FDV_TX_in FDV_TX_out)

# Settings saved at the top of each radio's start script
SETTINGS_VARS=(RADIO RADIO_LABEL FREEDV_DIR RADIO_KIND RADIO_APP RADIO_CARD RADIO_CARD_ID RADIO_RX_NODE RADIO_TX_NODE
               MIC_NODE MIC_CARD_ID PHONES_NODE SPEAKER_NODE MONITOR
               RIG_MODE RIG_MODEL RIG_MODEL_NAME RIG_PORT RIG_SETCONF RIG_LISTEN RIG_HOST
               RIGCTL_BIN RIGCTLD_BIN BPF BPF_BIN QPWGRAPH_CMD)

##################### log #####################

# The log sits next to the script, like freedv-rade-build's and
# freedv-rade-update's. The previous run's log is kept as .log.1.
if [[ -n $TEST_ROOT ]]; then
    mkdir -p "$TEST_ROOT"
    LOGFILE="$TEST_ROOT/freedv-rade-setup.log"
elif [[ -d $RUN_DIR ]]; then
    LOGFILE="$RUN_DIR/freedv-rade-setup.log"
else
    LOGFILE="$HOME/freedv-rade-setup.log"
fi
[[ -f $LOGFILE ]] && mv -f "$LOGFILE" "$LOGFILE.1"
: > "$LOGFILE" || { echo "ERROR: Can't write the log file $LOGFILE"; exit 1; }

# fd 3 is the terminal. Normal output (any command's stdout/stderr) goes to
# the log only, or to both with --verbose. The script's own messages and
# questions are written to the terminal and the log separately (say, ask ...).
exec 3>&1
if ((VERBOSE)); then
    exec > >(tee -a "$LOGFILE" >&3) 2>&1
else
    exec >>"$LOGFILE" 2>&1
fi

# The reminder to reboot (rt_reboot_note) shows however the setup ends, even
# on Ctrl+C. Started from freedv-rade-update's (A): its desktop icon's terminal
# window closes as soon as this script ends, so wait first (however it ends).
if [[ -n $FRS_PAUSE_AT_END ]] && [[ -c /dev/tty ]]; then
    trap 'rt_reboot_note; printf "\n" >&3; read -r -p "Press Enter to close this window. " _ </dev/tty 2>&3' EXIT
else
    trap 'rt_reboot_note' EXIT
fi

##################### user interface helpers #####################

log()    { printf '%b\n' "$*" >> "$LOGFILE"; }
screen() { printf '%b\n' "$*" >&3; }
# GAP=1 when the last line on screen was blank, so headings don't add another
say() {
    local m="$*"
    # don't stack a second blank line on one already there
    ((GAP)) && [[ $m == '\n'* ]] && m=${m#'\n'}
    screen "$m"; log "$m"
    [[ -z $m || $m == *'\n' ]] && GAP=1 || GAP=0
}
ok()   { say "  OK    $*"; }
warn() { say "WARNING: $*"; }
die()  { say "\nERROR: $*"; rt_reboot_note; screen "\nFull details are in $LOGFILE"; exit 1; }
# rt_reboot_note -> the reminder to reboot, at the end, after rt_check added
# the user to the pipewire group (here or in freedv-rade-update)
rt_reboot_note() {
    ((${RT_REBOOT:-0})) || return 0
    GAP=0   # always a blank line first, even straight after a prompt
    say "\n####  For realtime audio, $USER is now in the pipewire group: please reboot before using FreeDV  ####"
    RT_REBOOT=0
}
heading() { ((GAP)) || say ""; say "==================== $* ====================\n"; }

# sound_stuck -> names of sound server processes stuck waiting on a device
sound_stuck() {
    local p stuck=""
    for p in $(pgrep -u "$USER" -x 'pipewire|pipewire-pulse|wireplumber|pulseaudio'); do
        [[ $(awk '{print $3}' "/proc/$p/stat" 2>/dev/null) == D ]] && stuck+=" $(cat "/proc/$p/comm")"
    done
    echo "$stuck"
}
# no_sound_server -> true when neither PipeWire nor PulseAudio is running
no_sound_server() {
    ! systemctl --user is-active --quiet pipewire pipewire-pulse 2>/dev/null \
        && ! systemctl --user is-active --quiet pulseaudio 2>/dev/null
}

# Why 'pactl info' failed, and what to do about it
sound_server_help() {
    local stuck
    stuck=$(sound_stuck)
    log "sound server processes: $(pgrep -u "$USER" -a 'pipewire|wireplumber|pulseaudio' | tr '\n' ';') stuck:${stuck:-none}"
    say ""
    if [[ -n $stuck ]]; then
        say "The sound server is stuck ($stuck ), waiting for a USB sound device that"
        say "was removed while it was in use - for example unplugged, or taken over by"
        say "another program or a virtual machine. It can't be restarted like this."
        say "Please REBOOT, then run freedv-rade-setup again."
    elif no_sound_server; then
        say "The sound server isn't running. Start it with:"
        say "    systemctl --user restart pipewire pipewire-pulse wireplumber"
        say "(or log out and in again), then run freedv-rade-setup again."
    else
        say "The sound server is running but not answering. Try restarting it:"
        say "    systemctl --user restart pipewire pipewire-pulse wireplumber"
        say "If that hangs or doesn't help, reboot, then run freedv-rade-setup again."
    fi
}

# Keyboard input ended (Ctrl+D, or not run from a terminal)
no_input() { screen ""; die "No more keyboard input - stopping."; }

# pause [PROMPT] -> waits for Enter
pause() {
    local prompt=${1:-"Press Enter to continue... "}
    read -e -r -p "$prompt" 2>&3 || no_input
    log "$prompt<Enter>"
    say ""
}

# ask PROMPT DEFAULT -> REPLY (Enter gives DEFAULT)
ask() {
    local prompt=$1 def=$2
    if [[ -n $def ]]; then
        read -e -r -p "$prompt [$def]: " REPLY 2>&3 || no_input
    else
        read -e -r -p "$prompt: " REPLY 2>&3 || no_input
    fi
    [[ -z $REPLY ]] && REPLY=$def
    log "$prompt -> '$REPLY'"
    say ""
}

# confirm PROMPT HINT CHARS... -> returns 0 for the first CHARS, 1 for the
# second and so on. Enter gives the first letter of HINT. Same as
# freedv-rade-update's confirm(), but takes any number of choices, and logs
# the answer instead of echoing it.
#   e.g.  confirm "(U)pdate, (F)ull re-build or (Q)uit?" "[U/F/Q]" "Uu" "Ff" "Qq"
confirm() {
    local -a params=( "$@" )
    local ans i
    while true; do
        ans=
        read -e -r -p "${params[0]} ${params[1]} " ans 2>&3 || no_input
        # Get first option if ans is empty
        ans=${ans:-$(echo "${params[1]}" | cut -b 2)}
        log "${params[0]} ${params[1]} -> $ans"
        for ((i=2; i<${#params[@]}; i++)); do
            [[ -n $ans && $ans == [${params[i]}] ]] && { say ""; return $((i-2)); }
        done
    done
}

# yesno PROMPT DEFAULT(y|n) -> returns 0 for yes
yesno() {
    if [[ ${2:-y} == n ]]; then
        confirm "$1" "[N/y]" "yY" "nN"
    else
        confirm "$1" "[Y/n]" "Yy" "Nn"
    fi
}

# choose PROMPT DEFAULT ITEM... -> CHOICE (number), CHOICE_TEXT
# For lists that vary in length (sound cards, ports...). Fixed menus use
# confirm. The recommended item is listed first and is the default.
choose() {
    local prompt=$1 def=$2 i n
    shift 2
    n=$#
    for ((i=1; i<=n; i++)); do
        say "$(printf '  %2d) %s' "$i" "${!i}")"
    done
    while true; do
        read -e -r -p "$prompt [$def] " CHOICE 2>&3 || no_input
        CHOICE=${CHOICE:-$def}
        log "$prompt [$def] -> $CHOICE"
        if [[ $CHOICE =~ ^[0-9]+$ ]] && ((CHOICE >= 1 && CHOICE <= n)); then
            CHOICE_TEXT=${!CHOICE}
            say ""
            return 0
        fi
        screen "Please enter a number from 1 to $n."
    done
}

##################### running commands #####################

# spin PID DESC -> waits for PID, showing "DESC ... |/-\" meanwhile
spin() {
    local pid=$1 desc=$2 i=0 s='|/-\'
    if [[ -t 3 ]]; then
        while kill -0 "$pid" 2>/dev/null; do
            printf '\r%s ... %s' "$desc" "${s:i++%4:1}" >&3
            sleep 0.2
        done
        printf '\r\033[K' >&3
    fi
    wait "$pid"
}

# show_failure DESC FILE -> the end of a failed command's output
show_failure() {
    say "FAILED: $1"
    [[ -s $2 ]] && tail -n 10 "$2" | sed 's/^/    /' >&3
    screen "  Full details are in $LOGFILE"
}

# run_quiet DESC COMMAND... -> runs COMMAND with its output in the log only,
# showing a spinner meanwhile, then "OK DESC" or the end of the output.
run_quiet() {
    local desc=$1 rc tmp
    shift
    log "\n\$ $*"
    if ((VERBOSE)); then
        "$@"
        rc=$?
        ((rc)) && show_failure "$desc" "" || ok "$desc"
        return $rc
    fi
    tmp=$(mktemp)
    "$@" > "$tmp" 2>&1 < /dev/null &
    spin $! "$desc"
    rc=$?
    cat "$tmp" >> "$LOGFILE"
    ((rc)) && show_failure "$desc" "$tmp" || ok "$desc"
    rm -f "$tmp"
    return $rc
}

# get_root -> sets ROOT_VIA (sudo or su), asking for the password now (in
# the open, before any spinner or progress bar) if sudo needs one
get_root() {
    [[ -n $ROOT_VIA ]] && { [[ $ROOT_VIA == su ]] || sudo -n true 2>/dev/null || sudo -v 2>&3; return; }
    if command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null || sudo -v 2>&3; then
            ROOT_VIA=sudo
            log "Running as root via sudo"
            return 0
        fi
    fi
    if command -v su >/dev/null 2>&1; then
        ROOT_VIA=su
        log "Running as root via su"
        return 0
    fi
    say "Unable to gain root access via sudo or su."
    return 1
}

# run_as_root COMMAND -> runs COMMAND (a string) as root, output to the log
run_as_root() {
    if [ $# -eq 0 ]; then
        echo "run_as_root: No command provided." >&2
        return 1
    fi

    local CMD="$*"

    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: would run as root: $CMD)"
        return 0
    fi

    get_root || return 1
    log "\n# as root: $CMD"
    if [[ $ROOT_VIA == sudo ]]; then
        sudo bash -c "$CMD"
    else
        screen "The root password is needed:"
        su -c "$CMD" 2>&3
    fi
}

# root_quiet DESC COMMAND -> run_as_root with a spinner, like run_quiet
root_quiet() {
    local desc=$1 cmd=$2
    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: would run as root: $cmd)"
        return 0
    fi
    get_root || return 1
    if [[ $ROOT_VIA == sudo ]]; then
        run_quiet "$desc" sudo -n bash -c "$cmd"
    else
        say "$desc ..."
        run_as_root "$cmd" && ok "$desc" || { show_failure "$desc" ""; return 1; }
    fi
}

# apt_quiet DESC APT-GET-ARGS -> apt-get as root with a progress bar
# Never stops to ask about changed config files (keeps the user's version),
# and waits for another apt (e.g. the update manager) to finish first.
apt_quiet() {
    local desc=$1 args=$2 cmd rc
    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: would run as root: apt-get $args)"
        return 0
    fi
    get_root || return 1
    # refresh the package lists once per run before the first install, so an
    # old list doesn't ask for package versions the mirror no longer has
    if [[ $args == install* ]] && ! ((APT_LISTS_FRESH)); then
        root_quiet "Refreshing the package lists" \
            "apt-get -o DPkg::Lock::Timeout=300 update" \
            || warn "Couldn't refresh the package lists - trying the install anyway."
        APT_LISTS_FRESH=1
    fi
    cmd="DEBIAN_FRONTEND=noninteractive apt-get -y -o DPkg::Lock::Timeout=300"
    cmd+=" -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
    if ((VERBOSE)); then
        log "\n# as root: apt-get $args"
        run_as_root "$cmd $args"
        rc=$?
        ((rc)) && show_failure "$desc" "" || ok "$desc"
        return $rc
    fi
    # apt reports its progress on fd 3, its normal output goes to the log
    cmd+=" -o APT::Status-Fd=3 $args 3>&1 >>'$LOGFILE' 2>&1"
    log "\n# as root: apt-get $args"
    screen "$desc ..."
    if [[ $ROOT_VIA == sudo ]]; then
        sudo -n bash -c "$cmd" | apt_bar "$desc"
    else
        screen "The root password is needed:"
        su -c "$cmd" 2>&3 | apt_bar "$desc"
    fi
    rc=${PIPESTATUS[0]}
    # Replace the "DESC ..." line (after su's password prompt it isn't the line above)
    [[ -t 3 && $ROOT_VIA == sudo ]] && printf '\033[1A\r\033[K' >&3
    if ((rc)); then
        show_failure "$desc" ""
        tail -n 10 "$LOGFILE" | sed 's/^/    /' >&3
    else
        ok "$desc"
    fi
    return $rc
}

# apt_bar DESC -> draws a progress bar from apt's status lines on stdin
apt_bar() {
    local desc=$1 line phase p f i bar
    local -a fld
    while IFS= read -r line; do
        IFS=: read -r -a fld <<<"$line"
        case ${fld[0]} in
            dlstatus) phase="downloading" ;;
            pmstatus) phase="installing" ;;
            *) continue ;;
        esac
        # The percentage is the first number after the package name
        p=""
        for ((i=2; i<${#fld[@]}; i++)); do
            [[ ${fld[i]} =~ ^[0-9]+(\.[0-9]+)?$ ]] && { p=${fld[i]%%.*}; break; }
        done
        [[ -n $p ]] || continue
        ((p > 100)) && p=100
        f=$((p / 5))
        printf -v bar '%*s' "$f" ''
        bar=${bar// /#}
        printf -v bar '%-20s' "$bar"
        [[ -t 3 ]] && printf '\r\033[K  %s: %-11s [%s] %3d%%' "$desc" "$phase" "${bar// /-}" "$p" >&3
    done
    [[ -t 3 ]] && printf '\r\033[K' >&3
}

# Print the install command for this distro, or nothing if unknown
pkg_install_cmd() {
    case " $ID $ID_LIKE " in
        *" mageia "*)                 echo "urpmi --auto $*" ;;
        *" fedora "*)                 echo "dnf install -y $*" ;;
        *" opensuse"*|*" suse "*)     echo "zypper --non-interactive in $*" ;;
        *" arch "*)                   echo "pacman -S --needed --noconfirm $*" ;;
        *" pclinuxos "*)              echo "apt-get install -y $*" ;;
        *" debian "*|*" ubuntu "*)    echo "apt-get install -y $*" ;;
        *)                            echo "" ;;
    esac
}

is_apt_distro() { [[ " $ID $ID_LIKE " == *" debian "* || " $ID $ID_LIKE " == *" ubuntu "* || " $ID $ID_LIKE " == *" pclinuxos "* ]]; }

# pkg_available PACKAGE -> 0 if the distro's repos have it (only checked
# where apt can tell us; elsewhere assumed yes)
pkg_available() {
    local cand
    is_apt_distro || return 0
    cand=$(LC_ALL=C apt-cache policy "$1" 2>/dev/null | sed -n 's/^ *Candidate: //p')
    [[ -n $cand && $cand != "(none)" ]]
}

# offer_install PACKAGE WHY -> 0 if installed
offer_install() {
    local pkg=$1 why=$2 cmd
    cmd=$(pkg_install_cmd "$pkg")
    if [[ -z $cmd ]]; then
        say "Please install the '$pkg' package with your package manager ($why)."
        return 1
    fi
    yesno "Install $pkg now ($why)?" y || return 1
    if is_apt_distro; then
        apt_quiet "Installing $pkg" "install $pkg"
    else
        root_quiet "Installing $pkg" "$cmd"
    fi
}

# The package with hamlib's rigctl and rigctld
hamlib_pkg() {
    if is_apt_distro; then
        echo libhamlib-utils
    else
        case " $ID $ID_LIKE " in
            *" mageia "*) echo hamlib-utils ;;
            *)            echo hamlib ;;
        esac
    fi
}

# runs PROGRAM -> 0 if it actually starts. A copy built with FreeDV can be
# there but unable to load its libraries, e.g. on a card copied to another
# user's home directory.
runs() { [[ -x $1 ]] && "$1" --version &>/dev/null; }

# find_hamlib -> sets RIGCTL_BIN and RIGCTLD_BIN: the system package, or the
# copy built with FreeDV, whichever actually runs
find_hamlib() {
    local ext="$FREEDV_DIR/freedv-gui/build_linux/external/dist/bin"
    RIGCTL_BIN=$(command -v rigctl 2>/dev/null)
    RIGCTLD_BIN=$(command -v rigctld 2>/dev/null)
    runs "$RIGCTL_BIN" || RIGCTL_BIN=""
    runs "$RIGCTLD_BIN" || RIGCTLD_BIN=""
    [[ -z $RIGCTL_BIN ]] && runs "$ext/rigctl" && RIGCTL_BIN="$ext/rigctl"
    [[ -z $RIGCTLD_BIN ]] && runs "$ext/rigctld" && RIGCTLD_BIN="$ext/rigctld"
}

# ensure_hamlib -> 0 if rigctl and rigctld are there, offering to install
# them if not
ensure_hamlib() {
    [[ -n $RIGCTL_BIN && -n $RIGCTLD_BIN ]] && return 0
    warn "hamlib's rigctl and rigctld are not installed. They are needed to talk to the radio."
    offer_install "$(hamlib_pkg)" "rig control" || return 1
    find_hamlib
    [[ -n $RIGCTL_BIN && -n $RIGCTLD_BIN ]]
}

# The package with PipeWire's ALSA plugin. Ubuntu 22.04 (and Mint 21) has
# no pipewire-alsa: the plugin is in pipewire-audio-client-libraries there.
alsa_plugin_pkg() {
    if is_apt_distro && ! pkg_available pipewire-alsa && pkg_available pipewire-audio-client-libraries; then
        echo pipewire-audio-client-libraries
    else
        echo pipewire-alsa
    fi
}

##################### PipeWire helpers #####################

list_cards()  { LC_ALL=C pactl list cards short 2>/dev/null | awk '{print $2}' | sort; }
list_serial() { ls -1 /dev/serial/by-id/ 2>/dev/null | sort; }

# serial_label PATH -> its by-id name with the device it is now, e.g.
# "usb-Silicon_Labs_..._if01-port0  (ttyUSB1)"
serial_label() {
    local dev
    dev=$(readlink -f "$1" 2>/dev/null)
    echo "${1##*/}${dev:+  (${dev##*/})}"
}

# serial_siblings PATH -> all the by-id ports of the same USB device as PATH
# (one cable can carry two or more, e.g. CAT and PTT on a TS-890 or IC-7300)
serial_siblings() {
    local base=${1##*/} p
    base=${base%-if[0-9][0-9]-port[0-9]*}
    for p in /dev/serial/by-id/*; do
        [[ -e $p && ${p##*/} == "$base"* ]] && echo "$p"
    done
}

# find_cat_port MODEL SETCONF PORT... -> FOUND_PORT: the first port that
# answers rigctl, asked for the frequency one at a time
find_cat_port() {
    local model=$1 setconf=$2 p out
    shift 2
    FOUND_PORT=""
    say "Asking each port for the radio's frequency (the radio must be ON)..."
    for p in "$@"; do
        out=$(timeout 8 "$RIGCTL_BIN" -m "$model" -r "$p" ${setconf:+--set-conf="$setconf"} f 2>/dev/null)
        if [[ $out =~ ^[0-9]+$ ]]; then
            say "  $(serial_label "$p"): answered ($out Hz)"
            FOUND_PORT=$p
            return 0
        fi
        say "  $(serial_label "$p"): no answer"
    done
    return 1
}

# card_prop CARD PROP -> property value from 'pactl list cards'
card_prop() {
    LC_ALL=C pactl list cards 2>/dev/null | awk -v card="$1" -v prop="$2" '
        /^Card #/ { incard = 0 }
        $1 == "Name:" { incard = ($2 == card) }
        incard && $1 == prop && $2 == "=" {
            sub(/^[^=]*= *"/, ""); sub(/"$/, ""); print; exit
        }'
}

card_desc() {
    local d
    d=$(card_prop "$1" device.description)
    echo "${d:-$1}"
}

# card_ident CARD -> "VENDOR:PRODUCT SERIAL" of a USB card (empty otherwise).
# The start script compares it with the card it finds in the same socket.
# card_hw CARD -> the sound card's own name (e.g. "GeneralPlus USB Audio
# Device"). The setup's names ("Radio", "Headset") belong to the USB socket,
# so they don't say which device is plugged in there now.
card_hw() {
    local h
    h=$(card_prop "$1" alsa.long_card_name)
    h=${h%% at *}
    echo "${h:-$(card_prop "$1" alsa.card_name)}"
}
# card_label CARD -> "Radio - GeneralPlus USB Audio Device  (alsa_card.frs-radio)"
card_label() {
    local d h
    d=$(card_desc "$1"); h=$(card_hw "$1")
    [[ -n $h && $h != "$d" ]] && d+=" - $h"
    echo "$d  ($1)"
}
card_ident() {
    [[ $(card_prop "$1" device.bus) == usb ]] || return 0
    echo "$(card_prop "$1" device.vendor.id):$(card_prop "$1" device.product.id) $(card_prop "$1" device.serial)"
}

# All node names that have ports
all_nodes() { { pw-link -i; pw-link -o; } 2>/dev/null | cut -d: -f1 | sort -u; }

node_exists() { all_nodes | grep -qxF -- "$1"; }

# node_ports NODE in|out -> one "node:port" per line
node_ports() {
    local flag=-i
    [[ $2 == out ]] && flag=-o
    pw-link $flag 2>/dev/null | awk -v p="$1:" 'index($0, p) == 1'
}

# resolve_node PREFERRED STEM input|output -> the node to use
# PREFERRED is the fixed name a freedv-rade-setup rule gives the node. If that
# doesn't exist (rule not active, or not ours), fall back to the node made
# from the card name: alsa_input.<stem>.<profile>
resolve_node() {
    local pref=$1 stem=$2 kind=$3
    if [[ -n $pref ]] && node_exists "$pref"; then
        echo "$pref"
        return
    fi
    all_nodes | awk -v p="alsa_${kind}.${stem}." 'index($0, p) == 1 { print; exit }'
}

# wait_node NAME SECONDS
wait_node() {
    local i
    for ((i=0; i < $2 * 5; i++)); do
        node_exists "$1" && return 0
        sleep 0.2
    done
    return 1
}

restart_wireplumber() {
    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: not restarting WirePlumber)"
        return
    fi
    run_quiet "Restarting WirePlumber so the new names take effect" \
        bash -c 'systemctl --user restart wireplumber && sleep 2'
}

# USB cards are named by socket, not by radio: the first radio socket is
# "radio" (radio-rx, radio-tx), the next "radio2" and so on; headsets the same
# (headset-mic, headset-phones, then headset2-...). Radios that share one
# interface (cables moved between radios) share its names.

# rule_files -> freedv-rade-setup's WirePlumber rule files
rule_files() {
    local f
    for f in "$WP_LUA_DIR"/60-freedv-rade-setup-*.lua "$WP_CONF_DIR"/60-freedv-rade-setup-*.conf; do
        [[ -f $f ]] && echo "$f"
    done
}

# socket_rule BUSPATH -> the rule file that names this USB socket
socket_rule() {
    local f
    while read -r f; do
        grep -qF -- "\"$1\"" "$f" && { echo "$f"; return 0; }
    done < <(rule_files)
    return 1
}

rule_id() { local id=${1##*/60-freedv-rade-setup-}; echo "${id%.*}"; }

# rule_nodes FILE -> "INPUT OUTPUT", the node names the rule gives
rule_nodes() {
    sed -n 's/.*node\.name"\{0,1\}\] = "\([^"]*\)".*/\1/p; s/^ *node\.name = "\([^~"][^"]*\)"$/\1/p' "$1" | head -2 | tr '\n' ' '
}

# free_rule_id ROLE -> radio, radio2, radio3 ... (the first one not in use)
rule_bp()   { sed -n 's/.*device\.bus-path"\{0,1\} *[,=] *\("equals", *\)\{0,1\}"\([^"]*\)".*/\2/p' "$1" | head -1; }
rule_stem() { sed -n 's/.*"alsa_card\.\([^"]*\)".*/\1/p' "$1" | head -1; }
# role_rule ROLE -> the rule file with the names this radio uses for ROLE now
# (or, for a new radio, the plain "radio" / "headset" one)
role_rule() {
    local node f
    [[ $1 == radio ]] && node=$RADIO_RX_NODE || node=$MIC_NODE_WAS
    while read -r f; do
        if [[ -n $node ]]; then
            [[ " $(rule_nodes "$f") " == *" $node "* ]] && { echo "$f"; return 0; }
        elif [[ $(rule_id "$f") == "$1" ]]; then
            echo "$f"; return 0
        fi
    done < <(rule_files)
    return 1
}
# socket_card BUS-PATH -> the card in that USB socket now, if any
socket_card() {
    local c
    for c in $(list_cards); do
        [[ $(card_prop "$c" device.bus_path) == "$1" ]] && { echo "$c"; return; }
    done
}
socket_hw() { local c; c=$(socket_card "$1") && [[ -n $c ]] && card_hw "$c"; }
# offer_swap ROLE RULE BUS-PATH -> the chosen card's socket (RULE) has the
# other role's names. When ROLE's names are on another socket, as after the
# cards were swapped round (or, in a VM, attached in the other order), offer
# to swap the two sockets' names. Sets SWAPPED_RULE to ROLE's rule.
offer_swap() {
    local role=$1 f=$2 bp=$3 t tbp hw users a b
    t=$(role_rule "$role") && [[ $t != "$f" ]] || return 1
    tbp=$(rule_bp "$t"); [[ -n $tbp && $tbp != "$bp" ]] || return 1
    hw=$(socket_hw "$tbp")
    read -r a b <<<"$(rule_nodes "$f")"
    if [[ $role == radio ]]; then
        say "This card's USB socket has the headset's names ($a, $b), and the radio's"
    else
        say "This card's USB socket has the radio's names ($a, $b), and the headset's"
    fi
    say "names ($(rule_nodes "$t" | sed 's/ $//; s/ /, /')) are on another USB socket, holding ${hw:-no card now}."
    say "If the two cards were swapped round, their names can be swapped to match."
    users=$(node_users $a $b $(rule_nodes "$t"))
    [[ -n $users ]] && say "(Radio $users uses these names too, so it follows the swap.)"
    yesno "Swap the names of the two sockets?" y || return 1
    a=$(<"$f"); b=$(<"$t")
    printf '%s\n' "${a//\"$bp\"/\"$tbp\"}" > "$f"
    printf '%s\n' "${b//\"$tbp\"/\"$bp\"}" > "$t"
    log "swapped sockets: $f -> $tbp, $t -> $bp"
    say "Swapped."
    restart_wireplumber
    read -r a b <<<"$(rule_nodes "$t")"
    wait_node "$a" 10 || wait_node "$b" 5
    # the other role's names now belong to the card in the other socket
    a=$(socket_card "$tbp"); a=${a:+$(card_ident "$a")}
    if [[ $role == radio && -n $MIC_CARD_ID ]]; then MIC_CARD_ID=$a
    elif [[ $role != radio && -n $RADIO_CARD_ID ]]; then RADIO_CARD_ID=$a; fi
    SWAPPED_RULE=$t
}
free_rule_id() {
    local n=1 id=$1
    while [[ -f $WP_LUA_DIR/60-freedv-rade-setup-$id.lua || -f $WP_CONF_DIR/60-freedv-rade-setup-$id.conf ]]; do
        id="$1$((++n))"
    done
    echo "$id"
}

# node_users NODE... -> the radios whose links use any of these nodes
node_users() {
    local d n users=()
    for d in "$SETUP_ROOT"/*/; do
        d=${d%/}; [[ -f $d/links && ${d##*/} != "$RADIO" ]] || continue
        for n in "$@"; do
            grep -qF -- "$n:" "$d/links" && { users+=("$(radio_label "${d##*/}")"); break; }
        done
    done
    local IFS=,; echo "${users[*]}" | sed "s/,/, /g"
}

# set_aside_rules ROLE CARD FILES -> 0 if the files were set aside
# Another rule (an older setup or guide) already names this card's socket.
# If its name is for the other role (e.g. "Radio Interface" on the socket
# being set up as the headset), it was probably written for different
# wiring: offer to rename the files to .disabled so the setup can name it.
set_aside_rules() {
    local role=$1 card=$2 f name def=n wrong=0 other_role=headset
    local -a files
    mapfile -t files <<<"$3"
    [[ $role == headset ]] && other_role=radio
    name="${card#alsa_card.} $(card_desc "$card")"
    say "This card already has a name, \"$(card_desc "$card")\" ($card - $(card_hw "$card")), from:"
    for f in "${files[@]}"; do say "  $f"; done
    if [[ $role == headset && ${name,,} =~ radio|rig ]] \
       || [[ $role == radio && ${name,,} =~ headset|mic|phone ]]; then
        wrong=1; def=y
        say "That is a $other_role name, but you are setting this card up as the $role:"
        say "the file was probably written for different wiring."
    fi
    for f in "${files[@]}"; do
        if [[ $f != "$REAL_CFG"/* || ! -w $f ]]; then
            ((wrong)) && say "It is a system file, so it stays. To set it aside yourself:\n  sudo mv '$f' '$f.disabled'\nthen run this step again."
            return 1
        fi
    done
    say "Setting it aside renames it to .disabled (nothing is deleted). Any other"
    say "cards it names get their normal names back, and anything that still uses"
    say "the old names (an older start script, for example) will need the new ones."
    yesno "Set it aside and give this card the setup's own name?" "$def" || return 1
    for f in "${files[@]}"; do
        mv -f -- "$f" "$f.disabled" || { warn "Couldn't rename $f"; return 1; }
        say "Renamed: $f.disabled"
        log "Set aside $f (named this card $card)"
    done
    return 0
}

# Files outside freedv-rade-setup's own that mention this bus path
existing_rule_for() {
    # only files WirePlumber reads (not ones set aside as .disabled)
    grep -rlsF -- "$1" "$REAL_CFG/wireplumber" /etc/wireplumber 2>/dev/null \
        | grep -E '\.(conf|lua)$' | grep -v 'freedv-rade-setup-'
}

# write_wp_rule FILEID BUSPATH STEM DESC IN_NODE OUT_NODE
# Names the card alsa_card.STEM and its input/output nodes IN_NODE/OUT_NODE.
write_wp_rule() {
    local id=$1 bp=$2 stem=$3 desc=$4 in_node=$5 out_node=$6 f
    if ((WP_LUA)); then
        mkdir -p "$WP_LUA_DIR"
        f="$WP_LUA_DIR/60-freedv-rade-setup-$id.lua"
        cat > "$f" <<EOF
-- Written by freedv-rade-setup. Re-run freedv-rade-setup to change it.
table.insert(alsa_monitor.rules, {
  matches = { { { "device.bus-path", "equals", "$bp" } } },
  apply_properties = {
    ["device.name"] = "alsa_card.$stem",
    ["device.description"] = "$desc",
  },
})
table.insert(alsa_monitor.rules, {
  matches = { { { "node.name", "matches", "alsa_input.$stem.*" } } },
  apply_properties = { ["node.name"] = "$in_node", ["node.description"] = "$desc input" },
})
table.insert(alsa_monitor.rules, {
  matches = { { { "node.name", "matches", "alsa_output.$stem.*" } } },
  apply_properties = { ["node.name"] = "$out_node", ["node.description"] = "$desc output" },
})
EOF
    else
        mkdir -p "$WP_CONF_DIR"
        f="$WP_CONF_DIR/60-freedv-rade-setup-$id.conf"
        cat > "$f" <<EOF
# Written by freedv-rade-setup. Re-run freedv-rade-setup to change it.
monitor.alsa.rules = [
  {
    matches = [ { device.bus-path = "$bp" } ]
    actions = {
      update-props = {
        device.name = "alsa_card.$stem"
        device.description = "$desc"
      }
    }
  }
  {
    matches = [ { node.name = "~alsa_input.$stem.*" } ]
    actions = {
      update-props = {
        node.name = "$in_node"
        node.description = "$desc input"
      }
    }
  }
  {
    matches = [ { node.name = "~alsa_output.$stem.*" } ]
    actions = {
      update-props = {
        node.name = "$out_node"
        node.description = "$desc output"
      }
    }
  }
]
EOF
    fi
    say "Wrote $f"
}

##################### system checks #####################

# Realtime priority for the sound server: PipeWire's limits file gives it to
# the pipewire group. freedv-rade-build adds the user to that group now, but
# older installs may not have it, and then a restarted PipeWire (the start
# scripts restart it) can run without realtime priority, so the transmit
# audio has gaps when the computer is busy. Offer to add the user.
rt_check() {
    local have
    have=$(ulimit -r)
    if [[ $have == unlimited ]] || ((have >= 11)); then
        ok "Realtime priority for the sound server (limit $have)"
        return
    fi
    log "realtime limit $have; groups: $(id -nG)"
    if ! awk '$1 == "@pipewire" && $3 == "rtprio"' /etc/security/limits.conf /etc/security/limits.d/*.conf 2>/dev/null | grep -q . \
       || ! getent group pipewire >/dev/null; then
        warn "The sound server does not have realtime priority, so the transmit"
        say "  audio may have gaps when the computer is busy. This system has no"
        say "  pipewire group with realtime priority in /etc/security/limits.d."
        return
    fi
    if id -nG "$USER" | tr ' ' '\n' | grep -qxF pipewire; then
        ok "In the pipewire group, for realtime priority (after a reboot)"
        RT_REBOOT=1
        return
    fi
    say "The sound server does not have realtime priority, so the transmit audio"
    say "can have gaps when the computer is busy. That needs you in the pipewire group."
    if yesno "Add $USER to the pipewire group now (recommended)?" y \
       && root_quiet "Adding $USER to the pipewire group" "PATH=/usr/sbin:/sbin:\$PATH usermod -aG pipewire '$USER'"; then
        RT_REBOOT=1
    else
        warn "No realtime priority for the sound server: the transmit audio may have gaps."
    fi
}

preflight() {
    heading "Checking all needed system components are present"

    # freedv-rade-build and a FreeDV build
    [[ -d $RUN_DIR/.git ]] || die "freedv-rade-build was not found in $RUN_DIR.\nPlease install FreeDV with freedv-rade-build first."
    local basedir=$HOME
    if [[ -f $HOME/.freedv-rade-build.cfg ]] && grep -v '^#' "$HOME/.freedv-rade-build.cfg" | grep -q 'basedir='; then
        basedir=$(grep -v '^#' "$HOME/.freedv-rade-build.cfg" | grep 'basedir=' | cut -d= -f2)
    fi
    FREEDV_DIR="$basedir/freedv-rade"
    [[ -x $FREEDV_DIR/freedv-gui/build_linux/src/freedv ]] \
        || die "No FreeDV build was found in $FREEDV_DIR.\nPlease run freedv-rade-build first."
    ok "FreeDV build found in $FREEDV_DIR"

    # systemd
    if [[ ! -d /run/systemd/system ]] || ! systemctl --user show-environment &>/dev/null; then
        die "This system does not use systemd (or has no systemd user session).\nfreedv-rade-setup only supports systemd systems for now, sorry."
    fi
    ok "systemd"

    # Sound tools
    command -v pactl &>/dev/null || die "'pactl' was not found. Please install your distro's pulseaudio-utils package (or libpulse on Arch)."
    # PipeWire with its PulseAudio layer
    local server
    server=$(LC_ALL=C timeout 10 pactl info 2>/dev/null | sed -n 's/^Server Name: //p')
    if [[ $server == *PipeWire* ]]; then
        ok "PipeWire with PulseAudio compatibility ($server)"
    elif [[ -n $server ]]; then
        offer_pipewire_switch "$server"
        exit 0
    else
        # Nothing running at all (e.g. switched off by hand, or units left
        # masked): on Debian/Ubuntu the switch below sets PipeWire up
        if is_apt_distro && [[ -z $(sound_stuck) ]] && no_sound_server; then
            log "no sound server running: $(systemctl --user list-unit-files 2>/dev/null | grep -E 'pipewire|pulse|wireplumber' | tr -s ' ' | tr '\n' ';')"
            offer_pipewire_switch ""
            exit 0
        fi
        sound_server_help
        die "Could not contact the sound server ('pactl info' failed)."
    fi
    local c
    for c in pw-link wpctl; do
        command -v $c &>/dev/null || die "'$c' was not found. Please install your distro's pipewire tools package."
    done

    # WirePlumber and its config format
    systemctl --user is-active --quiet wireplumber \
        || die "WirePlumber is not running. It is needed to manage PipeWire."
    # 0.4.x before 0.4.10 or so has no --version, so fall back to the package
    # version, then to which kind of system config is installed
    WP_VER=$(wireplumber --version 2>/dev/null | sed -n 's/.*libwireplumber \([0-9.]*\).*/\1/p' | tail -1)
    [[ -z $WP_VER ]] && WP_VER=$(dpkg-query -W -f='${Version}' wireplumber 2>/dev/null \
        || rpm -q --qf '%{VERSION}' wireplumber 2>/dev/null \
        || pacman -Q wireplumber 2>/dev/null | cut -d' ' -f2)
    WP_VER=$(sed -n 's/^\([0-9][0-9.]*[0-9]\).*/\1/p' <<<"$WP_VER")
    log "WirePlumber version: '${WP_VER}'"
    if [[ -z $WP_VER && -d /usr/share/wireplumber/main.lua.d ]]; then
        WP_LUA=1
        ok "WirePlumber 0.4 (older Lua configuration; exact version not found)"
    elif [[ $WP_VER == 0.4* ]]; then
        WP_LUA=1
        ok "WirePlumber $WP_VER (older Lua configuration)"
    else
        WP_LUA=0
        ok "WirePlumber ${WP_VER:-unknown version}"
    fi

    rt_check

    # qpwgraph is required: it's how routing is checked and fixed
    QPWGRAPH_CMD=""
    if command -v qpwgraph &>/dev/null; then
        QPWGRAPH_CMD=qpwgraph
    elif command -v flatpak &>/dev/null && flatpak info org.rncbc.qpwgraph &>/dev/null; then
        QPWGRAPH_CMD="flatpak run org.rncbc.qpwgraph"
    else
        say "qpwgraph is needed. It shows how the sound is connected, and is what"
        say "you (and anyone helping you) will use to check or fix the routing."
        if pkg_available qpwgraph; then
            offer_install qpwgraph "needed to view the sound routing" \
                && command -v qpwgraph &>/dev/null && QPWGRAPH_CMD=qpwgraph
        elif have_flathub; then
            # e.g. Ubuntu 22.04 / Mint 21, which don't package it
            install_qpwgraph_flatpak && QPWGRAPH_CMD="flatpak run org.rncbc.qpwgraph"
        fi
        if [[ -z $QPWGRAPH_CMD && -n $TEST_ROOT ]]; then
            QPWGRAPH_CMD=qpwgraph
        elif [[ -z $QPWGRAPH_CMD ]]; then
            die "qpwgraph is not installed. If your distro doesn't package it, it can be\ninstalled from Flathub:  flatpak install flathub org.rncbc.qpwgraph"
        fi
    fi
    ok "qpwgraph ($QPWGRAPH_CMD)"

    # hamlib: system package, or the copy built with FreeDV
    find_hamlib
    if [[ -n $RIGCTL_BIN && -n $RIGCTLD_BIN ]]; then
        ok "hamlib rigctl/rigctld ($RIGCTLD_BIN)"
    else
        warn "hamlib's rigctl/rigctld were not found (package $(hamlib_pkg))."
        say "  The rig control step will offer to install them."
    fi
    say ""
}

have_flathub() {
    command -v flatpak &>/dev/null && flatpak remotes --columns=name 2>/dev/null | grep -qx flathub
}

# Flatpak shows its own progress and asks for a password itself if needed
install_qpwgraph_flatpak() {
    say "Your distro doesn't package qpwgraph, but it can be installed from Flathub."
    say "The first Flathub install of a KDE program also downloads the KDE runtime"
    say "it needs (a few hundred MB)."
    yesno "Install qpwgraph from Flathub now?" y || return 1
    if [[ -n $TEST_ROOT ]]; then
        say "(test mode: would run: flatpak install -y flathub org.rncbc.qpwgraph)"
        return 1
    fi
    log "\n\$ flatpak install -y flathub org.rncbc.qpwgraph"
    if flatpak install -y flathub org.rncbc.qpwgraph >&3 2>&3; then
        log "flatpak install OK"
        ok "Installed qpwgraph from Flathub"
    else
        log "flatpak install FAILED"
        say "FAILED: Installing qpwgraph from Flathub"
        return 1
    fi
}

# Ubuntu 22.04 / Mint 21 use PulseAudio by default (PipeWire is installed,
# but only used for video there). NOT YET TESTED - needs a 22.04 tester.
offer_pipewire_switch() {
    if [[ -n $1 ]]; then
        say "Your sound server is: $1"
    else
        say "No sound server is running (neither PipeWire nor PulseAudio)."
    fi
    say "FreeDV setup here needs PipeWire (with its PulseAudio layer)${1:+ instead}."
    say ""
    case " $ID $ID_LIKE " in
        *" mageia "*)
            say "On Mageia, switch to PipeWire with draksound (Mageia Control Centre ->"
            say "Hardware -> Sound), reboot, then run freedv-rade-setup again."
            return ;;
        *" debian "*|*" ubuntu "*) ;;
        *)
            say "Please switch your system to PipeWire, reboot, then run freedv-rade-setup again."
            return ;;
    esac

    local p undo had_pms=0
    local -a pkgs=(pipewire-pulse wireplumber "$(alsa_plugin_pkg)") new=()
    for p in "${pkgs[@]}"; do
        pkg_installed "$p" || new+=("$p")
    done
    pkg_installed pipewire-media-session && had_pms=1

    # How to put PulseAudio back. pulseaudio is enabled for all users on
    # Ubuntu, so it's masked here (a user-level disable alone doesn't stick).
    undo="To put PulseAudio back, run these, then reboot:\n"
    # before the packages go, or systemctl can't find the units to disable
    undo+="  systemctl --user disable pipewire-pulse.socket wireplumber.service\n"
    # purge, not remove: removing masks these units for all users, and a
    # later reinstall leaves them masked
    ((${#new[@]})) && undo+="  sudo apt-get purge ${new[*]}\n"
    ((had_pms)) && undo+="  sudo apt-get install pipewire-media-session\n"
    undo+="  systemctl --user unmask pulseaudio.service pulseaudio.socket"

    say "This can be switched for you. It installs: ${new[*]:-(nothing new needed)}"
    say "and makes PipeWire handle the sound instead of PulseAudio."
    say "\n$undo\n"
    yesno "Switch this system to PipeWire now?" n || { say "Nothing changed."; return; }

    if ((${#new[@]})); then
        apt_quiet "Installing PipeWire's sound packages" "install ${new[*]}" \
            || { say "Package install failed - nothing else changed."; return; }
    fi
    if pkg_installed pipewire-media-session; then
        apt_quiet "Removing pipewire-media-session (WirePlumber replaces it)" "remove pipewire-media-session"
    fi
    # 'apt-get remove' of these packages masks their units for all users,
    # and reinstalling doesn't undo that
    local u masked=()
    for u in pipewire-pulse.socket pipewire-pulse.service wireplumber.service; do
        [[ $(readlink "/etc/systemd/user/$u") == /dev/null ]] && masked+=("$u")
    done
    if ((${#masked[@]})); then
        root_quiet "Unblocking PipeWire's sound services (left blocked by an earlier removal)" \
            "systemctl --global unmask ${masked[*]}" || die "Couldn't unblock ${masked[*]} - nothing else changed."
    fi
    if [[ -z $TEST_ROOT ]]; then
        if ! run_quiet "Switching the sound server to PipeWire" switch_to_pipewire; then
            say "\nThe switch didn't work, so PulseAudio has been put back as it was."
            if ((${#new[@]})); then
                say "The PipeWire packages it installed are still there; to remove them:"
                say "  sudo apt-get purge ${new[*]}"
            fi
            die "Switching to PipeWire failed."
        fi
    else
        say "(test mode: not switching the sound services)"
    fi

    mkdir -p "$SETUP_ROOT"
    printf '%b\n' "Written by freedv-rade-setup on $(date +%F) when it switched this system\nfrom PulseAudio to PipeWire.\n\n$undo" > "$SETUP_ROOT/undo-pipewire-switch.txt"
    say "(These undo commands are saved in $SETUP_ROOT/undo-pipewire-switch.txt)"
    say "\nDone. Please REBOOT, then run $0 again."
}

# pkg_installed PKG -> true only if fully installed. 'dpkg -s' is also true
# for a removed package whose config files are left (state "rc").
pkg_installed() {
    [[ $(dpkg-query -W -f='${Status}' "$1" 2>/dev/null) == "install ok installed" ]]
}

switch_to_pipewire() {
    systemctl --user --now disable pulseaudio.service pulseaudio.socket
    systemctl --user mask pulseaudio.service pulseaudio.socket || { pulseaudio_back; return 1; }
    # this user's own masks on PipeWire's units (the --global ones are cleared
    # before this); harmless when there are none
    systemctl --user unmask pipewire.socket pipewire.service pipewire-pulse.socket \
        pipewire-pulse.service wireplumber.service
    if ! systemctl --user --now enable pipewire.socket pipewire-pulse.socket wireplumber.service; then
        pulseaudio_back
        return 1
    fi
    systemctl --user --no-pager status pipewire-pulse.socket wireplumber.service
    return 0
}

# Undo a half-done switch, so the user isn't left with no sound server
pulseaudio_back() {
    echo "Switch failed - putting PulseAudio back"
    systemctl --user disable --now pipewire-pulse.socket wireplumber.service 2>/dev/null
    systemctl --user unmask pulseaudio.service pulseaudio.socket
    systemctl --user start pulseaudio.socket pulseaudio.service
}

##################### device detection #####################

# detect_plugin WHAT -> NEW_CARD and NEW_SERIAL (NEW_SERIAL may be empty)
# Same idea as sdcbr: unplug, snapshot, plug in, look for what's new.
# detect_serial -> NEW_SERIAL: the serial (CAT) port that appears when the
# radio's CAT cable is plugged in, as detect_plugin does for sound cards
detect_serial() {
    local before after key
    local -a new
    NEW_SERIAL=""
    while true; do
        say ""
        say "Make sure the radio's CAT (USB serial) cable is UNPLUGGED from the computer."
        yesno "Is it unplugged now?" y || return 1
        before=$(list_serial)
        say "\nNow PLUG IN the CAT cable. (Press ESC to go back)"
        echo -n "Waiting." >&3
        while true; do
            key=""
            read -r -s -n1 -t1 key
            [[ $key == $'\e' ]] && { screen ""; log "(ESC - back to the previous question)"; return 1; }
            after=$(list_serial)
            [[ $after != "$before" ]] && break
            echo -n "." >&3
        done
        screen " found."
        sleep 1
        after=$(list_serial)
        mapfile -t new < <(comm -13 <(echo "$before") <(echo "$after") | sed '/^$/d')
        ((${#new[@]})) && break
        say "No new serial port was found (something may have been unplugged instead). Let's try again."
    done
    if ((${#new[@]} == 1)); then
        NEW_SERIAL="/dev/serial/by-id/${new[0]}"
    else
        local -a items=()
        local s
        for s in "${new[@]}"; do items+=("$(serial_label "/dev/serial/by-id/$s")"); done
        say "More than one new serial port appeared (one cable can carry several)."
        say "If you're not sure, pick any: the rig control step asks each one which answers."
        choose "Which one is the CAT (rig control) port?" 1 "${items[@]}"
        NEW_SERIAL="/dev/serial/by-id/${new[CHOICE-1]}"
    fi
    say "Found serial port: $NEW_SERIAL"
}

# fix_setconf OPTIONS -> hamlib --set-conf options with the usual values in
# hamlib's own spelling (they're case-sensitive: serial_handshake=none fails)
fix_setconf() {
    local -a out=()
    local o k v c
    local IFS=,
    for o in $1; do
        k=${o%%=*} v=${o#*=}
        k=${k// /} v=${v## }
        case $k in
            serial_handshake) for c in None XONXOFF Hardware; do [[ ${v,,} == "${c,,}" ]] && v=$c; done ;;
            serial_parity)    for c in None Even Odd Mark Space; do [[ ${v,,} == "${c,,}" ]] && v=$c; done ;;
            rts_state|dtr_state) for c in Unset ON OFF; do [[ ${v,,} == "${c,,}" ]] && v=$c; done ;;
        esac
        [[ $o == *=* ]] && out+=("$k=$v") || out+=("$o")
    done
    echo "${out[*]}"
}

detect_plugin() {
    local what=$1 before_c before_s after_c after_s key
    local -a new_cards new_serial
    NEW_CARD=""
    NEW_SERIAL=""
    while true; do
        say ""
        say "Make sure $what is UNPLUGGED from the computer."
        yesno "Is it unplugged now?" y || return 1
        before_c=$(list_cards)
        before_s=$(list_serial)
        say "\nNow PLUG IN $what, into the USB socket it will ALWAYS stay in."
        say "Its new name belongs to that socket. (Press ESC to go back)"
        echo -n "Waiting." >&3
        while true; do
            key=""
            read -r -s -n1 -t1 key
            [[ $key == $'\e' ]] && { screen ""; log "(ESC - back to the previous question)"; return 1; }
            after_c=$(list_cards)
            [[ $after_c != "$before_c" ]] && break
            echo -n "." >&3
        done
        screen " found."
        # A serial (CAT) port on the same cable can take a moment longer
        screen "Checking for a CAT (serial) port on the same cable..."
        sleep 3
        after_c=$(list_cards)
        after_s=$(list_serial)
        mapfile -t new_cards < <(comm -13 <(echo "$before_c") <(echo "$after_c") | sed '/^$/d')
        mapfile -t new_serial < <(comm -13 <(echo "$before_s") <(echo "$after_s") | sed '/^$/d')
        ((${#new_cards[@]})) && break
        say "No new sound card was found (something may have been unplugged instead). Let's try again."
    done

    if ((${#new_cards[@]} == 1)); then
        NEW_CARD=${new_cards[0]}
    else
        local -a items=()
        local c
        for c in "${new_cards[@]}"; do items+=("$(card_label "$c")"); done
        say "More than one new sound card appeared:"
        choose "Which one is it?" 1 "${items[@]}"
        NEW_CARD=${new_cards[CHOICE-1]}
    fi
    say "Found sound card: $(card_label "$NEW_CARD")"

    if ((${#new_serial[@]} == 1)); then
        NEW_SERIAL="/dev/serial/by-id/${new_serial[0]}"
    elif ((${#new_serial[@]} > 1)); then
        local -a items=()
        local s
        for s in "${new_serial[@]}"; do items+=("$(serial_label "/dev/serial/by-id/$s")"); done
        say "More than one new serial port appeared (one cable can carry several)."
        say "If you're not sure, pick any: the rig control step asks each one which answers."
        choose "Which one is the CAT (rig control) port?" 1 "${items[@]}"
        NEW_SERIAL="/dev/serial/by-id/${new_serial[CHOICE-1]}"
    fi
    [[ -n $NEW_SERIAL ]] && say "Found serial port: $NEW_SERIAL"
    return 0
}

# pick_card PROMPT -> PICKED_CARD
pick_card() {
    local -a cards items=()
    local c
    mapfile -t cards < <(list_cards)
    ((${#cards[@]})) || { warn "No sound cards found."; return 1; }
    for c in "${cards[@]}"; do items+=("$(card_label "$c")"); done
    choose "$1" 1 "${items[@]}"
    PICKED_CARD=${cards[CHOICE-1]}
}

# name_card ROLE CARD -> sets ROLE_IN and ROLE_OUT node names
# ROLE is "radio" or "headset". USB cards get fixed names from a WirePlumber
# rule matched by USB port (see socket_rule), unless something else already
# names that port.
name_card() {
    local role=$1 card=$2 bp bus stem old_stem="" other id desc pref_in="" pref_out="" f n users
    # PipeWire's device.bus-path; pactl shows it as device.bus_path
    bp=$(card_prop "$card" device.bus-path)
    [[ -z $bp ]] && bp=$(card_prop "$card" device.bus_path)
    bus=$(card_prop "$card" device.bus)
    stem=${card#alsa_card.}

    if [[ $bus == usb && -n $bp ]] && f=$(socket_rule "$bp"); then
        id=$(rule_id "$f")
        read -r pref_in pref_out <<<"$(rule_nodes "$f")"
        if [[ $id != "$role" && ! $id =~ ^$role[0-9]+$ && ! ( $role == radio && $id == radio-* ) ]]; then
            if ! offer_swap "$role" "$f" "$bp"; then
                if [[ $id == radio* ]]; then say "This card is already set up as a radio sound card."
                else say "This card is already set up as a headset."; fi
                # the headset steps carry on with the card's current names
                ROLE_IN=$(resolve_node "$pref_in" "$stem" input)
                ROLE_OUT=$(resolve_node "$pref_out" "$stem" output)
                return 2
            fi
            # this card now has ROLE's names
            f=$SWAPPED_RULE
            id=$(rule_id "$f")
            read -r pref_in pref_out <<<"$(rule_nodes "$f")"
            stem=$(rule_stem "$f")
        fi
        # This socket already has a name: use it (shared with other radios)
        say "This card already has fixed names: $pref_in, $pref_out"
        users=$(node_users "$pref_in" "$pref_out")
        if [[ -n $users ]]; then
            [[ $role == radio ]] && say "Radio $users uses it too (you move the audio cables between the radios)." \
                                 || say "Radio $users uses it too."
        fi
    elif [[ $bus != usb || -z $bp ]]; then
        pref_in=""; pref_out=""
    elif other=$(existing_rule_for "$bp") && [[ -n $other ]] \
         && ! set_aside_rules "$role" "$card" "$other"; then
        say "Keeping that name."
        pref_in=""; pref_out=""
    else
        id=$(free_rule_id "$role")
        n=${id#"$role"}
        if [[ $role == radio ]]; then
            desc="Radio${n:+ $n}"; pref_in="$id-rx"; pref_out="$id-tx"
        else
            desc="Headset${n:+ $n}"; pref_in="$id-mic"; pref_out="$id-phones"
        fi
        old_stem=$stem
        stem="frs-$id"
        write_wp_rule "$id" "$bp" "$stem" "$desc" "$pref_in" "$pref_out"
        say "IMPORTANT: always plug this card into the SAME USB socket. If you move it,"
        say "run freedv-rade-setup again and redo this step.\n"
        if [[ $card != "alsa_card.$stem" ]]; then
            restart_wireplumber
            wait_node "$pref_in" 10 || wait_node "$pref_out" 5
        fi
    fi

    # The card's name changes when WirePlumber restarts with a new or swapped
    # rule: find it again by its socket, for card_ident
    NAMED_CARD=$card
    if [[ -n $bp ]]; then
        local now
        now=$(socket_card "$bp")
        [[ -n $now ]] && NAMED_CARD=$now
    fi

    ROLE_IN=$(resolve_node "$pref_in" "$stem" input)
    ROLE_OUT=$(resolve_node "$pref_out" "$stem" output)
    # If the new rule isn't active (yet), use the card's current node names
    if [[ -n $old_stem ]]; then
        [[ -n $ROLE_IN ]]  || ROLE_IN=$(resolve_node "" "$old_stem" input)
        [[ -n $ROLE_OUT ]] || ROLE_OUT=$(resolve_node "" "$old_stem" output)
        [[ -z $TEST_ROOT && $ROLE_IN != "$pref_in" ]] \
            && warn "The new name was not applied - using the card's current names for now."
    fi
    [[ -n $ROLE_IN ]]  && say "  Input (capture):   $ROLE_IN"  || warn "No input found on this card."
    [[ -n $ROLE_OUT ]] && say "  Output (playback): $ROLE_OUT" || warn "No output found on this card."
    if [[ -z $ROLE_IN || -z $ROLE_OUT ]]; then
        say "  If the card's profile is 'Off' or output-only, set it to an analog duplex"
        say "  profile (e.g. with pavucontrol), then re-run this step."
    fi
}

# Lists for choosing nodes: "name<TAB>description"
# list_sinks_desc / list_sources_desc -> NAME<tab>DESCRIPTION<tab>CARD'S OWN NAME
list_nodes_desc() {
    LC_ALL=C pactl list "$1" 2>/dev/null | awk '
        function out() { if (n != "" && n !~ /\.monitor$/) print n "\t" d "\t" h }
        /^[^\t]/ { out(); n = d = h = "" }
        /^\tName: / { n = $2 }
        /^\tDescription: / { d = $0; sub(/^\tDescription: /, "", d) }
        /^\t\talsa\.long_card_name = / { h = $0; sub(/^[^"]*"/, "", h); sub(/"$/, "", h); sub(/ at .*/, "", h) }
        END { out() }'
}
list_sinks_desc()   { list_nodes_desc sinks; }
list_sources_desc() { list_nodes_desc sources; }

# pick_node PROMPT sinks|sources|apps-out|apps-in [none] -> PICKED_NODE ("" for none)
pick_node() {
    local prompt=$1 kind=$2 allow_none=$3 prefer_usb=$4 line def=1
    local -a names items=()
    case $kind in
        sinks)    mapfile -t lines < <(list_sinks_desc) ;;
        sources)  mapfile -t lines < <(list_sources_desc) ;;
        apps-out) mapfile -t lines < <(pw-link -o 2>/dev/null | cut -d: -f1 | sort -u | sed 's/$/\t/') ;;
        apps-in)  mapfile -t lines < <(pw-link -i 2>/dev/null | cut -d: -f1 | sort -u | sed 's/$/\t/') ;;
    esac
    for line in "${lines[@]}"; do
        local n=${line%%$'\t'*} d=${line#*$'\t'} h=""
        [[ $d == *$'\t'* ]] && { h=${d#*$'\t'}; d=${d%%$'\t'*}; }
        [[ -n $h && $h != "$d" ]] && d+="${d:+ - }$h"
        [[ " ${FDV_SINKS[*]} " == *" $n "* || $n == Fdv-bpf* ]] && continue
        # the radio's own sound card is never the headset or speakers
        if [[ $kind == sinks || $kind == sources ]]; then
            [[ -n $RADIO_RX_NODE && $n == "$RADIO_RX_NODE" ]] && continue
            [[ -n $RADIO_TX_NODE && $n == "$RADIO_TX_NODE" ]] && continue
            # and anything the caller has already taken (e.g. the headphones,
            # when asking for speakers)
            [[ -n ${PICK_SKIP:-} && $n == "$PICK_SKIP" ]] && continue
        fi
        names+=("$n")
        items+=("${d:+$d  }($n)")
        # offer the first USB device as the default when asked to
        [[ -n $prefer_usb && $def == 1 && ( $n == alsa_*.usb-* || $n == headset-* ) ]] \
            && def=${#names[@]}
    done
    if [[ -n $allow_none ]]; then
        names+=("")
        items+=("None")
    fi
    ((${#names[@]})) || { warn "Nothing to choose from."; PICKED_NODE=""; return 1; }
    choose "$prompt" "$def" "${items[@]}"
    PICKED_NODE=${names[CHOICE-1]}
}

