radio_audio_step() {
    heading "Radio sound card"
    RADIO_SERIAL=""
    # ESC (or "not unplugged") while detecting comes back to this question
    while true; do
    say "How is the radio's audio connected to this computer?"
    say "  (D)etect a USB sound card, or a radio with built-in USB sound, by plugging it in (recommended)"
    say "  (C)hoose from the sound cards that are already connected"
    say "  (S)oftware radio program on this computer (quisk, piHPSDR ...)"
    local -a keys=("Dd" "Cc" "Ss")
    local hint="[D/c/s" question="Detect, Choose, Software"
    if [[ -n $(kiwi_hooks_dir) ]]; then
        say "  (N)o radio here: receive only, from the KiwiSDR panadapter"
        keys+=("Nn"); hint+="/n"; question+=", No radio"
    fi
    ((NEW_RADIO)) && say "  (B)ack - stop setting up this radio" \
                  || say "  (B)ack - keep the radio's sound card as it is"
    keys+=("Bb"); hint+="/b]"; question+=" or Back?"
    confirm "$question" "$hint" "${keys[@]}"
    case ${keys[$?]} in
        Bb)
            return 1 ;;
        Dd)
            detect_plugin "the radio's USB cable (or its USB sound interface)" || continue
            RADIO_KIND=usb; RADIO_APP=""; RADIO_CARD=$NEW_CARD; RADIO_SERIAL=$NEW_SERIAL ;;
        Cc)
            pick_card "Which card is connected to the radio?" || return 1
            RADIO_KIND=card; RADIO_APP=""; RADIO_CARD=$PICKED_CARD ;;
        Ss)
            software_radio_step || continue
            return 0 ;;
        Nn)
            receive_only_step
            return 0 ;;
    esac
    name_card radio "$RADIO_CARD"
    if (( $? == 2 )); then
        say "Choose another card, or go (B)ack.\n"
        continue
    fi
    break
    done
    RADIO_RX_NODE=$ROLE_IN
    RADIO_TX_NODE=$ROLE_OUT
    RADIO_CARD=$NAMED_CARD
    RADIO_CARD_ID=$(card_ident "$RADIO_CARD")
    set_radio_volume
}

# app_pids COMMAND -> the PIDs of a running radio program (e.g. quisk, which
# runs as "python3 /usr/bin/quisk")
app_pids() {
    local prog=${1%% *} p a0 a1
    prog=${prog##*/}
    [[ -n $prog ]] || return
    for p in $(pgrep -u "$USER" .); do
        a0="" a1=""
        { IFS= read -r -d '' a0; IFS= read -r -d '' a1; } < "/proc/$p/cmdline" 2>/dev/null
        [[ ${a0##*/} == "$prog" || ( ${a0##*/} == python* && ${a1##*/} == "$prog" ) ]] && echo "$p"
    done
}

quisk_help() {
    say "Quisk's settings for FreeDV (in Quisk's Config window):"
    say "  - Use a radio added on the Radios tab, not ConfigFileRadio (its settings"
    say "    come from a file and can't be changed there)."
    say "  - On that radio's Sound tab:"
    say "      Digital Rx0 Output:  pulse: Use name QuiskDigitalOutput.monitor"
    say "      Digital Tx0 Input:   pulse: Use name QuiskDigitalInput"
    say "    and no hw: devices there (e.g. Radio Sound Output hw:0): they take the"
    say "    sound card away from the sound system, and FreeDV's audio then stops"
    say "    and starts. Use pulse: devices, or leave Radio Sound Output empty."
    say "  - On its Remote tab, the Hamlib port (4532, or 4575) lets FreeDV change"
    say "    the frequency and switch to transmit."
    say "Quisk makes the QuiskDigitalOutput and QuiskDigitalInput sound boxes when"
    say "it starts, so restart it after changing these."
}

# A radio program (Quisk, piHPSDR ...) on this computer instead of a sound
# card. The start script restarts the sound system, which removes the sound
# nodes the program made, so it starts the program itself after the restart.
software_radio_step() {
    local def=$RADIO_APP prog i
    say "FreeDV can work with a radio program on this computer, such as Quisk."
    say "This radio's start script then starts the program too, after it restarts"
    say "the sound system (which would cut off a program that was already running)."
    [[ -z $def ]] && command -v quisk &>/dev/null && def=quisk
    ask "The command that starts the radio program (B to go back)" "$def"
    [[ -n $REPLY && $REPLY != [Bb] ]] || return 1
    prog=${REPLY%% *}
    if ! command -v "$prog" &>/dev/null; then
        warn "'$prog' wasn't found."
        yesno "Use it anyway?" n || return 1
    fi
    RADIO_KIND=software; RADIO_APP=$REPLY; RADIO_CARD=""; RADIO_CARD_ID=""
    [[ ${prog##*/} == quisk ]] && quisk_help
    if [[ -z $(app_pids "$RADIO_APP") ]]; then
        say "Starting $RADIO_APP..."
        # its own session, so it carries on when this window closes
        setsid -f $RADIO_APP >/dev/null 2>&1 </dev/null 3>&- 9>&-
    fi
    while true; do
        pause "When ${prog##*/} is running with its sound set up as above, press Enter... "
        if [[ ${prog##*/} == quisk ]]; then
            for ((i=0; i<25; i++)); do
                node_exists QuiskDigitalOutput && node_exists QuiskDigitalInput && break
                sleep 0.2
            done
            if node_exists QuiskDigitalOutput && node_exists QuiskDigitalInput; then
                ok "Found Quisk's QuiskDigitalOutput (received audio) and QuiskDigitalInput (transmit audio)"
                RADIO_RX_NODE=QuiskDigitalOutput
                RADIO_TX_NODE=QuiskDigitalInput
                return 0
            fi
            warn "Quisk's QuiskDigitalOutput and QuiskDigitalInput weren't found."
            say "Check its Sound settings (above) and restart Quisk."
            say "  (T)ry again"
            say "  (C)hoose the sound nodes from a list instead"
            say "  (B)ack"
            confirm "Try again, Choose or Back?" "[T/c/b]" "Tt" "Cc" "Bb"
            case $? in
                0) continue ;;
                2) return 1 ;;
            esac
        fi
        break
    done
    pick_node "Which node carries the RECEIVED audio from the radio program?" apps-out || return 1
    RADIO_RX_NODE=$PICKED_NODE
    pick_node "Which node should the TRANSMIT audio go to?" apps-in || return 1
    RADIO_TX_NODE=$PICKED_NODE
}

# No radio on this computer: FreeDV only receives, from the KiwiSDR
# panadapter (with no radio input it feeds the KiwiSDR's own audio, FDV_PAN,
# into FDV_RX_in). A Dummy rigctld stands in for the radio, so a frequency
# set in FreeDV (e.g. a double-click in FreeDV Reporter) reaches the
# panadapter, and its tuning reaches FreeDV.
receive_only_step() {
    RADIO_KIND=none; RADIO_APP=""; RADIO_CARD=""; RADIO_CARD_ID=""
    RADIO_RX_NODE=""; RADIO_TX_NODE=""
    say "FreeDV will receive from the KiwiSDR panadapter, which starts with it."
    say "There is nothing to transmit to, so no transmit filter is set up, and"
    say "hamlib's Dummy rig stands in for a radio: FreeDV and the panadapter"
    say "share its frequency."
}

# A radio's sound card comes up at whatever volume it had (e.g. 74%, too quiet
# for a TS-450S). When setting up a NEW radio, start its output at 100%; the
# transmit level is then set with FreeDV's TX attenuation. Redoing the card
# later leaves the user's volume alone.
set_radio_volume() {
    # (return 0: this is radio_audio_step's last step, so its status is that step's)
    ((NEW_RADIO)) && [[ -n $RADIO_TX_NODE && -z $TEST_ROOT ]] || return 0
    if timeout 5 pactl set-sink-volume "$RADIO_TX_NODE" 100% 2>/dev/null \
       && timeout 5 pactl set-sink-mute "$RADIO_TX_NODE" 0 2>/dev/null; then
        say "The radio's sound output is set to 100%."
    else
        log "Couldn't set the volume of $RADIO_TX_NODE"
    fi
}

# A USB headset picked from the list gets the same fixed names as a
# detected one: headset-mic, headset-phones (headset2-... in another socket)
# node_card NODE -> the sound card a source or sink belongs to
node_card() {
    { LC_ALL=C pactl list sources; LC_ALL=C pactl list sinks; } 2>/dev/null | awk -v node="$1" '
        /^[^\t]/ { f = 0 }
        /^\tName: / { f = ($2 == node) }
        f && $1 == "device.name" { sub(/^[^"]*"/, ""); sub(/"$/, ""); print; exit }'
}
name_chosen_headset() {
    local stem card
    card=$(node_card "$MIC_NODE")
    [[ -n $card ]] && list_cards | grep -qxF -- "$card" || return
    [[ $(card_prop "$card" device.bus) == usb ]] || return
    # already has fixed names: just note which card it is, for the start
    # script's check that the cards are in their own sockets
    if [[ $MIC_NODE != alsa_input.* ]]; then
        MIC_CARD_ID=$(card_ident "$card")
        return
    fi
    stem=${card#alsa_card.}
    local phones_same=0
    [[ $PHONES_NODE == "alsa_output.$stem."* ]] && phones_same=1
    say "Giving this USB headset fixed names:"
    name_card headset "$card"
    MIC_NODE=$ROLE_IN
    MIC_CARD_ID=$(card_ident "$NAMED_CARD")
    ((phones_same)) && PHONES_NODE=$ROLE_OUT
}

headset_step() {
    heading "Microphone, headphones and speakers"
    MIC_NODE_WAS=$MIC_NODE   # for offer_swap
    MIC_NODE=""; MIC_CARD_ID=""; PHONES_NODE=""; SPEAKER_NODE=""
    # ESC (or "not unplugged") while detecting comes back to this question
    while true; do
    say "Which microphone will you use for transmitting?"
    say "  (D)etect a USB headset by plugging it in (recommended)"
    say "  (C)hoose from the sound cards that are already connected"
    say "  (N)o microphone (receive only)"
    confirm "Detect, Choose or No microphone?" "[D/c/n]" "Dd" "Cc" "Nn"
    CHOICE=$(($? + 1))
    case $CHOICE in
        1)
            detect_plugin "your USB headset" || continue
            name_card headset "$NEW_CARD"
            MIC_NODE=$ROLE_IN
            MIC_CARD_ID=$(card_ident "$NAMED_CARD")
            PHONES_NODE=$ROLE_OUT ;;
        2)
            pick_node "Which microphone?" sources "" usb || true
            MIC_NODE=$PICKED_NODE
            pick_node "Which headphones (if any)?" sinks none usb || true
            PHONES_NODE=$PICKED_NODE
            name_chosen_headset ;;
    esac
    break
    done

    ((GAP)) || say ""
    say "Received audio can also play on speakers (handy when you take the headset off)."
    PICK_SKIP=$PHONES_NODE pick_node "Which speakers?" sinks none || true
    SPEAKER_NODE=$PICKED_NODE
    [[ -n $PHONES_NODE && $SPEAKER_NODE == "$PHONES_NODE" ]] && SPEAKER_NODE=""

    MONITOR=none
    if [[ -n $PHONES_NODE && -n $SPEAKER_NODE ]]; then
        say "Where should received audio play?"
        say "  (B)oth headphones and speakers - turn the speaker volume up or down as needed (recommended)"
        say "  (H)eadphones only"
        say "  (S)peakers only"
        confirm "Both, Headphones or Speakers?" "[B/h/s]" "Bb" "Hh" "Ss"
        CHOICE=$(($? + 1))
        MONITOR=$(echo both headphones speakers | cut -d' ' -f"$CHOICE")
    elif [[ -n $PHONES_NODE ]]; then
        MONITOR=headphones
    elif [[ -n $SPEAKER_NODE ]]; then
        MONITOR=speakers
    else
        warn "No headphones or speakers chosen - you won't hear received audio."
    fi
    pi_jack_rule
}

# sink_prop SINK PROP -> a property of a sink (e.g. alsa.card_name)
sink_prop() {
    LC_ALL=C pactl list sinks 2>/dev/null | awk -v sink="$1" -v prop="$2" '
        /^[^\t]/ { f = 0 }
        /^\tName: / { f = ($2 == sink) }
        f && $1 == prop && $2 == "=" { sub(/^[^=]*= *"/, ""); sub(/"$/, ""); print; exit }'
}

# pi_jack_rule -> when a Raspberry Pi's own headphone jack (bcm2835) is the
# headphones or speakers, give it more headroom. Its driver reports the buffer
# level in large uneven steps, so following the USB cards' clock it kept
# leaving PipeWire's window: ~15 resyncs a minute (an occasional tick) and
# errors. headroom 1024 stopped them (Pi 4), for ~20ms more delay there.
pi_jack_rule() {
    local n jack="" f lua body
    for n in "$SPEAKER_NODE" "$PHONES_NODE"; do
        [[ -n $n && $(sink_prop "$n" alsa.card_name) == "bcm2835 Headphones" ]] && { jack=$n; break; }
    done
    [[ -n $jack ]] || return 0
    if ((WP_LUA)); then
        f="$WP_LUA_DIR/61-freedv-rade-pi-jack.lua"
        body="-- Written by freedv-rade-setup: the Raspberry Pi's headphone jack plays without
-- resyncs (ticks) with more headroom. Delete this file to undo.
table.insert(alsa_monitor.rules, {
  matches = { { { \"node.name\", \"equals\", \"$jack\" } } },
  apply_properties = { [\"api.alsa.headroom\"] = 1024 },
})"
    else
        f="$WP_CONF_DIR/61-freedv-rade-pi-jack.conf"
        body="# Written by freedv-rade-setup: the Raspberry Pi's headphone jack plays without
# resyncs (ticks) with more headroom. Delete this file to undo.
monitor.alsa.rules = [
  {
    matches = [ { node.name = \"$jack\" } ]
    actions = { update-props = { api.alsa.headroom = 1024 } }
  }
]"
    fi
    [[ -f $f && $(<"$f") == "$body" ]] && return 0
    mkdir -p "${f%/*}"
    printf '%s\n' "$body" > "$f"
    log "Wrote $f"
    say "The Raspberry Pi's own headphone jack is set to play smoothly (more buffering,"
    say "about 20ms more delay there)."
    [[ $MONITOR == both && $jack == "$SPEAKER_NODE" ]] \
        && say "With both playing, the speakers will be about 20ms behind the headphones."
    restart_wireplumber
}

# rig_data_modes MODEL -> yes/no: whether hamlib lists data modes (PKTUSB)
# for the radio model; nothing if it can't tell
rig_data_modes() {
    local list
    [[ -x $RIGCTL_BIN ]] || return 0
    list=$("$RIGCTL_BIN" -m "$1" --dump-caps 2>/dev/null | grep -m1 -i '^Mode list')
    [[ -n $list ]] || return 0
    grep -qw PKTUSB <<<"$list" && echo yes || echo no
}

# rig_test HOST|PORT MODEL [SETCONF] -> 0 if the radio answered
rig_test() {
    local port=$1 model=$2 setconf=$3 out
    if ! runs "$RIGCTL_BIN"; then
        warn "Can't test: hamlib's rigctl is not installed or doesn't run (package $(hamlib_pkg))."
        return 1
    fi
    say "Asking the radio for its frequency..."
    out=$(timeout 15 "$RIGCTL_BIN" -m "$model" -r "$port" ${setconf:+--set-conf="$setconf"} f 2>&1)
    if [[ $? -eq 0 && $out =~ ^[0-9]+$ ]]; then
        say "  The radio answered: $out Hz"
        return 0
    fi
    say "  No answer. rigctl said:\n${out:-  (nothing)}"
    return 1
}

# A radio program controls the radio itself, and answers hamlib commands
# like a rigctld (Quisk: on port 4532 or 4575), so FreeDV talks to it
# directly and no rigctld is run for it
app_rig() {
    local prog=${RADIO_APP%% *} hp out found=""
    prog=${prog##*/}
    say "${prog:-The radio program} controls the radio itself. FreeDV can change its frequency and"
    say "switch it to transmit through its hamlib server, if it has one."
    if [[ -n $RIGCTL_BIN ]]; then
        for hp in localhost:4532 localhost:4575; do
            out=$(timeout 5 "$RIGCTL_BIN" -m 2 -r "$hp" f 2>/dev/null)
            [[ $out =~ ^[0-9]+$ ]] && { found=$hp; break; }
        done
    fi
    if [[ -n $found ]]; then
        say "It answers at $found (frequency $out Hz)."
        yesno "Use it for FreeDV's rig control and PTT?" y || return
        RIG_MODE=program; RIG_HOST=$found
        return
    fi
    if [[ -n $RIGCTL_BIN ]]; then
        say "Nothing answered at localhost:4532 or localhost:4575."
    else
        say "(hamlib rigctl isn't installed, so this can't be tested here.)"
    fi
    [[ $prog == quisk ]] && say "In Quisk the Hamlib port is on the radio's Remote tab (0 turns it off)."
    say "Answer No to use VOX or the radio's own PTT."
    yesno "Set the address of its hamlib server by hand?" n || return
    ask "Its address (host:port)" "localhost:4532"
    hp=$REPLY
    [[ $hp == *:* ]] || hp="$hp:4532"
    if [[ -n $RIGCTL_BIN ]]; then
        rig_test "$hp" 2 || yesno "Use it anyway?" n || return
    fi
    RIG_MODE=program; RIG_HOST=$hp
}

# Receive only: rigctld with hamlib's Dummy rig (model 1), started with
# FreeDV. It just holds a frequency, mode and PTT state.
dummy_rig() {
    if ! ensure_hamlib; then
        warn "Without rigctld, FreeDV and the panadapter can't share a frequency."
        return
    fi
    RIG_MODE=ondemand; RIG_MODEL=1; RIG_MODEL_NAME="Hamlib Dummy (no radio)"
    RIG_PORT=""; RIG_SETCONF=""; RIG_LISTEN=127.0.0.1; RIG_HOST=localhost:4532
    ok "rigctld with hamlib's Dummy rig, started with FreeDV (localhost:4532)"
}

# rig_speeds MODEL -> the standard serial speeds hamlib allows for the model,
# fastest first (hamlib uses the fastest unless serial_speed is set)
rig_speeds() {
    local lo hi s
    read -r lo hi < <("$RIGCTL_BIN" -m "$1" --dump-caps 2>/dev/null \
        | sed -n 's/^Serial speed: *\([0-9]*\)\.\.\([0-9]*\) .*/\1 \2/p' | head -1)
    [[ $lo =~ ^[0-9]+$ && $hi =~ ^[0-9]+$ ]] || return 0
    for s in 115200 57600 38400 19200 9600 4800 2400 1200; do
        ((s >= lo && s <= hi)) && echo "$s"
    done
}

# set_speed SETCONF SPEED -> SETCONF with serial_speed=SPEED in place of any
# speed it had
set_speed() {
    local c
    c=$(tr ',' '\n' <<<"$1" | grep -v '^serial_speed=' | paste -sd,)
    echo "serial_speed=$2${c:+,$c}"
}

# rig_speed_step MODEL -> the speed chosen, or nothing for hamlib's own (the
# fastest). The radio's CAT/USB menu must be set to the same speed.
rig_speed_step() {
    local -a speeds labels
    local s
    mapfile -t speeds < <(rig_speeds "$1")
    ((${#speeds[@]} > 1)) || return 0
    for s in "${speeds[@]}"; do labels+=("$s baud"); done
    labels[0]+=" (hamlib's choice for this radio)"
    say "Serial speed: the radio's CAT (or USB/COM) menu must be set to the same speed."
    say "If the radio misbehaves at the top speed, choose a slower one here and in the radio."
    choose "Which speed?" 1 "${labels[@]}"
    ((CHOICE > 1)) && echo "${speeds[CHOICE-1]}"
}

# scan_speeds PORT MODEL SETCONF -> the first speed the radio answers at
scan_speeds() {
    local s out
    for s in $(rig_speeds "$2"); do
        say "  trying $s baud..."
        out=$(timeout 8 "$RIGCTL_BIN" -m "$2" -r "$1" --set-conf="$(set_speed "$3" "$s")" f 2>/dev/null)
        [[ $out =~ ^[0-9]+$ ]] && { echo "$s"; return 0; }
    done
    return 1
}

rig_step() {
    heading "Rig control (CAT and PTT)"
    RIG_MODE=none; RIG_MODEL=""; RIG_MODEL_NAME=""; RIG_PORT=""; RIG_SETCONF=""
    RIG_LISTEN=127.0.0.1; RIG_HOST=localhost:4532

    if [[ $RADIO_KIND == software ]]; then
        app_rig
        return
    fi
    if [[ $RADIO_KIND == none ]]; then
        dummy_rig
        return
    fi

    if ! ensure_hamlib; then
        warn "Without hamlib, rig control can't be set up."
        say "FreeDV can still be used with VOX or the radio's own PTT."
        return
    fi

    # 1. rigctld on another computer, optionally with this computer's own
    # CAT cable (and rigctld) for when that one isn't answering
    local fallback_host=""
    if yesno "Is rigctld already running on ANOTHER computer on your network?" n; then
        ask "Its address (host or host:port)" ""
        local host=$REPLY
        [[ $host == *:* ]] || host="$host:4532"
        rig_test "$host" 2 || yesno "Use it anyway?" n || return
        RIG_MODE=remote; RIG_HOST=$host
        say "If the radio's CAT cable is sometimes plugged into this computer instead,"
        say "FreeDV can start its own rigctld for it whenever $host isn't answering."
        yesno "Use a CAT cable on this computer when $host isn't answering?" n || return
        fallback_host=$host
        say "\nNow the settings for the CAT cable on this computer."
    fi

    if [[ -z $fallback_host ]]; then
        # 2. rigctld already running here (e.g. started at boot)
        local running tport boot_units
        running=$(ps -o args= -C rigctld 2>/dev/null | head -1)
        boot_units=$(boot_rigctld_units)
        if [[ -n $running ]]; then
            say "rigctld is already running on this computer:\n  $running"
            tport=$(sed -n 's/.*-t *\([0-9]\+\).*/\1/p; s/.*--port[= ]\([0-9]\+\).*/\1/p' <<<"$running" | head -1)
            tport=${tport:-4532}
            if yesno "Use this rigctld for FreeDV?" y; then
                rig_test "localhost:$tport" 2 || yesno "Use it anyway?" y || return
                # With its settings known, FreeDV can start its own copy whenever
                # this one isn't running (e.g. hung with the radio off, or stopped).
                if adopt_rigctld_args "$running" && [[ $tport == 4532 ]]; then
                    RIG_MODE=ondemand
                    say "FreeDV will use this rigctld when it is running, and otherwise start"
                    say "its own with the same settings ($RIG_MODEL_NAME on $RIG_PORT) while FreeDV runs."
                else
                    RIG_MODE=existing; RIG_HOST="localhost:$tport"
                fi
                remove_old_rig_service
                return
            fi
            say "Only one program can use the radio's serial port, so stop that rigctld"
            say "first, then run this step again."
            return
        fi


        say "FreeDV can control your radio (frequency and PTT) through hamlib's rigctld."
        say "Answer No if you use VOX or the radio's own PTT."
        yesno "Set up rigctld for your radio?" y || return
    fi

    # Model
    local word
    local -a matches
    while true; do
        ask "Type part of your radio's model name (e.g. 7300, FT-991, TS-590)" ""
        word=$REPLY
        [[ -n $word ]] || continue
        mapfile -t matches < <("$RIGCTL_BIN" -l 2>/dev/null | awk 'NR > 1' | grep -i -- "$word" | tr -s ' ' | sed 's/^ //')
        if ((${#matches[@]} == 0)); then
            say "No radio matches '$word'. Try a shorter part of the name."
        elif ((${#matches[@]} > 30)); then
            say "${#matches[@]} radios match '$word'. Please type more of the name."
        else
            break
        fi
    done
    local -a items=()
    local m
    for m in "${matches[@]}"; do
        items+=("$(awk '{ printf "%-6s", $1; for (i = 2; i <= NF - 3; i++) printf " %s", $i }' <<<"$m")")
    done
    choose "Which is your radio?" 1 "${items[@]}"
    RIG_MODEL=$(awk '{print $1}' <<<"${matches[CHOICE-1]}")
    RIG_MODEL_NAME=$(sed 's/^ *[0-9]* *//' <<<"${items[CHOICE-1]}")

    # Port
    local -a ports siblings
    if [[ -n $RADIO_SERIAL ]]; then
        mapfile -t siblings < <(serial_siblings "$RADIO_SERIAL")
        ((${#siblings[@]})) || siblings=("$RADIO_SERIAL")
        if ((${#siblings[@]} > 1)); then
            # several ports on the radio's cable: find the one that answers
            say "The radio's USB cable has ${#siblings[@]} serial ports."
            say "Make sure the radio is switched ON."
            pause "Press Enter to find which one is CAT... "
            if find_cat_port "$RIG_MODEL" "" "${siblings[@]}"; then
                RADIO_SERIAL=$FOUND_PORT
            else
                say "None answered. Check the radio is on and its USB/COM settings, or pick one below."
                RADIO_SERIAL=""
            fi
        fi
    fi
    if [[ -n $RADIO_SERIAL ]]; then
        say "The serial port found with the radio's USB cable is:\n  $(serial_label "$RADIO_SERIAL")"
    fi
    if [[ -n $RADIO_SERIAL ]] && yesno "Use it for rig control?" y; then
        RIG_PORT=$RADIO_SERIAL
    else
        # like the sound cards: detect the CAT cable by plugging it in, or
        # pick one already connected, or type one
        RIG_PORT=""
        while [[ -z $RIG_PORT ]]; do
            mapfile -t ports < <(ls -1 /dev/serial/by-id/* 2>/dev/null)
            ((${#ports[@]})) || say "No USB serial (CAT) port is connected at the moment."
            local -a labels=() p
            for p in "${ports[@]}"; do labels+=("$(serial_label "$p")"); done
            choose "Which serial port is the radio's CAT port?" 1 \
                "Detect the radio's CAT cable by plugging it in (recommended)" \
                "Ask each port for the radio's frequency (the radio must be on)" \
                "${labels[@]}" "Type a port"
            if ((CHOICE == 1)); then
                detect_serial && RIG_PORT=$NEW_SERIAL
            elif ((CHOICE == 2)); then
                if ((${#ports[@]})) && find_cat_port "$RIG_MODEL" "" "${ports[@]}"; then
                    RIG_PORT=$FOUND_PORT
                else
                    say "No port answered. Check the radio is on, or pick its port from the list."
                fi
            elif ((CHOICE <= ${#ports[@]} + 2)); then
                RIG_PORT=${ports[CHOICE-3]}
            else
                ask "Port (e.g. /dev/ttyUSB0)" "/dev/ttyUSB0"
                RIG_PORT=$REPLY
            fi
        done
    fi

    local speed
    speed=$(rig_speed_step "$RIG_MODEL")

    say "\nMost radios need nothing more. Some older ones need extra hamlib options,"
    say "for example the TS-450S needs:  serial_handshake=None"
    ask "Extra --set-conf options (press Enter for none)" ""
    RIG_SETCONF=$(fix_setconf "$REPLY")
    [[ $RIG_SETCONF != "$REPLY" ]] && say "  (written as hamlib wants it: $RIG_SETCONF)"
    # a speed typed here wins over the one chosen above
    [[ -n $speed && $RIG_SETCONF != *serial_speed=* ]] \
        && RIG_SETCONF=serial_speed=$speed${RIG_SETCONF:+,$RIG_SETCONF}

    say ""
    say "Make sure the radio is switched ON."
    pause "Press Enter to test the connection... "
    until rig_test "$RIG_PORT" "$RIG_MODEL" "$RIG_SETCONF"; do
        confirm "(T)ry again, try each (S)peed, (K)eep these settings anyway, or (N)o rig control?" "[T/s/k/n]" "Tt" "Ss" "Kk" "Nn"
        CHOICE=$(($? + 1))
        case $CHOICE in
            2) if speed=$(scan_speeds "$RIG_PORT" "$RIG_MODEL" "$RIG_SETCONF"); then
                   RIG_SETCONF=$(set_speed "$RIG_SETCONF" "$speed")
                   say "  The radio answered at $speed baud: set it at that speed."
               else
                   say "  No answer at any speed. Check the port, the cable and the radio's"
                   say "  CAT (or USB/COM) settings."
               fi ;;
            3) break ;;
            4) if [[ -n $fallback_host ]]; then
                   # still the other computer's rigctld, just no cable here
                   RIG_MODEL=""; RIG_MODEL_NAME=""; RIG_PORT=""; RIG_SETCONF=""
                   RIG_MODE=remote; RIG_HOST=$fallback_host
               else
                   RIG_MODE=none
               fi
               return ;;
        esac
    done

    if [[ -n $fallback_host ]]; then
        RIG_MODE=remote; RIG_HOST=$fallback_host; RIG_LISTEN=127.0.0.1
        say "FreeDV will use rigctld at $RIG_HOST, or start its own for the cable on"
        say "$(serial_label "$RIG_PORT") when that isn't answering."
        return
    fi

    if [[ -n $boot_units ]]; then
        # Another service already starts rigctld at boot (e.g. the distro's
        # rigctld.service, shared with other radio programs): never add a
        # second one, which would fight it for the serial port and port 4532.
        say "rigctld is already started at boot by: $boot_units"
        say "(not running at the moment - radio off, or stopped?)"
        say "FreeDV will use it when it is running, and otherwise start its own"
        say "while FreeDV runs."
        RIG_MODE=ondemand
    else
        say "When should rigctld run?"
        say "  (W)hile FreeDV is running only (recommended)"
        say "  (A)ll the time, started when the computer boots (for logging programs etc.)"
        confirm "While FreeDV runs, or All the time?" "[W/a]" "Ww" "Aa"
        CHOICE=$(($? + 1))
        ((CHOICE == 1)) && RIG_MODE=ondemand || RIG_MODE=boot
    fi

    if yesno "Allow other computers on your network to use this rigctld?" n; then
        RIG_LISTEN=0.0.0.0
        say "Note: if a firewall is active, TCP port 4532 must be opened for this."
    fi
    RIG_HOST=localhost:4532

    if [[ $RIG_MODE == boot ]]; then
        install_rig_service
    else
        remove_old_rig_service
    fi
}

# boot_rigctld_units -> enabled services, other than this setup's own, that
# start rigctld (e.g. the distro's rigctld.service), space separated
boot_rigctld_units() {
    local f u found=""
    for f in /etc/systemd/system/*.service /usr/lib/systemd/system/*.service /lib/systemd/system/*.service; do
        [[ -f $f ]] || continue
        u=${f##*/}
        [[ $u == freedv-rigctld.service ]] && continue
        grep -qE '^[[:space:]]*ExecStart=.*rigctld' "$f" 2>/dev/null || continue
        systemctl is-enabled --quiet "$u" 2>/dev/null || continue
        [[ " $found " == *" $u "* ]] || found+=" $u"
    done
    echo "${found# }"
}

# adopt_rigctld_args "ARGS" -> RIG_MODEL/RIG_MODEL_NAME/RIG_PORT/RIG_SETCONF/
# RIG_LISTEN from a running rigctld's command line, so FreeDV can start the
# same rigctld itself when that one isn't running. Fails if they can't be read.
adopt_rigctld_args() {
    local -a a
    read -r -a a <<<"$1"
    local i w next model="" port="" conf="" speed="" listen=""
    for ((i = 1; i < ${#a[@]}; i++)); do
        w=${a[i]}; next=${a[i+1]:-}
        case $w in
            -m|--model) model=$next; ((i++)) ;;
            -m*) model=${w#-m} ;;
            --model=*) model=${w#*=} ;;
            -r|--rig-file) port=$next; ((i++)) ;;
            -r*) port=${w#-r} ;;
            --rig-file=*) port=${w#*=} ;;
            -s|--serial-speed) speed=$next; ((i++)) ;;
            --serial-speed=*) speed=${w#*=} ;;
            -C|--set-conf) conf+=${conf:+,}$next; ((i++)) ;;
            --set-conf=*) conf+=${conf:+,}${w#*=} ;;
            -T|--listen-addr) listen=$next; ((i++)) ;;
            --listen-addr=*) listen=${w#*=} ;;
        esac
    done
    [[ $model =~ ^[0-9]+$ && -n $port ]] || return 1
    [[ -n $speed ]] && conf+=${conf:+,}serial_speed=$speed
    RIG_MODEL=$model; RIG_PORT=$port; RIG_SETCONF=$(fix_setconf "$conf")
    RIG_LISTEN=${listen:-127.0.0.1}; RIG_HOST=localhost:4532
    RIG_MODEL_NAME=$("$RIGCTL_BIN" -l 2>/dev/null | awk -v m="$model" '$1 == m { for (i = 2; i <= NF - 3; i++) printf "%s%s", (i > 2 ? " " : ""), $i; exit }')
    RIG_MODEL_NAME=${RIG_MODEL_NAME:-model $model}
    return 0
}

# A rigctld boot service left by an earlier run of this setup fights any other
# rigctld for the serial port (retrying every 10s), so offer to remove it.
remove_old_rig_service() {
    local unit=/etc/systemd/system/freedv-rigctld.service
    [[ -f $unit ]] || return 0
    say "An earlier run of this setup installed $unit,"
    say "which starts its own rigctld at boot. It isn't needed now."
    yesno "Remove it?" y || return 0
    root_quiet "Removing the old rigctld service" "systemctl disable --now freedv-rigctld.service; rm -f '$unit' && systemctl daemon-reload && systemctl reset-failed freedv-rigctld.service 2>/dev/null; true"
}

install_rig_service() {
    local unit tmp
    unit=/etc/systemd/system/freedv-rigctld.service
    tmp=$(mktemp)
    cat > "$tmp" <<EOF
# Written by freedv-rade-setup for radio "$RADIO_LABEL"
[Unit]
Description=hamlib rigctld for FreeDV ($RADIO_LABEL)
After=network.target

[Service]
User=$user
ExecStart=$RIGCTLD_BIN -m $RIG_MODEL -r $RIG_PORT -T $RIG_LISTEN -t 4532${RIG_SETCONF:+ --set-conf=$RIG_SETCONF}
# Keep retrying, e.g. if the radio is switched on after the computer
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
    say ""
    if root_quiet "Installing the rigctld service ($unit)" "install -m 644 '$tmp' '$unit' && systemctl daemon-reload && systemctl enable --now freedv-rigctld.service"; then
        say "rigctld will now start at boot."
    else
        warn "Could not install the service - using 'only while FreeDV is running' instead."
        RIG_MODE=ondemand
    fi
    rm -f "$tmp"
}

bpf_step() {
    if [[ $RADIO_KIND == none ]]; then
        BPF=none; BPF_BIN=""
        return
    fi
    heading "Transmit band-pass filter"
    say "The band-pass filter cleans up FreeDV's transmit audio before it goes to the radio."
    say "The start script picks the right one for the FreeDV build it starts:"
    say "the wide filter (675-2275 Hz) for RADE V1, the 1k filter (981-1956 Hz) for RADE V2."
    BPF_BIN=""
    if ! yesno "Use the band-pass filter?" y; then
        BPF=none
        return
    fi
    BPF=on
    build_bpf wide && build_bpf 1k \
        || { warn "The filter could not be built - continuing without it."; BPF=none; BPF_BIN=""; return; }
    BPF_BIN="$LOCAL_BIN/Fdv-bpf"
    if freedv_is_v2 "$FREEDV_DIR/freedv-gui/build_linux/src/freedv"; then
        say "The current FreeDV build is RADE V2, so the 1k filter will be used."
    else
        say "The current FreeDV build is RADE V1, so the wide filter will be used."
    fi
}

# PipeWire's ALSA plugin is set up (it defines the "pipewire" ALSA device
# that the filter opens; 50-pipewire.conf on both Mageia and Ubuntu)
pipewire_alsa_ok() {
    local f
    for f in /etc/alsa/conf.d/*pipewire* /usr/share/alsa/alsa.conf.d/*pipewire*; do
        [[ -e $f ]] && return 0
    done
    return 1
}

# build_bpf wide|1k -> BPF_BIN
build_bpf() {
    local src="$SCRIPT_DIR/bpf/bpf.c" bin
    local -a flags=()
    [[ -f $src ]] || { warn "$src is missing."; return 1; }
    command -v gcc &>/dev/null || { warn "gcc is not installed."; return 1; }
    [[ -f /usr/include/alsa/asoundlib.h ]] || { warn "The ALSA development headers are not installed."; return 1; }
    if ! pipewire_alsa_ok; then
        local apkg
        apkg=$(alsa_plugin_pkg)
        say "The filter needs the $apkg package (it connects ALSA programs to PipeWire)."
        offer_install "$apkg" "needed by the band-pass filter" && pipewire_alsa_ok || return 1
    fi
    bin="$LOCAL_BIN/Fdv-bpf"
    if [[ $1 == 1k ]]; then
        bin="$LOCAL_BIN/Fdv-bpf-1k"
        flags=(-DCUTOFF_LOW=981.0 -DCUTOFF_HIGH=1956.0)
    fi
    if [[ ! -x $bin || $src -nt $bin ]]; then
        mkdir -p "$LOCAL_BIN"
        run_quiet "Building the filter ($bin)" gcc -O3 "${flags[@]}" -o "$bin" "$src" -lm -lasound || return 1
    fi
    ok "Band-pass filter: $bin"
    remove_old_bpf
}

# freedv_is_v2 FREEDV_PROGRAM -> true for a RADE V2 build (it has the RADEV2 mode)
freedv_is_v2() { grep -qa RADEV2 "$1" 2>/dev/null; }

# Draft versions named the filter programs freedv-bpf and freedv-bpf-1k.
# Remove them, unless another radio's start script still uses one, or one
# is running.
remove_old_bpf() {
    local old users
    for old in "$LOCAL_BIN/freedv-bpf" "$LOCAL_BIN/freedv-bpf-1k"; do
        [[ -e $old ]] || continue
        users=$(grep -lsx "BPF_BIN=$(printf '%q' "$old")" "$SETUP_ROOT"/*/start | grep -vxF "$RADIO_DIR/start")
        if [[ -n $users ]] || pgrep -x "${old##*/}" >/dev/null; then
            log "Keeping $old (still used: ${users:-running})"
            continue
        fi
        rm -f "$old" && log "Removed old filter program $old"
    done
}

