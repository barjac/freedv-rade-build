# run_start --test|--links: runs the radio's start script for the sound only
run_start() {
    # The sound system restarts, which would cut off a running FreeDV
    while pgrep -x freedv >/dev/null; do
        warn "FreeDV is running. The sound system can't be restarted while it runs."
        pause "Please close FreeDV, then press Enter... "
    done
    # Refresh the start script from this radio's settings, so the test is the
    # current one (nothing else - cards, links, FreeDV settings - is changed)
    write_start_script
    log "\n\$ $RADIO_DIR/start $1"
    "$RADIO_DIR/start" "$1" 2>&1 | tee -a "$LOGFILE" >&3
}

